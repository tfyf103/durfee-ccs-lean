STEP13_DECL_KIND DurfeeCCS.Step10.outerNegativeExtension_mass_lt theorem DurfeeCCS.Step10.OuterPreprocessingExtension
DurfeeCCS.Step10.outerNegativeExtension_mass_lt {n : ℕ} (hn : 6401 ≤ n) {h : ℝ}
  (hhLog : 2 * Real.log (DurfeeCCS.Step10.outerY n) ≤ h) :
