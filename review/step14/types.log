STEP13_DECL_KIND DurfeeCCS.Step10.outerAmplitude_ratio theorem DurfeeCCS.Step10.OuterReplacement
DurfeeCCS.Step10.outerAmplitude_ratio {y Y h γ : ℝ} (hY : 80 ≤ Y) (hy : Y / 2 ≤ y) (hyY : y ≤ Y) (hh : 8.76 < h)
  (hγ : Y ^ 2 - y ^ 2 = γ) :
  DurfeeCCS.Step10.outerTransformAmplitude y h / DurfeeCCS.Step10.outerTransformAmplitude Y h ≤
    Real.exp (-((DurfeeCCS.Step10.outerRho h Real.pi).re - 4 / Y) / (2 * Y) * γ)
STEP13_DECL_KIND DurfeeCCS.Step10.outerBesselApproximation_at_radius theorem DurfeeCCS.Step10.OuterResults
DurfeeCCS.Step10.outerBesselApproximation_at_radius (hApprox : DurfeeCCS.Step10.OuterBesselApproximation) {n : ℕ}
  (hn : 6401 ≤ n) {r : ℝ} (hr : 0 < r) (hlo : Real.log (↑n - 1 / 12) ≤ 2 * Real.log r)
  (hhi : 2 * Real.log r ≤ 4 * (↑n - 1 / 12) ^ (1 / 6)) :
  |DurfeeCCS.Step08.durfeeNegativeValue n r -
        DurfeeCCS.Step10.outerPrediction (DurfeeCCS.Step10.outerY n) (2 * Real.log r)| <
    0.99 * DurfeeCCS.Step10.outerTransformAmplitude (DurfeeCCS.Step10.outerY n) (2 * Real.log r)
STEP13_DECL_KIND DurfeeCCS.Step10.outerBesselApproximation_of_errors theorem DurfeeCCS.Step10.OuterApproximation
DurfeeCCS.Step10.outerBesselApproximation_of_errors (hpre : DurfeeCCS.Step10.OuterPreprocessingError)
