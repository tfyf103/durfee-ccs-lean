            2 * Real.log r * |DurfeeCCS.Step09.midFrequency p| + (DurfeeCCS.Step06.saddleG r⁻¹ 0).im) ∧
      DurfeeCCS.Step09.midPhase r 0 0 = DurfeeCCS.Step06.saddleS r ^ 2 ∧
        DurfeeCCS.Step09.midPhase r (-1) 0 = (starRingEnd ℂ) (DurfeeCCS.Step06.saddleS r ^ 2) ∧
          deriv (deriv (DurfeeCCS.Step09.midPhase r 0)) 0 = -2 * ↑r * Complex.I / (1 + ↑r * Complex.I)
