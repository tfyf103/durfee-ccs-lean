DurfeeCCS.Step10.corollary44 {n : ℕ} (hn : 6401 ≤ n) :
  ∃ d₀ x,
    (0.92 * DurfeeCCS.Step10.outerY n < ↑d₀ ∧ d₀ ≤ n.sqrt - 1) ∧
      (∀ (d : ℕ),
          d₀ ≤ d →
            d < n.sqrt →
              0 < x d ∧ ↑(SignType.sign (Polynomial.eval (-x d) (DurfeeCCS.durfeePolynomialReal n))) = (-1) ^ d) ∧
        StrictMonoOn x (Set.Ico d₀ n.sqrt) ∧
          (DurfeeCCS.Step10.outerStart n ≤ Real.log (x d₀) ∧ Real.log (x d₀) ≤ DurfeeCCS.Step10.outerStart n + 2) ∧
            |DurfeeCCS.Step06.saddlePhase n √(x d₀) - Real.pi * ↑d₀| < 0.48 ∧
              ∃ r, ∀ (i : Fin (n.sqrt - d₀)), r i < -x d₀ ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (r i)
STEP13_DECL_KIND DurfeeCCS.Step10.corollary44_of_proposition41 theorem DurfeeCCS.Step10.OuterResults
DurfeeCCS.Step10.corollary44_of_proposition41 (hApprox : DurfeeCCS.Step10.OuterBesselApproximation) {n : ℕ}
  (hn : 6401 ≤ n) :
  ∃ d₀ x,
    (0.92 * DurfeeCCS.Step10.outerY n < ↑d₀ ∧ d₀ ≤ n.sqrt - 1) ∧
      (∀ (d : ℕ),
          d₀ ≤ d →
            d < n.sqrt →
              0 < x d ∧ ↑(SignType.sign (Polynomial.eval (-x d) (DurfeeCCS.durfeePolynomialReal n))) = (-1) ^ d) ∧
        StrictMonoOn x (Set.Ico d₀ n.sqrt) ∧
          (DurfeeCCS.Step10.outerStart n ≤ Real.log (x d₀) ∧ Real.log (x d₀) ≤ DurfeeCCS.Step10.outerStart n + 2) ∧
            |DurfeeCCS.Step06.saddlePhase n √(x d₀) - Real.pi * ↑d₀| < 0.48 ∧
              ∃ r, ∀ (i : Fin (n.sqrt - d₀)), r i < -x d₀ ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (r i)
STEP13_DECL_KIND DurfeeCCS.Step10.durfeeNegativeValue_eq_outerTripleSum theorem DurfeeCCS.Step10.OuterFiniteExpansion
DurfeeCCS.Step10.durfeeNegativeValue_eq_outerTripleSum {n : ℕ} (hn : 0 < n) (h : ℝ) :
