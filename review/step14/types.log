STEP13_DECL_KIND DurfeeCCS.Step10.outerLogSample_far theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerLogSample_far {n d : ℕ} (hs : DurfeeCCS.Step10.farThreshold n < DurfeeCCS.Step10.farSample n d) :
  DurfeeCCS.Step10.outerLogSample n d = DurfeeCCS.Step10.farSample n d
STEP13_DECL_KIND DurfeeCCS.Step10.outerLogSample_far_lt theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerLogSample_far_lt {n d : ℕ} (hn : 6401 ≤ n) (hd : DurfeeCCS.Step10.outerFirst n ≤ d)
  (hm : d < n.sqrt) : DurfeeCCS.Step10.outerStart n < DurfeeCCS.Step10.farSample n d
STEP13_DECL_KIND DurfeeCCS.Step10.outerLogSample_near theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerLogSample_near {n d : ℕ} (hn : 6401 ≤ n) (hd : DurfeeCCS.Step10.outerFirst n ≤ d)
  (hm : d < n.sqrt) (hs : DurfeeCCS.Step10.farSample n d ≤ DurfeeCCS.Step10.farThreshold n) :
  DurfeeCCS.Step10.outerLogSample n d ∈ Set.Icc (DurfeeCCS.Step10.outerStart n) (DurfeeCCS.Step10.farSample n d) ∧
    DurfeeCCS.Step10.outerPhi (DurfeeCCS.Step10.outerY n) (DurfeeCCS.Step10.outerLogSample n d) = Real.pi * ↑d
STEP13_DECL_KIND DurfeeCCS.Step10.outerLowFrequencyErrors theorem DurfeeCCS.Step10.OuterErrorTransfer
DurfeeCCS.Step10.outerLowFrequencyErrors {y h v : ℝ} (hy : 72 < y) (hh : 8.76 < h) (hscale : h / y ≤ 0.240)
  (hyh : 1 ≤ y * h) (hv : |v| ≤ h) :
  ‖DurfeeCCS.Step10.kernelTransform y (DurfeeCCS.Step10.outerZeta h v) - DurfeeCCS.Step10.outerMainMode y h v‖ ≤
    ‖DurfeeCCS.Step10.outerMainMode y h v‖ * (1 / (y * h) + 2 * Real.exp (-2 * (y * h))) + 2 / h * Real.exp (y * h)
STEP13_DECL_KIND DurfeeCCS.Step10.outerLow_error_sums theorem DurfeeCCS.Step10.OuterErrorSum
DurfeeCCS.Step10.outerLow_error_sums {y₀ y h c : ℝ} (hc : 9 / 10 ≤ c) (hy₀ : 80 < y₀) (hy : c * y₀ ≤ y) (hh : 8.76 < h)
  (hcap : h ≤ 4 * y₀ ^ (1 / 3)) :
  have V := fun p =>
    if |DurfeeCCS.Step10.outerFrequency p| ≤ h then
      ‖DurfeeCCS.Step10.kernelTransformIntegralFormula y
              (DurfeeCCS.Step10.outerZeta h (DurfeeCCS.Step10.outerFrequency p)) -
            DurfeeCCS.Step10.outerMainMode y h (DurfeeCCS.Step10.outerFrequency p)‖ /
        DurfeeCCS.Step10.outerTransformAmplitude y h
    else 0;
  Summable V ∧ ∑' (p : ℤ), V p ≤ DurfeeCCS.Step07.outerLowerBound c y₀ + DurfeeCCS.Step07.outerUpperBound c
STEP13_DECL_KIND DurfeeCCS.Step10.outerLow_leading_pair theorem DurfeeCCS.Step10.OuterErrorNormalize
DurfeeCCS.Step10.outerLow_leading_pair {y h : ℝ} (hy : 0 < y) (hh : 8.76 < h) :
  (‖DurfeeCCS.Step10.outerEndpointMain y (DurfeeCCS.Step10.outerRho h Real.pi)‖ +
        ‖DurfeeCCS.Step10.outerEndpointMain y (DurfeeCCS.Step10.outerRho h (-Real.pi))‖) /
      DurfeeCCS.Step10.outerTransformAmplitude y h <
    1.142
STEP13_DECL_KIND DurfeeCCS.Step10.outerLow_nonleading_pair theorem DurfeeCCS.Step10.OuterErrorNormalize
DurfeeCCS.Step10.outerLow_nonleading_pair {y h : ℝ} (hy : 0 < y) (m : ℕ)
  (hv : DurfeeCCS.Step10.outerPositiveFrequency (m + 1) ≤ h) :
  have v := DurfeeCCS.Step10.outerPositiveFrequency (m + 1);
  (‖DurfeeCCS.Step10.outerEndpointMain y (DurfeeCCS.Step10.outerRho h v)‖ +
        ‖DurfeeCCS.Step10.outerEndpointMain y (DurfeeCCS.Step10.outerRho h (-v))‖) /
      DurfeeCCS.Step10.outerTransformAmplitude y h ≤
    1.47 * Real.exp (-(26 * Real.pi ^ 4 * y / (25 * h ^ 3)) * (↑m + 1) * (↑m + 2))
STEP13_DECL_KIND DurfeeCCS.Step10.outerMainMode other DurfeeCCS.Step10.OuterErrorSum
DurfeeCCS.Step10.outerMainMode (y h v : ℝ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step10.outerNegativeExtension_error theorem DurfeeCCS.Step10.OuterPreprocessingExtension
DurfeeCCS.Step10.outerNegativeExtension_error {n : ℕ} (hn : 6401 ≤ n) {h : ℝ}
  (hhLog : 2 * Real.log (DurfeeCCS.Step10.outerY n) ≤ h) :
