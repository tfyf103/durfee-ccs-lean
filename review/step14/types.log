STEP13_DECL_KIND DurfeeCCS.Step10.outerError_scale theorem DurfeeCCS.Step10.OuterErrorNormalize
DurfeeCCS.Step10.outerError_scale {y₀ y h : ℝ} (hy₀ : 80 ≤ y₀) (hy : 9 / 10 * y₀ ≤ y) (hh : 8.76 < h)
  (hcap : h ≤ 4 * y₀ ^ (1 / 3)) : 72 ≤ y ∧ h / y < 0.240 ∧ 1 ≤ y * h
