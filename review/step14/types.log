STEP13_DECL_KIND DurfeeCCS.Step10.outerFirst_eq_intCeil theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerFirst_eq_intCeil {n : ℕ} (hn : 6401 ≤ n) :
  ↑(DurfeeCCS.Step10.outerFirst n) =
