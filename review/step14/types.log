STEP13_DECL_KIND DurfeeCCS.Step10.outerFirst_sample theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerFirst_sample {n : ℕ} (hn : 6401 ≤ n) :
  DurfeeCCS.Step10.outerStart n ≤ Real.log (DurfeeCCS.Step10.outerSample n (DurfeeCCS.Step10.outerFirst n)) ∧
    Real.log (DurfeeCCS.Step10.outerSample n (DurfeeCCS.Step10.outerFirst n)) < DurfeeCCS.Step10.outerStart n + 2 ∧
      DurfeeCCS.Step10.outerPhi (DurfeeCCS.Step10.outerY n)
          (Real.log (DurfeeCCS.Step10.outerSample n (DurfeeCCS.Step10.outerFirst n))) =
        Real.pi * ↑(DurfeeCCS.Step10.outerFirst n)
STEP13_DECL_KIND DurfeeCCS.Step10.outerFrequencyDelta_deriv_neg theorem DurfeeCCS.Step10.OuterRhoDelta
DurfeeCCS.Step10.outerFrequencyDelta_deriv_neg {h a : ℝ} (hh : 0 < h) (ha : 0 < a) (u : ℝ) :
  deriv (DurfeeCCS.Step10.outerFrequencyDelta h a) u =
      -DurfeeCCS.Step10.outerFrequencyDelta h a u / (h ^ 2 + u - a + 2 * DurfeeCCS.Step10.outerFrequencyDelta h a u) ∧
    deriv (DurfeeCCS.Step10.outerFrequencyDelta h a) u < 0
STEP13_DECL_KIND DurfeeCCS.Step10.outerFrequencyDelta_eq theorem DurfeeCCS.Step10.OuterRhoDelta
DurfeeCCS.Step10.outerFrequencyDelta_eq (h a v : ℝ) :
  DurfeeCCS.Step10.outerFrequencyDelta h a (v ^ 2) = (DurfeeCCS.Step10.outerRhoAt h v a).re ^ 2 - h ^ 2
STEP13_DECL_KIND DurfeeCCS.Step10.outerFrequencyDiscriminant_pos theorem DurfeeCCS.Step10.OuterRhoDelta
DurfeeCCS.Step10.outerFrequencyDiscriminant_pos {h a : ℝ} (hh : 0 < h) (ha : 0 < a) (u : ℝ) :
  0 < DurfeeCCS.Step10.outerFrequencyDiscriminant h a u
STEP13_DECL_KIND DurfeeCCS.Step10.outerFrequencyQuadratic theorem DurfeeCCS.Step10.OuterRhoDelta
DurfeeCCS.Step10.outerFrequencyQuadratic {h : ℝ} (hh : 0 < h) (v : ℝ) :
  have a := 4 * Real.pi ^ 2 / 3;
  have D := (DurfeeCCS.Step10.outerRho h v).re ^ 2 - h ^ 2;
  D * (h ^ 2 + v ^ 2 - a + D) = a * h ^ 2 ∧
    (DurfeeCCS.Step10.outerRho h v).im = h * v / (DurfeeCCS.Step10.outerRho h v).re ∧
      0 < D ∧ D ≤ a ∧ h ^ 2 + v ^ 2 - a + 2 * D = ‖DurfeeCCS.Step10.outerRho h v ^ 2‖
STEP13_DECL_KIND DurfeeCCS.Step10.outerGamma other DurfeeCCS.Step10.OuterEulerTail
DurfeeCCS.Step10.outerGamma (a b j : ℕ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step10.outerGamma_complete_square theorem DurfeeCCS.Step10.OuterEulerTail
DurfeeCCS.Step10.outerGamma_complete_square (d a b j : ℕ) :
  ↑(d ^ 2 + DurfeeCCS.Step10.outerTailPower d a + DurfeeCCS.Step10.outerTailPower d b + j) =
    (↑d + (↑a + ↑b) / 2) ^ 2 + DurfeeCCS.Step10.outerGamma a b j
STEP13_DECL_KIND DurfeeCCS.Step10.outerGamma_lower theorem DurfeeCCS.Step10.OuterEulerTail
DurfeeCCS.Step10.outerGamma_lower (a b j : ℕ) : ↑j + (↑a + ↑b) / 2 ≤ DurfeeCCS.Step10.outerGamma a b j
STEP13_DECL_KIND DurfeeCCS.Step10.outerGamma_lt_shiftedSize theorem DurfeeCCS.Step10.OuterEulerTail
DurfeeCCS.Step10.outerGamma_lt_shiftedSize {n d a b j : ℕ} (hd : 0 < d)
  (hs : d ^ 2 + DurfeeCCS.Step10.outerTailPower d a + DurfeeCCS.Step10.outerTailPower d b + j ≤ n) :
  DurfeeCCS.Step10.outerGamma a b j < ↑n - 1 / 12
STEP13_DECL_KIND DurfeeCCS.Step10.outerHighFrequencySum theorem DurfeeCCS.Step10.OuterErrorTransfer
DurfeeCCS.Step10.outerHighFrequencySum {y h : ℝ} (hy : 72 ≤ y) (hh : 8.76 < h) :
  have T := fun p =>
    if h < |DurfeeCCS.Step10.outerFrequency p| then
      ‖DurfeeCCS.Step10.kernelTransform y (DurfeeCCS.Step10.outerZeta h (DurfeeCCS.Step10.outerFrequency p))‖ /
        DurfeeCCS.Step10.outerTransformAmplitude y h
    else 0;
  Summable T ∧
    ∑' (p : ℤ), T p <
      29 * y ^ 3 / h ^ 2 * Real.exp (-(4 * Real.pi ^ 2 * y / (3 * h)) * Max.max 0.152 (1 / 4 - 8.4 / h ^ 2))
STEP13_DECL_KIND DurfeeCCS.Step10.outerHighReciprocal_sum theorem DurfeeCCS.Step10.OuterErrorLattice
DurfeeCCS.Step10.outerHighReciprocal_sum {h : ℝ} (hh : 0 < h) :
  have R := fun p =>
    if h < |DurfeeCCS.Step10.outerFrequency p| then 1 / (h ^ 2 + DurfeeCCS.Step10.outerFrequency p ^ 2) else 0;
  Summable R ∧ ∑' (p : ℤ), R p ≤ 2 / h ^ 2 + 1 / (Real.pi * h)
STEP13_DECL_KIND DurfeeCCS.Step10.outerKernelReplacement theorem DurfeeCCS.Step10.OuterReplacement
DurfeeCCS.Step10.outerKernelReplacement (hCoeff : DurfeeCCS.Step10.OuterCoefficientError) {y x : ℝ} {t : ℤ} (hy : 0 ≤ y)
  (ht : y ^ 2 - x ^ 2 = ↑t - 1 / 12) :
  |DurfeeCCS.Step10.clippedTwoColour t - DurfeeCCS.Step10.outerBesselKernel y x| ≤
    Real.pi ^ 3 / 18 * Real.exp (Real.pi * √(↑t.toNat / 3))
STEP13_DECL_KIND DurfeeCCS.Step10.outerKernelReplacement_neg_index theorem DurfeeCCS.Step10.OuterPreprocessingSwapTerms
DurfeeCCS.Step10.outerKernelReplacement_neg_index {Y x : ℝ} {t : ℤ} (ht : t < 0)
  (hIndex : Y ^ 2 - x ^ 2 = ↑t - 1 / 12) :
