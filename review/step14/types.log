STEP13_DECL_KIND DurfeeCCS.Step10.farExponentGap theorem DurfeeCCS.Step10.OuterFarParameters
DurfeeCCS.Step10.farExponentGap {n d l : ℕ} (hd : d ^ 2 < n) (hl : l ^ 2 < n) :
  DurfeeCCS.Step10.farSample n d * ↑d + 2 * Real.pi / √3 * DurfeeCCS.Step10.farRadius n d -
        DurfeeCCS.Step10.farSample n d * ↑l -
      2 * Real.pi / √3 * DurfeeCCS.Step10.farRadius n l =
    Real.pi / (√3 * DurfeeCCS.Step10.farRadius n d) *
      ((↑d - ↑l) ^ 2 + (DurfeeCCS.Step10.farRadius n l - DurfeeCCS.Step10.farRadius n d) ^ 2)
