DurfeeCCS.Step10.finite_nonzero_triple_weight_le {q z : ℝ} (hq₀ : 0 ≤ q) (hq : q < 1) (hz : 0 ≤ z) (F : ℕ → ℝ)
  (hF : ∀ (n : ℕ), ↑(F n) = ↑z ^ n * (DurfeeCCS.qPochhammer (↑q) (↑q) n)⁻¹) (hF₀ : ∀ (n : ℕ), 0 ≤ F n)
