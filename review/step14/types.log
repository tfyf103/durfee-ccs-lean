STEP13_DECL_KIND DurfeeCCS.Step10.outerEulerSeries_sq_eq_weightProduct theorem DurfeeCCS.Step10.OuterEulerWeight
DurfeeCCS.Step10.outerEulerSeries_sq_eq_weightProduct {w σ : ℝ} (hw₀ : 0 ≤ w) (hw : w < 1) (hσ : 0 < σ) :
  have q := Real.exp (-σ);
  have x := w * Real.exp (-σ / 2);
  DurfeeCCS.Step10.outerEulerSeries q x ^ 2 = DurfeeCCS.Step10.outerWeightProduct w σ
STEP13_DECL_KIND DurfeeCCS.Step10.outerFar_coefficientBounds theorem DurfeeCCS.Step10.OuterFar
DurfeeCCS.Step10.outerFar_coefficientBounds : DurfeeCCS.Step10.FarCoefficientBounds
STEP13_DECL_KIND DurfeeCCS.Step10.outerFirst_bounds theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerFirst_bounds {n : ℕ} (hn : 6401 ≤ n) :
