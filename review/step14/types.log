STEP13_DECL_KIND DurfeeCCS.Step10.outerBesselKernel_eq_bessel theorem DurfeeCCS.Step10.OuterBesselKernel
DurfeeCCS.Step10.outerBesselKernel_eq_bessel {y x : ℝ} (hy : 0 < y) (hx : |x| < y) :
  DurfeeCCS.Step10.outerBesselKernel y x =
    Real.pi * (DurfeeCCS.Step06.besselI 2 ↑(2 * Real.pi / √3 * √(y ^ 2 - x ^ 2))).re / (6 * (y ^ 2 - x ^ 2)) -
      Real.pi ^ 3 / 36
