STEP13_DECL_KIND DurfeeCCS.Step06.analyticAt_besselJ theorem DurfeeCCS.Step06.BesselSeries
DurfeeCCS.Step06.analyticAt_besselJ (ν : ℕ) (z : ℂ) : AnalyticAt ℂ (DurfeeCCS.Step06.besselJ ν) z
STEP13_DECL_KIND DurfeeCCS.Step06.besselI other DurfeeCCS.Step06.BesselSeries
DurfeeCCS.Step06.besselI (ν : ℕ) (z : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.besselI_one_integral theorem DurfeeCCS.Step06.BesselIntegrals
DurfeeCCS.Step06.besselI_one_integral (z : ℂ) :
  DurfeeCCS.Step06.besselI 1 z = z / ↑Real.pi * ∫ (t : ℝ) in -1..1, Complex.exp (z * ↑t) * ↑√(1 - t ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step06.besselI_two_integral theorem DurfeeCCS.Step06.BesselIntegrals
DurfeeCCS.Step06.besselI_two_integral (z : ℂ) :
  DurfeeCCS.Step06.besselI 2 z =
    z ^ 2 / (3 * ↑Real.pi) * ∫ (t : ℝ) in -1..1, Complex.exp (z * ↑t) * ↑((1 - t ^ 2) ^ (3 / 2))
STEP13_DECL_KIND DurfeeCCS.Step06.besselI_zero_integral theorem DurfeeCCS.Step06.BesselIntegrals
DurfeeCCS.Step06.besselI_zero_integral (z : ℂ) :
  DurfeeCCS.Step06.besselI 0 z = (↑Real.pi)⁻¹ * ∫ (t : ℝ) in 0..Real.pi, Complex.exp (z * ↑(Real.cos t))
STEP13_DECL_KIND DurfeeCCS.Step06.besselJ other DurfeeCCS.Step06.BesselSeries
DurfeeCCS.Step06.besselJ (ν : ℕ) (z : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.besselJ_eq_mathlib theorem DurfeeCCS.Step06.Bessel
DurfeeCCS.Step06.besselJ_eq_mathlib (ν : ℕ) (z : ℂ) : DurfeeCCS.Step06.besselJ ν z = Complex.besselJ (↑ν) z
STEP13_DECL_KIND DurfeeCCS.Step06.besselJ_ofReal_eq theorem DurfeeCCS.Step06.Bessel
DurfeeCCS.Step06.besselJ_ofReal_eq (ν : ℕ) (x : ℝ) : DurfeeCCS.Step06.besselJ ν ↑x = ↑(DurfeeCCS.Step06.besselJ ν ↑x).re
STEP13_DECL_KIND DurfeeCCS.Step06.besselJ_one_hankelGamma theorem DurfeeCCS.Step06.Nemes
DurfeeCCS.Step06.besselJ_one_hankelGamma {x : ℝ} (hx : 0 < x) :
  √(Real.pi * x / 2) * (DurfeeCCS.Step06.besselJ 1 ↑x).re =
    (Complex.exp (↑(DurfeeCCS.Step06.besselPhase 1 x) * Complex.I) * DurfeeCCS.Step06.hankelGammaAmplitude 1 x).re
STEP13_DECL_KIND DurfeeCCS.Step06.besselJ_two_eq theorem DurfeeCCS.Step06.BesselDerivative
DurfeeCCS.Step06.besselJ_two_eq (z : ℂ) (hz : z ≠ 0) :
  DurfeeCCS.Step06.besselJ 2 z = 2 * DurfeeCCS.Step06.besselJ 1 z / z - DurfeeCCS.Step06.besselJ 0 z
STEP13_DECL_KIND DurfeeCCS.Step06.besselJ_zero_hankelGamma theorem DurfeeCCS.Step06.Nemes
DurfeeCCS.Step06.besselJ_zero_hankelGamma {x : ℝ} (hx : 0 < x) :
  √(Real.pi * x / 2) * (DurfeeCCS.Step06.besselJ 0 ↑x).re =
    (Complex.exp (↑(DurfeeCCS.Step06.besselPhase 0 x) * Complex.I) * DurfeeCCS.Step06.hankelGammaAmplitude 0 x).re
STEP13_DECL_KIND DurfeeCCS.Step06.continuousOn_saddleAmplitude theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.continuousOn_saddleAmplitude {n : ℕ} (hn : 0 < n) :
  ContinuousOn (DurfeeCCS.Step06.saddleAmplitude n) (Set.Ioi 0)
STEP13_DECL_KIND DurfeeCCS.Step06.continuousOn_saddlePhase theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.continuousOn_saddlePhase (n : ℕ) : ContinuousOn (DurfeeCCS.Step06.saddlePhase n) (Set.Ioi 0)
STEP13_DECL_KIND DurfeeCCS.Step06.dedekindSum other DurfeeCCS.Step06.Dedekind
DurfeeCCS.Step06.dedekindSum (h : ℤ) (ℓ : ℕ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step06.dedekindSum_eq_IJT theorem DurfeeCCS.Step06.Dedekind
DurfeeCCS.Step06.dedekindSum_eq_IJT {h ℓ : ℕ} (hℓ : 0 < ℓ) (hred : h.Coprime ℓ) :
  DurfeeCCS.Step06.dedekindSum (↑h) ℓ = DurfeeCCS.Step06.dedekindSumIJT h ℓ
STEP13_DECL_KIND DurfeeCCS.Step06.durfeeAnalyticF_eq_eulerConstantTerm theorem DurfeeCCS.Step06.EulerConstantTerm
DurfeeCCS.Step06.durfeeAnalyticF_eq_eulerConstantTerm (x z : ℂ) {q : ℂ} (hq : ‖q‖ < 1) (hz : z ≠ 0) :
  DurfeeCCS.durfeeAnalyticF x q = DurfeeCCS.Step06.eulerConstantTerm q z (x * q / z)
STEP13_DECL_KIND DurfeeCCS.Step06.durfeeAnalyticF_eq_pairedAngle theorem DurfeeCCS.Step06.DurfeePairedAngle
DurfeeCCS.Step06.durfeeAnalyticF_eq_pairedAngle (r : ℝ) {ζ : ℂ} (hζ : 0 < ζ.re) :
  DurfeeCCS.durfeeAnalyticF (-↑r ^ 2) (Complex.exp (-ζ)) =
    (2 * ↑Real.pi)⁻¹ * ∫ (θ : ℝ) in -Real.pi..Real.pi, DurfeeCCS.Step06.pairedProduct r θ ζ
STEP13_DECL_KIND DurfeeCCS.Step06.durfeePolynomials_angular_coefficient theorem DurfeeCCS.Step06.DurfeeAngle
DurfeeCCS.Step06.durfeePolynomials_angular_coefficient (n : ℕ) (r u : ℝ) (hu : 0 < u) :
  Polynomial.eval (-↑r ^ 2) (DurfeeCCS.durfeePolynomialComplex n) =
    (2 * ↑Real.pi)⁻¹ *
      ∫ (v : ℝ) in -Real.pi..Real.pi,
        Complex.exp (↑n * (↑u + ↑v * Complex.I)) *
          DurfeeCCS.durfeeAnalyticF (-↑r ^ 2) (Complex.exp (-(↑u + ↑v * Complex.I)))
STEP13_DECL_KIND DurfeeCCS.Step06.eulerConstantTerm other DurfeeCCS.Step06.EulerConstantTerm
DurfeeCCS.Step06.eulerConstantTerm (q z w : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.eulerProduct other DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.eulerProduct (ζ : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.eulerProduct_modular theorem DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.eulerProduct_modular {ζ : ℂ} (hζ : 0 < ζ.re) :
  DurfeeCCS.Step06.eulerProduct ζ =
    (2 * ↑Real.pi / ζ).sqrt * Complex.exp (ζ / 24 - ↑Real.pi ^ 2 / (6 * ζ)) *
      DurfeeCCS.Step06.eulerProduct (4 * ↑Real.pi ^ 2 / ζ)
STEP13_DECL_KIND DurfeeCCS.Step06.eulerQSeries_eq_tprod theorem DurfeeCCS.Step06.EulerConstantTerm
DurfeeCCS.Step06.eulerQSeries_eq_tprod {q : ℂ} (hq : ‖q‖ < 1) (z : ℂ) :
  ∑' (d : ℕ), DurfeeCCS.Step06.eulerQTerm q z d = ∏' (j : ℕ), (1 + z * q ^ j)
STEP13_DECL_KIND DurfeeCCS.Step06.eulerQSeries_mul theorem DurfeeCCS.Step06.EulerConstantTerm
DurfeeCCS.Step06.eulerQSeries_mul {q : ℂ} (hq : ‖q‖ < 1) (z w : ℂ) :
  (∑' (n : ℕ), DurfeeCCS.Step06.eulerQTerm q z n) * ∑' (m : ℕ), DurfeeCCS.Step06.eulerQTerm q w m =
    ∑' (nm : ℕ × ℕ), DurfeeCCS.Step06.eulerQTerm q z nm.1 * DurfeeCCS.Step06.eulerQTerm q w nm.2
STEP13_DECL_KIND DurfeeCCS.Step06.exp_sum_log_pairedProduct theorem DurfeeCCS.Step06.PairedProduct
DurfeeCCS.Step06.exp_sum_log_pairedProduct (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) :
  Complex.exp
      (∑' (j : ℕ),
        (Complex.log (1 + DurfeeCCS.Step06.pairedTerm r θ ζ j) +
          Complex.log (1 + DurfeeCCS.Step06.pairedTerm r (-θ) ζ j))) =
    DurfeeCCS.Step06.pairedProduct r θ ζ
STEP13_DECL_KIND DurfeeCCS.Step06.hasDerivAt_besselI_one_of_ne_zero theorem DurfeeCCS.Step06.BesselDerivative
DurfeeCCS.Step06.hasDerivAt_besselI_one_of_ne_zero (z : ℂ) (hz : z ≠ 0) :
  HasDerivAt (DurfeeCCS.Step06.besselI 1) (DurfeeCCS.Step06.besselI 0 z - DurfeeCCS.Step06.besselI 1 z / z) z
STEP13_DECL_KIND DurfeeCCS.Step06.hasDerivAt_besselI_zero theorem DurfeeCCS.Step06.BesselDerivative
DurfeeCCS.Step06.hasDerivAt_besselI_zero (z : ℂ) :
  HasDerivAt (DurfeeCCS.Step06.besselI 0) (DurfeeCCS.Step06.besselI 1 z) z
STEP13_DECL_KIND DurfeeCCS.Step06.hasDerivAt_besselJ_zero theorem DurfeeCCS.Step06.BesselDerivative
DurfeeCCS.Step06.hasDerivAt_besselJ_zero (z : ℂ) :
  HasDerivAt (DurfeeCCS.Step06.besselJ 0) (-DurfeeCCS.Step06.besselJ 1 z) z
STEP13_DECL_KIND DurfeeCCS.Step06.hasDerivAt_principalDilog theorem DurfeeCCS.Step06.Dilog
DurfeeCCS.Step06.hasDerivAt_principalDilog {z : ℂ} (hz : z ∈ DurfeeCCS.Step06.dilogCut) :
  HasDerivAt DurfeeCCS.Step06.principalDilog (if z = 0 then 1 else -Complex.log (1 - z) / z) z
STEP13_DECL_KIND DurfeeCCS.Step06.multipliable_pairedProduct theorem DurfeeCCS.Step06.PairedProduct
DurfeeCCS.Step06.multipliable_pairedProduct (r θ : ℝ) {ζ : ℂ} (hζ : 0 < ζ.re) :
  Multipliable fun j => (1 + DurfeeCCS.Step06.pairedTerm r θ ζ j) * (1 + DurfeeCCS.Step06.pairedTerm r (-θ) ζ j)
STEP13_DECL_KIND DurfeeCCS.Step06.nemes_first_error theorem DurfeeCCS.Step06.Nemes
DurfeeCCS.Step06.nemes_first_error (ν : ℕ) (hν : ν = 0 ∨ ν = 1) {x : ℝ} (hx : 0 < x) :
  |√(Real.pi * x / 2) * (DurfeeCCS.Step06.besselJ ν ↑x).re - Real.cos (DurfeeCCS.Step06.besselPhase ν x)| ≤
    |4 * ↑ν ^ 2 - 1| / (8 * x)
STEP13_DECL_KIND DurfeeCCS.Step06.norm_log_pairedTerm_le theorem DurfeeCCS.Step06.PairedProduct
DurfeeCCS.Step06.norm_log_pairedTerm_le (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) (j : ℕ) :
  ‖Complex.log (1 + DurfeeCCS.Step06.pairedTerm r θ ζ j)‖ ≤
    Real.exp (-ζ.re / 2) * Real.exp (-ζ.re) ^ j / (1 - Real.exp (-ζ.re / 2))
STEP13_DECL_KIND DurfeeCCS.Step06.norm_twoColourKloosterman_le theorem DurfeeCCS.Step06.Dedekind
DurfeeCCS.Step06.norm_twoColourKloosterman_le (n ℓ : ℕ) : ‖DurfeeCCS.Step06.twoColourKloosterman n ℓ‖ ≤ ↑ℓ
STEP13_DECL_KIND DurfeeCCS.Step06.norm_twoColourPartitionCount_sub_RademacherMain_large theorem DurfeeCCS.Step06.RademacherExactEstimate
DurfeeCCS.Step06.norm_twoColourPartitionCount_sub_RademacherMain_large {n : ℕ} (hn : 16 ≤ n) :
  ‖↑(DurfeeCCS.Step06.twoColourPartitionCount n) - DurfeeCCS.Step06.twoColourRademacherMain n‖ ≤
    Real.pi ^ 3 / 36 * Real.exp (Real.pi * √(↑n / 3))
STEP13_DECL_KIND DurfeeCCS.Step06.pairedProduct other DurfeeCCS.Step06.PairedProduct
DurfeeCCS.Step06.pairedProduct (r θ : ℝ) (ζ : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.principalBranches theorem DurfeeCCS.Step06.Branches
DurfeeCCS.Step06.principalBranches {z : ℂ} (hz : z ∈ Complex.slitPlane) :
  -Real.pi < z.arg ∧ z.arg < Real.pi ∧ z.sqrt = Complex.exp (Complex.log z / 2)
STEP13_DECL_KIND DurfeeCCS.Step06.principalDilog other DurfeeCCS.Step06.Dilog
DurfeeCCS.Step06.principalDilog (z : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.principalDilog_hasSum theorem DurfeeCCS.Step06.Dilog
DurfeeCCS.Step06.principalDilog_hasSum {z : ℂ} (hz : ‖z‖ ≤ 1) :
  HasSum (fun n => z ^ (n + 1) / ↑(n + 1) ^ 2) (DurfeeCCS.Step06.principalDilog z)
STEP13_DECL_KIND DurfeeCCS.Step06.principalDilog_inversion theorem DurfeeCCS.Step06.Dilog
DurfeeCCS.Step06.principalDilog_inversion {z : ℂ} (hz : z ∈ DurfeeCCS.Step06.dilogInvCut) :
  DurfeeCCS.Step06.principalDilog z + DurfeeCCS.Step06.principalDilog z⁻¹ = -↑Real.pi ^ 2 / 6 - Complex.log (-z) ^ 2 / 2
STEP13_DECL_KIND DurfeeCCS.Step06.principalDilog_landen theorem DurfeeCCS.Step06.Dilog
DurfeeCCS.Step06.principalDilog_landen {z : ℂ} (hz : z ∈ DurfeeCCS.Step06.dilogCut) :
  DurfeeCCS.Step06.principalDilog z + DurfeeCCS.Step06.principalDilog (z / (z - 1)) = -Complex.log (1 - z) ^ 2 / 2
STEP13_DECL_KIND DurfeeCCS.Step06.principalDilog_one theorem DurfeeCCS.Step06.Dilog
DurfeeCCS.Step06.principalDilog_one : DurfeeCCS.Step06.principalDilog 1 = ↑Real.pi ^ 2 / 6
STEP13_DECL_KIND DurfeeCCS.Step06.principalSqrt_arg theorem DurfeeCCS.Step06.Branches
DurfeeCCS.Step06.principalSqrt_arg {z : ℂ} (hz : z ≠ 0) : z.sqrt.arg = z.arg / 2
STEP13_DECL_KIND DurfeeCCS.Step06.principalSqrt_sq theorem DurfeeCCS.Step06.Branches
DurfeeCCS.Step06.principalSqrt_sq (z : ℂ) : z.sqrt ^ 2 = z
STEP13_DECL_KIND DurfeeCCS.Step06.qProduct_multipliable theorem DurfeeCCS.Step06.ThetaProduct
DurfeeCCS.Step06.qProduct_multipliable {r : ℂ} (hr : ‖r‖ < 1) (z : ℂ) : Multipliable fun j => 1 + z * r ^ j
STEP13_DECL_KIND DurfeeCCS.Step06.saddleAmplitude other DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleAmplitude (n : ℕ) (r : ℝ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step06.saddleAmplitude_pos theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleAmplitude_pos {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) :
  0 < DurfeeCCS.Step06.saddleAmplitude n r
STEP13_DECL_KIND DurfeeCCS.Step06.saddleG other DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleG (r θ : ℝ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.saddleG_zero theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleG_zero (r : ℝ) : DurfeeCCS.Step06.saddleG r 0 = DurfeeCCS.Step06.saddleS r ^ 2
STEP13_DECL_KIND DurfeeCCS.Step06.saddlePhase other DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddlePhase (n : ℕ) (r : ℝ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step06.saddlePhaseSquare_quadrant theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddlePhaseSquare_quadrant {r : ℝ} (hr : 0 < r) :
  0 < (DurfeeCCS.Step06.saddlePhaseSquare r).re ∧ 0 < (DurfeeCCS.Step06.saddlePhaseSquare r).im
STEP13_DECL_KIND DurfeeCCS.Step06.saddleS other DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleS (r : ℝ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.saddleS_arg theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleS_arg {r : ℝ} (hr : 0 < r) :
  0 < (DurfeeCCS.Step06.saddleS r).arg ∧ (DurfeeCCS.Step06.saddleS r).arg < Real.pi / 4
STEP13_DECL_KIND DurfeeCCS.Step06.saddleS_components theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleS_components {r : ℝ} (hr : 0 < r) :
  0 < (DurfeeCCS.Step06.saddleS r).im ∧ (DurfeeCCS.Step06.saddleS r).im < (DurfeeCCS.Step06.saddleS r).re
STEP13_DECL_KIND DurfeeCCS.Step06.saddleS_components_eq theorem DurfeeCCS.Step06.SaddleComponents
DurfeeCCS.Step06.saddleS_components_eq {r : ℝ} (hr : 0 < r) :
  (DurfeeCCS.Step06.saddleS r).re ^ 2 - (DurfeeCCS.Step06.saddleS r).im ^ 2 =
      -(DurfeeCCS.Step06.principalDilog (-↑r ^ 2)).re / 2 ∧
    2 * (DurfeeCCS.Step06.saddleS r).re * (DurfeeCCS.Step06.saddleS r).im = 2 * ∫ (y : ℝ) in 0..r, Real.arctan y / y
STEP13_DECL_KIND DurfeeCCS.Step06.saddleS_real_imag theorem DurfeeCCS.Step06.Saddle
DurfeeCCS.Step06.saddleS_real_imag (r : ℝ) :
  ↑(DurfeeCCS.Step06.saddleS r).re + ↑(DurfeeCCS.Step06.saddleS r).im * Complex.I = DurfeeCCS.Step06.saddleS r
STEP13_DECL_KIND DurfeeCCS.Step06.summable_norm_eulerQTerm theorem DurfeeCCS.Step06.EulerConstantTerm
DurfeeCCS.Step06.summable_norm_eulerQTerm {q : ℂ} (hq : ‖q‖ < 1) (z : ℂ) :
  Summable fun d => ‖DurfeeCCS.Step06.eulerQTerm q z d‖
STEP13_DECL_KIND DurfeeCCS.Step06.summable_norm_log_pairedTerm theorem DurfeeCCS.Step06.PairedProduct
DurfeeCCS.Step06.summable_norm_log_pairedTerm (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) :
  Summable fun j => ‖Complex.log (1 + DurfeeCCS.Step06.pairedTerm r θ ζ j)‖
STEP13_DECL_KIND DurfeeCCS.Step06.summable_norm_twoColourRademacherTerm theorem DurfeeCCS.Step06.Rademacher
DurfeeCCS.Step06.summable_norm_twoColourRademacherTerm (n : ℕ) :
  Summable fun k => ‖DurfeeCCS.Step06.twoColourRademacherTerm n (k + 1)‖
STEP13_DECL_KIND DurfeeCCS.Step06.thetaGaussian_absolutelyConvergent theorem DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.thetaGaussian_absolutelyConvergent {ζ : ℂ} (hζ : 0 < ζ.re) (w : ℂ) :
  Summable fun j => ‖DurfeeCCS.Step06.thetaGaussian w ζ j‖
STEP13_DECL_KIND DurfeeCCS.Step06.thetaSeries other DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.thetaSeries (z ζ : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step06.thetaSeries_absolutelyConvergent theorem DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.thetaSeries_absolutelyConvergent {ζ z : ℂ} (hζ : 0 < ζ.re) (hz : z ≠ 0) :
  Summable fun j => ‖z ^ j * Complex.exp (-ζ * ↑j ^ 2 / 2)‖
STEP13_DECL_KIND DurfeeCCS.Step06.theta_gaussian_transform theorem DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.theta_gaussian_transform {ζ : ℂ} (hζ : 0 < ζ.re) (w : ℂ) :
  DurfeeCCS.Step06.thetaSeries (Complex.exp w) ζ =
    (2 * ↑Real.pi / ζ).sqrt * ∑' (j : ℤ), DurfeeCCS.Step06.thetaGaussian w ζ j
STEP13_DECL_KIND DurfeeCCS.Step06.theta_triple_product theorem DurfeeCCS.Step06.Theta
DurfeeCCS.Step06.theta_triple_product {ζ z : ℂ} (hζ : 0 < ζ.re) (hz : z ≠ 0) :
  DurfeeCCS.Step06.thetaSeries z ζ =
    DurfeeCCS.Step06.eulerProduct ζ *
      ∏' (j : ℕ), (1 + z * Complex.exp (-(↑j + 1 / 2) * ζ)) * (1 + z⁻¹ * Complex.exp (-(↑j + 1 / 2) * ζ))
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourGenerating_eq_tsum theorem DurfeeCCS.Step06.RademacherGenerating
DurfeeCCS.Step06.twoColourGenerating_eq_tsum {q : ℂ} (hq : ‖q‖ < 1) :
  DurfeeCCS.Step06.twoColourGenerating q = ∑' (n : ℕ), ↑(DurfeeCCS.Step06.twoColourPartitionCount n) * q ^ n
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourGenerating_modular_cusp_zero theorem DurfeeCCS.Step06.RademacherGenerating
DurfeeCCS.Step06.twoColourGenerating_modular_cusp_zero {ζ : ℂ} (hζ : 0 < ζ.re) :
  DurfeeCCS.Step06.twoColourGenerating (Complex.exp (-ζ)) =
    ζ / (2 * ↑Real.pi) * Complex.exp (-ζ / 12 + ↑Real.pi ^ 2 / (3 * ζ)) *
      DurfeeCCS.Step06.twoColourGenerating (Complex.exp (-(4 * ↑Real.pi ^ 2 / ζ)))
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourKloosterman_one theorem DurfeeCCS.Step06.Dedekind
DurfeeCCS.Step06.twoColourKloosterman_one (n : ℕ) : DurfeeCCS.Step06.twoColourKloosterman n 1 = 1
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourPartitionCount_eq_coeff_restricted theorem DurfeeCCS.Step06.TwoColour
DurfeeCCS.Step06.twoColourPartitionCount_eq_coeff_restricted (n d : ℕ) (hd : n ≤ d) :
  DurfeeCCS.Step06.twoColourPartitionCount n = (PowerSeries.coeff n) (DurfeeCCS.restrictedPairSeries d)
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourPartitionCount_eq_convolution theorem DurfeeCCS.Step06.TwoColour
DurfeeCCS.Step06.twoColourPartitionCount_eq_convolution (n : ℕ) :
  DurfeeCCS.Step06.twoColourPartitionCount n =
    ∑ ab ∈ Finset.HasAntidiagonal.antidiagonal n, ↑(Fintype.card ab.1.Partition) * ↑(Fintype.card ab.2.Partition)
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourPartitionCount_eq_eta_angular_integral theorem DurfeeCCS.Step06.RademacherGenerating
DurfeeCCS.Step06.twoColourPartitionCount_eq_eta_angular_integral (n : ℕ) {u : ℝ} (hu : 0 < u) :
  ↑(DurfeeCCS.Step06.twoColourPartitionCount n) =
    (2 * ↑Real.pi)⁻¹ *
      ∫ (v : ℝ) in -Real.pi..Real.pi,
        Complex.exp ((↑n - 1 / 12) * (↑u + ↑v * Complex.I)) *
          (ModularForm.eta (Complex.I * (↑u + ↑v * Complex.I) / (2 * ↑Real.pi)))⁻¹ ^ 2
STEP13_DECL_KIND DurfeeCCS.Step06.twoColourRademacherRHS_eq_IJT theorem DurfeeCCS.Step06.Rademacher
DurfeeCCS.Step06.twoColourRademacherRHS_eq_IJT {n : ℕ} (hn : 0 < n) :
  DurfeeCCS.Step06.twoColourRademacherRHS n =
    ↑(√(1 / 12) ^ 2 / √(↑n - 1 / 12) ^ 2 * (2 * Real.pi)) *
      ∑' (k : ℕ),
