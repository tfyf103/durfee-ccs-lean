STEP13_DECL_KIND DurfeeCCS.Step10.outerPhi other DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.outerPhi (y h : ℝ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step10.outerRho other DurfeeCCS.Step10.OuterRho
DurfeeCCS.Step10.outerRho (h t : ℝ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step10.outerRhoAt_sq theorem DurfeeCCS.Step10.OuterRho
DurfeeCCS.Step10.outerRhoAt_sq (h t a : ℝ) : DurfeeCCS.Step10.outerRhoAt h t a ^ 2 = (↑h + Complex.I * ↑t) ^ 2 + ↑a
STEP13_DECL_KIND DurfeeCCS.Step10.outerRho_high_gap theorem DurfeeCCS.Step10.OuterErrorModes
DurfeeCCS.Step10.outerRho_high_gap {h v a : ℝ} (hh : 8.76 < h) (hv : h < |v|) (ha : 0 ≤ a)
  (ha' : a ≤ 4 * Real.pi ^ 2 / 3) :
  Max.max 0.152 (1 / 4 - 8.4 / h ^ 2) <
    3 * h / (4 * Real.pi ^ 2) * ((DurfeeCCS.Step10.outerRho h Real.pi).re - (DurfeeCCS.Step10.outerRhoAt h v a).re)
STEP13_DECL_KIND DurfeeCCS.Step10.outerRho_phase_gap theorem DurfeeCCS.Step10.OuterRho
DurfeeCCS.Step10.outerRho_phase_gap {y h : ℝ} (hy : 0 ≤ y) (hh : 0 < h) :
  0 <
      (y * (DurfeeCCS.Step10.outerRho h Real.pi).im + (DurfeeCCS.Step10.outerRho h Real.pi).arg) / Real.pi -
        y * h / √(h ^ 2 + 4 * Real.pi ^ 2 / 3) ∧
    (y * (DurfeeCCS.Step10.outerRho h Real.pi).im + (DurfeeCCS.Step10.outerRho h Real.pi).arg) / Real.pi -
        y * h / √(h ^ 2 + 4 * Real.pi ^ 2 / 3) ≤
      2 * Real.pi ^ 4 * y / (3 * h * √(h ^ 2 + 4 * Real.pi ^ 2 / 3) ^ 3) + 1 / h
STEP13_DECL_KIND DurfeeCCS.Step10.outerRho_re_gt theorem DurfeeCCS.Step10.OuterRho
DurfeeCCS.Step10.outerRho_re_gt {h t : ℝ} (hh : 0 < h) : h < (DurfeeCCS.Step10.outerRho h t).re
STEP13_DECL_KIND DurfeeCCS.Step10.outerRho_re_low_gap theorem DurfeeCCS.Step10.OuterErrorModes
DurfeeCCS.Step10.outerRho_re_low_gap {h v : ℝ} (hv : 3 * Real.pi ≤ |v|) (hh : |v| ≤ h) :
  13 * Real.pi ^ 2 * (v ^ 2 - Real.pi ^ 2) / (50 * h ^ 3) <
    (DurfeeCCS.Step10.outerRho h Real.pi).re - (DurfeeCCS.Step10.outerRho h v).re
STEP13_DECL_KIND DurfeeCCS.Step10.outerRho_re_pi_gap theorem DurfeeCCS.Step10.OuterErrorModes
DurfeeCCS.Step10.outerRho_re_pi_gap {h : ℝ} (hh : 8.76 < h) :
  17 * Real.pi ^ 2 / (30 * h) < (DurfeeCCS.Step10.outerRho h Real.pi).re - h
STEP13_DECL_KIND DurfeeCCS.Step10.outerRoots_of_alternating theorem DurfeeCCS.Step10.OuterRoots
DurfeeCCS.Step10.outerRoots_of_alternating {n d₀ : ℕ} (hn : 0 < n) (hd₀ : d₀ < n.sqrt) (x : ℕ → ℝ)
  (hpos : ∀ (d : ℕ), d₀ ≤ d → d < n.sqrt → 0 < x d) (hmono : StrictMonoOn x (Set.Ico d₀ n.sqrt))
  (hsign : ∀ (d : ℕ), d₀ ≤ d → d < n.sqrt → 0 < (-1) ^ d * Polynomial.eval (-x d) (DurfeeCCS.durfeePolynomialReal n)) :
  ∃ r, ∀ (i : Fin (n.sqrt - d₀)), r i < -x d₀ ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (r i)
STEP13_DECL_KIND DurfeeCCS.Step10.outerShiftedIndex other DurfeeCCS.Step10.OuterFiniteExpansionData
DurfeeCCS.Step10.outerShiftedIndex (n d a b j : ℕ) : ℤ
STEP13_DECL_KIND DurfeeCCS.Step10.outerShiftedIndex_sq theorem DurfeeCCS.Step10.OuterFiniteExpansionData
DurfeeCCS.Step10.outerShiftedIndex_sq {n d a b j : ℕ} (hn : 1 ≤ n)
  (hr : DurfeeCCS.Step10.outerGamma a b j ≤ DurfeeCCS.Step10.outerY n ^ 2) :
  DurfeeCCS.Step10.outerTripleRadius n a b j ^ 2 - (↑d + (↑a + ↑b) / 2) ^ 2 =
    ↑(DurfeeCCS.Step10.outerShiftedIndex n d a b j) - 1 / 12
STEP13_DECL_KIND DurfeeCCS.Step10.outerStart_add_two_lt_farThreshold theorem DurfeeCCS.Step10.OuterGeometryBounds
DurfeeCCS.Step10.outerStart_add_two_lt_farThreshold {n : ℕ} (hn : 6401 ≤ n) :
  DurfeeCCS.Step10.outerStart n + 2 < DurfeeCCS.Step10.farThreshold n
STEP13_DECL_KIND DurfeeCCS.Step10.outerStart_gt theorem DurfeeCCS.Step10.OuterGeometryBounds
DurfeeCCS.Step10.outerStart_gt {n : ℕ} (hn : 6401 ≤ n) : 8.76 < DurfeeCCS.Step10.outerStart n
STEP13_DECL_KIND DurfeeCCS.Step10.outerTransformAbsSum theorem DurfeeCCS.Step10.OuterErrorTransfer
DurfeeCCS.Step10.outerTransformAbsSum {y₀ y h : ℝ} (hy₀ : 80 < y₀) (hy : 9 / 10 * y₀ ≤ y) (hh : 8.76 < h)
  (hcap : h ≤ 4 * y₀ ^ (1 / 3)) :
  (Summable fun p =>
      ‖DurfeeCCS.Step10.kernelTransform y (DurfeeCCS.Step10.outerZeta h (DurfeeCCS.Step10.outerFrequency p))‖) ∧
    ∑' (p : ℤ),
        ‖DurfeeCCS.Step10.kernelTransform y (DurfeeCCS.Step10.outerZeta h (DurfeeCCS.Step10.outerFrequency p))‖ <
      1.42 * DurfeeCCS.Step10.outerTransformAmplitude y h
STEP13_DECL_KIND DurfeeCCS.Step10.outerTransformAmplitude other DurfeeCCS.Step10.OuterErrorNormalize
DurfeeCCS.Step10.outerTransformAmplitude (y h : ℝ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step10.outerTransformAmplitude_pos theorem DurfeeCCS.Step10.OuterErrorNormalize
DurfeeCCS.Step10.outerTransformAmplitude_pos {y h : ℝ} (hy : 0 < y) (hh : 0 < h) :
  0 < DurfeeCCS.Step10.outerTransformAmplitude y h
STEP13_DECL_KIND DurfeeCCS.Step10.outerTransformLeadingPair theorem DurfeeCCS.Step10.OuterErrorTransfer
DurfeeCCS.Step10.outerTransformLeadingPair {y₀ h : ℝ} (hy₀ : 80 < y₀) (hh : 8.76 < h) (hcap : h ≤ 4 * y₀ ^ (1 / 3)) :
  ‖∑' (p : ℤ), DurfeeCCS.Step10.kernelTransform y₀ (DurfeeCCS.Step10.outerZeta h (DurfeeCCS.Step10.outerFrequency p)) -
        ↑(2 * (DurfeeCCS.Step10.outerMainMode y₀ h Real.pi).re)‖ <
    0.130 * DurfeeCCS.Step10.outerTransformAmplitude y₀ h
STEP13_DECL_KIND DurfeeCCS.Step10.outerTripleKernel_zero_error theorem DurfeeCCS.Step10.OuterApproximation
DurfeeCCS.Step10.outerTripleKernel_zero_error {n : ℕ} (hn : 6401 ≤ n) {h : ℝ} (hh : DurfeeCCS.Step10.outerStart n ≤ h)
  (hcap : h ≤ DurfeeCCS.Step10.farThreshold n) :
  |DurfeeCCS.Step10.outerTripleKernel n h (0, 0, 0) - DurfeeCCS.Step10.outerPrediction (DurfeeCCS.Step10.outerY n) h| <
    0.130 * DurfeeCCS.Step10.outerTransformAmplitude (DurfeeCCS.Step10.outerY n) h
STEP13_DECL_KIND DurfeeCCS.Step10.outerTripleMass_bound theorem DurfeeCCS.Step10.OuterApproximation
DurfeeCCS.Step10.outerTripleMass_bound : DurfeeCCS.Step10.OuterTripleMassBound
STEP13_DECL_KIND DurfeeCCS.Step10.outerWeightProduct_cap theorem DurfeeCCS.Step10.OuterEulerWeightLog
DurfeeCCS.Step10.outerWeightProduct_cap {Y h : ℝ} (hY : 80 ≤ Y) (hh : 2 * Real.log Y ≤ h) :
  DurfeeCCS.Step10.outerWeightProduct (Real.exp (-h / 2)) (DurfeeCCS.Step10.outerWeightSigma Y h) < Real.exp 0.461
STEP13_DECL_KIND DurfeeCCS.Step10.outerWeightProduct_log theorem DurfeeCCS.Step10.OuterEulerWeightLog
DurfeeCCS.Step10.outerWeightProduct_log {w σ : ℝ} (hw₀ : 0 ≤ w) (hw : w < 1) (hσ : 0 < σ) :
  0 < DurfeeCCS.Step10.outerWeightProduct w σ ∧
    Real.log (DurfeeCCS.Step10.outerWeightProduct w σ) =
        ∑' (l : ℕ), w ^ (l + 1) / ((↑l + 1) * Real.sinh (σ * (↑l + 1) / 2)) ∧
      Real.log (DurfeeCCS.Step10.outerWeightProduct w σ) ≤ 2 / σ * DurfeeCCS.Step10.outerWeightDilog w
STEP13_DECL_KIND DurfeeCCS.Step10.proposition41 theorem DurfeeCCS.Step10.OuterComplete
DurfeeCCS.Step10.proposition41 : DurfeeCCS.Step10.OuterBesselApproximation
STEP13_DECL_KIND DurfeeCCS.Step10.proposition41_at_radius theorem DurfeeCCS.Step10.OuterComplete
DurfeeCCS.Step10.proposition41_at_radius {n : ℕ} (hn : 6401 ≤ n) {r : ℝ} (hr : 0 < r)
  (hlo : Real.log (↑n - 1 / 12) ≤ 2 * Real.log r) (hhi : 2 * Real.log r ≤ 4 * (↑n - 1 / 12) ^ (1 / 6)) :
  |DurfeeCCS.Step08.durfeeNegativeValue n r -
        DurfeeCCS.Step10.outerPrediction (DurfeeCCS.Step10.outerY n) (2 * Real.log r)| <
    0.99 * DurfeeCCS.Step10.outerTransformAmplitude (DurfeeCCS.Step10.outerY n) (2 * Real.log r)
STEP13_DECL_KIND DurfeeCCS.Step10.restrictedPair_coefficient_eq_outerExpansion theorem DurfeeCCS.Step10.OuterExpansion
DurfeeCCS.Step10.restrictedPair_coefficient_eq_outerExpansion (d N : ℕ) :
  (PowerSeries.coeff N) (DurfeeCCS.restrictedPairSeries d) =
    ∑ ab ∈ Finset.range (N + 1) ×ˢ Finset.range (N + 1), DurfeeCCS.Step10.outerShiftedCoeff d ab.1 ab.2 N
STEP13_DECL_KIND DurfeeCCS.Step10.saddlePhase_outerPhase_lt theorem DurfeeCCS.Step10.OuterPhase
DurfeeCCS.Step10.saddlePhase_outerPhase_lt {n : ℕ} {h : ℝ} (hn : 6401 ≤ n) (hh : 2 * Real.log √(↑n - 1 / 12) ≤ h) :
  |DurfeeCCS.Step06.saddlePhase n (Real.exp (h / 2)) -
        (√(↑n - 1 / 12) * (DurfeeCCS.Step10.outerRho h Real.pi).im + (DurfeeCCS.Step10.outerRho h Real.pi).arg)| <
    0.470736
STEP13_DECL_KIND DurfeeCCS.Step10.shifted_outerBessel_poisson theorem DurfeeCCS.Step10.OuterBesselPoisson
DurfeeCCS.Step10.shifted_outerBessel_poisson {y : ℝ} (hy : 0 ≤ y) (h a : ℝ) :
  ∑' (d : ℤ), (-↑(Real.exp h)) ^ d * ↑(DurfeeCCS.Step10.outerBesselKernel y (↑d + a)) =
    ↑(Real.exp (-h * a)) *
      ∑' (m : ℤ),
        Complex.exp (-↑(DurfeeCCS.Step10.outerFrequency m * a) * Complex.I) *
          DurfeeCCS.Step10.kernelTransform y (↑h + ↑(DurfeeCCS.Step10.outerFrequency m) * Complex.I)
STEP13_DECL_KIND DurfeeCCS.Step10.singleMonomialDominates theorem DurfeeCCS.Step10.OuterFarDominance
DurfeeCCS.Step10.singleMonomialDominates (hc : DurfeeCCS.Step10.FarCoefficientBounds) {n d : ℕ} (hn : 6401 ≤ n)
  (hd : 1 ≤ d) (hdm : d < n.sqrt) (hfar : DurfeeCCS.Step10.farThreshold n ≤ DurfeeCCS.Step10.farSample n d) :
  ∑ l ∈ (Finset.Icc 1 n.sqrt).erase d, DurfeeCCS.Step10.farWeighted n l (DurfeeCCS.Step10.farSample n d) <
    DurfeeCCS.Step10.farWeighted n d (DurfeeCCS.Step10.farSample n d)
STEP13_DECL_KIND DurfeeCCS.Step10.sinhKernelDerivative theorem DurfeeCCS.Step10.OuterBesselEndpoints
DurfeeCCS.Step10.sinhKernelDerivative {ζ : ℂ} (hζ : 0 < ζ.re) {u : ℝ} (hu : 0 ≤ u) (y : ℝ) :
  HasDerivAt (fun s => Complex.sinh (↑y * (ζ ^ 2 + ↑s).sqrt) / (ζ ^ 2 + ↑s).sqrt)
    (↑y * Complex.cosh (↑y * (ζ ^ 2 + ↑u).sqrt) / (2 * (ζ ^ 2 + ↑u)) -
      Complex.sinh (↑y * (ζ ^ 2 + ↑u).sqrt) / (2 * (ζ ^ 2 + ↑u).sqrt ^ 3))
    u
STEP13_DECL_KIND DurfeeCCS.Step10.smallRadius_budget theorem DurfeeCCS.Step10.OuterPreprocessingBudget
DurfeeCCS.Step10.smallRadius_budget {y X h : ℝ} (hy : 80 ≤ y) (hX : 0 < X) (hX₂ : X ^ 2 = y ^ 2 + 1 / 12)
  (hh : 8.76 < h) (hhLog : 2 * Real.log y ≤ h) (hhCap : h ≤ 4 * y ^ (1 / 3)) :
  have p := √(h ^ 2 + 4 * Real.pi ^ 2 / 3);
  have z := DurfeeCCS.Step10.outerGeomFactor h (p / (4 * X));
  X / (1 - z) ^ 2 * Real.exp (X * p - 0.19 * p * y ^ 2 / (4 * X)) / DurfeeCCS.Step10.outerTransformAmplitude y h < 4e-5
STEP13_DECL_KIND DurfeeCCS.Step10.smallRadius_geomFactor_lt theorem DurfeeCCS.Step10.OuterPreprocessingParams
DurfeeCCS.Step10.smallRadius_geomFactor_lt {y X h : ℝ} (hy : 80 ≤ y) (hX : 0 < X) (hXy : X / y ≤ 1.00001)
  (hh : 8.76 < h) (hhLog : 2 * Real.log y ≤ h) :
  DurfeeCCS.Step10.outerGeomFactor h (√(h ^ 2 + 4 * Real.pi ^ 2 / 3) / (4 * X)) < 0.47
STEP13_DECL_KIND DurfeeCCS.Step10.smallRadius_sum_error_lt theorem DurfeeCCS.Step10.OuterPreprocessingSmall
DurfeeCCS.Step10.smallRadius_sum_error_lt {n : ℕ} {h : ℝ} (hn : 6401 ≤ n) (hh : DurfeeCCS.Step10.outerStart n ≤ h)
  (hhCap : h ≤ DurfeeCCS.Step10.farThreshold n) :
  (∑ abj ∈ DurfeeCCS.Step10.outerTripleBox n \ DurfeeCCS.Step10.outerGoodTriples n,
        |DurfeeCCS.Step10.outerTripleValue n h abj|) /
      DurfeeCCS.Step10.outerTransformAmplitude (DurfeeCCS.Step10.outerY n) h <
    4e-5
STEP13_DECL_KIND DurfeeCCS.Step10.sphereBesselIdentity theorem DurfeeCCS.Step10.OuterBesselSphere
DurfeeCCS.Step10.sphereBesselIdentity {y : ℝ} (hy : 0 ≤ y) (τ : ℝ) (ζ : ℂ) (hz : ζ ^ 2 + ↑τ ^ 2 ≠ 0) :
  have w := (ζ ^ 2 + ↑τ ^ 2).sqrt;
  ∫ (x : ℝ) in -y..y, Complex.exp (ζ * ↑x) * DurfeeCCS.Step10.sphereBesselFactor y τ x = 2 * Complex.sinh (↑y * w) / w
STEP13_DECL_KIND DurfeeCCS.Step10.sphereBesselIdentity_zero theorem DurfeeCCS.Step10.OuterBesselSphere
DurfeeCCS.Step10.sphereBesselIdentity_zero {y : ℝ} (hy : 0 ≤ y) (τ : ℝ) (ζ : ℂ) (hz : ζ ^ 2 + ↑τ ^ 2 = 0) :
  ∫ (x : ℝ) in -y..y, Complex.exp (ζ * ↑x) * DurfeeCCS.Step10.sphereBesselFactor y τ x = 2 * ↑y
STEP13_DECL_KIND DurfeeCCS.Step10.strictMonoOn_outerSample theorem DurfeeCCS.Step10.OuterSamples
DurfeeCCS.Step10.strictMonoOn_outerSample {n : ℕ} (hn : 6401 ≤ n) :
  StrictMonoOn (DurfeeCCS.Step10.outerSample n) (Set.Ico (DurfeeCCS.Step10.outerFirst n) n.sqrt)
STEP13_DECL_KIND DurfeeCCS.Step10.strictMono_outerDelta theorem DurfeeCCS.Step10.OuterDelta
DurfeeCCS.Step10.strictMono_outerDelta {y : ℝ} (hy : 0 < y) : StrictMono (DurfeeCCS.Step10.outerDelta y)
STEP13_DECL_KIND DurfeeCCS.Step10.summable_kernelTransform_odd theorem DurfeeCCS.Step10.OuterBesselPoisson
DurfeeCCS.Step10.summable_kernelTransform_odd {y : ℝ} (hy : 0 ≤ y) (h : ℝ) :
  Summable fun m => ‖DurfeeCCS.Step10.kernelTransform y (↑h + ↑(DurfeeCCS.Step10.outerFrequency m) * Complex.I)‖
STEP13_DECL_KIND DurfeeCCS.Step10.twoColourGenerating_mul_eulerTail_sq theorem DurfeeCCS.Step10.OuterEulerTail
DurfeeCCS.Step10.twoColourGenerating_mul_eulerTail_sq {q : ℂ} (hq : ‖q‖ < 1) (d : ℕ) :
  DurfeeCCS.Step06.twoColourGenerating q * DurfeeCCS.Step10.outerEulerTail q d ^ 2 = (DurfeeCCS.qPochhammer q q d)⁻¹ ^ 2
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_bessel_error_relative theorem DurfeeCCS.Step10.OuterCoeff
DurfeeCCS.Step10.twoColour_bessel_error_relative {t : ℕ} (ht : 0 < t) :
  |↑(DurfeeCCS.Step06.twoColourPartitionCount t) -
        DurfeeCCS.Step10.outerBesselMain (DurfeeCCS.Step10.twoColourShift t)| ≤
    DurfeeCCS.Step10.outerComparisonB (DurfeeCCS.Step10.twoColourShift t) *
      DurfeeCCS.Step10.outerCoeffRemainder (DurfeeCCS.Step10.twoColourShift t)
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_bessel_error_small theorem DurfeeCCS.Step10.OuterCoeffSmall
DurfeeCCS.Step10.twoColour_bessel_error_small {t : ℕ} (ht : 0 < t) (ht' : t ≤ 15) :
  |↑(DurfeeCCS.Step06.twoColourPartitionCount t) -
        DurfeeCCS.Step10.outerBesselMain (DurfeeCCS.Step10.twoColourShift t)| ≤
    Real.pi ^ 3 / 36 * Real.exp (Real.pi * √(↑t / 3))
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_bessel_error_small_three theorem DurfeeCCS.Step10.OuterCoeffSmall
DurfeeCCS.Step10.twoColour_bessel_error_small_three {t : ℕ} (ht : 0 < t) (ht' : t ≤ 15) :
  |↑(DurfeeCCS.Step06.twoColourPartitionCount t) -
        DurfeeCCS.Step10.outerBesselMain (DurfeeCCS.Step10.twoColourShift t)| ≤
    3
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_bessel_error_unconditional theorem DurfeeCCS.Step10.OuterCoeff
DurfeeCCS.Step10.twoColour_bessel_error_unconditional {t : ℕ} (ht : 0 < t) :
  |↑(DurfeeCCS.Step06.twoColourPartitionCount t) -
        DurfeeCCS.Step10.outerBesselMain (DurfeeCCS.Step10.twoColourShift t)| ≤
    Real.pi ^ 3 / 36 * Real.exp (Real.pi * √(↑t / 3))
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_exp_bound theorem DurfeeCCS.Step10.OuterCoeffElementary
DurfeeCCS.Step10.twoColour_exp_bound (t : ℕ) :
  ↑(DurfeeCCS.Step06.twoColourPartitionCount t) ≤ Real.exp (2 * Real.pi * √(↑t / 3))
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_restricted_error theorem DurfeeCCS.Step10.OuterCoeffElementary
DurfeeCCS.Step10.twoColour_restricted_error {k t : ℕ} (hkt : k + 1 ≤ t) :
  0 ≤ ↑(DurfeeCCS.Step06.twoColourPartitionCount t) - ↑((PowerSeries.coeff t) (DurfeeCCS.restrictedPairSeries k)) ∧
    ↑(DurfeeCCS.Step06.twoColourPartitionCount t) - ↑((PowerSeries.coeff t) (DurfeeCCS.restrictedPairSeries k)) ≤
      2 * ↑t * Real.exp (2 * Real.pi * √(↑(t - k - 1) / 3))
STEP13_DECL_KIND DurfeeCCS.Step10.twoColour_sub_restrictedPair_le theorem DurfeeCCS.Step10.OuterFarCoefficients
DurfeeCCS.Step10.twoColour_sub_restrictedPair_le (n d : ℕ) :
  0 ≤ DurfeeCCS.Step06.twoColourPartitionCount n - (PowerSeries.coeff n) (DurfeeCCS.restrictedPairSeries d) ∧
    DurfeeCCS.Step06.twoColourPartitionCount n - (PowerSeries.coeff n) (DurfeeCCS.restrictedPairSeries d) ≤
      2 * ∑ v ∈ Finset.range (n - d), DurfeeCCS.Step06.twoColourPartitionCount v
STEP13_DECL_KIND DurfeeCCS.Step10.twoSaddle_sq_eq_outerRho theorem DurfeeCCS.Step10.OuterPhase
DurfeeCCS.Step10.twoSaddle_sq_eq_outerRho (h : ℝ) :
  (2 * DurfeeCCS.Step06.saddleS (Real.exp (h / 2))) ^ 2 =
    DurfeeCCS.Step10.outerRho h Real.pi ^ 2 + 8 * DurfeeCCS.Step06.principalDilog (↑(Real.exp (-h / 2)) * Complex.I)
STEP13_DECL_KIND DurfeeCCS.Step11.durfeePolynomialReal_derivative_eval_zero theorem DurfeeCCS.Step11.RootData
DurfeeCCS.Step11.durfeePolynomialReal_derivative_eval_zero (n : ℕ) :
  Polynomial.eval 0 (Polynomial.derivative (DurfeeCCS.durfeePolynomialReal n)) = ↑n
STEP13_DECL_KIND DurfeeCCS.Step11.durfeePolynomialReal_origin_simple theorem DurfeeCCS.Step11.RootData
DurfeeCCS.Step11.durfeePolynomialReal_origin_simple {n : ℕ} (hn : 1 ≤ n) :
  (DurfeeCCS.durfeePolynomialReal n).IsRoot 0 ∧ Polynomial.rootMultiplicity 0 (DurfeeCCS.durfeePolynomialReal n) = 1
STEP13_DECL_KIND DurfeeCCS.Step11.durfeeRootCompletion_of_threeIntervals theorem DurfeeCCS.Step11.ThreeIntervals
DurfeeCCS.Step11.durfeeRootCompletion_of_threeIntervals {n d₀ : ℕ} (hn : 0 < n) (hd : 8 ≤ d₀) (hdm : d₀ ≤ n.sqrt)
  {a b : ℝ} (hab : a < b) (hb : b < 0) (outer : Fin (n.sqrt - d₀) ↪ ℝ) (middle : Fin (d₀ - 8) ↪ ℝ) (near : Fin 7 ↪ ℝ)
  (houter : ∀ (i : Fin (n.sqrt - d₀)), outer i < a ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (outer i))
  (hmiddle : ∀ (i : Fin (d₀ - 8)), a < middle i ∧ middle i < b ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (middle i))
  (hnear : ∀ (i : Fin 7), b < near i ∧ near i < 0 ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (near i)) :
  ∃ r,
    (∀ (i : Fin (n.sqrt - 1)), r i < 0 ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (r i)) ∧
      DurfeeCCS.RootCompletion (DurfeeCCS.durfeePolynomialReal n) r
STEP13_DECL_KIND DurfeeCCS.Step11.largeDurfeeRoots theorem DurfeeCCS.Step11.Large
DurfeeCCS.Step11.largeDurfeeRoots {n : ℕ} (hn : 6401 ≤ n) : DurfeeCCS.HasDurfeeRoots n
STEP13_DECL_KIND DurfeeCCS.Step11.large_durfee_root_intervals theorem DurfeeCCS.Step11.Large
DurfeeCCS.Step11.large_durfee_root_intervals {n : ℕ} (hn : 6401 ≤ n) :
  ∃ d₀ rPlus,
    10 ≤ d₀ ∧
      d₀ < n.sqrt ∧
        DurfeeCCS.Step11.nearOriginRadius n < rPlus ∧
          ∃ outer middle near,
            (∀ (i : Fin (n.sqrt - d₀)), outer i < -rPlus ^ 2 ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (outer i)) ∧
              (∀ (i : Fin (d₀ - 8)),
                  middle i ∈ Set.Ioo (-rPlus ^ 2) (-DurfeeCCS.Step11.nearOriginRadius n ^ 2) ∧
                    (DurfeeCCS.durfeePolynomialReal n).IsRoot (middle i)) ∧
                ∀ (i : Fin 7),
                  near i ∈ Set.Ioo (-DurfeeCCS.Step11.nearOriginRadius n ^ 2) 0 ∧
                    (DurfeeCCS.durfeePolynomialReal n).IsRoot (near i)
STEP13_DECL_KIND DurfeeCCS.Step11.middlePhaseRadius_spec theorem DurfeeCCS.Step11.PhaseLadder
DurfeeCCS.Step11.middlePhaseRadius_spec {n d₀ k : ℕ} {rMinus rPlus : ℝ} (hrMinus : 0 < rMinus) (hr : rMinus ≤ rPlus)
  (hphaseMinus : DurfeeCCS.Step06.saddlePhase n rMinus < 9 * Real.pi)
  (hphasePlus : (↑d₀ - 1) * Real.pi < DurfeeCCS.Step06.saddlePhase n rPlus) (hk₁ : 9 ≤ k) (hk₂ : k < d₀) :
  IsLeast (Set.Icc rMinus rPlus ∩ DurfeeCCS.Step06.saddlePhase n ⁻¹' {↑k * Real.pi})
      (DurfeeCCS.Step11.middlePhaseRadius n rMinus rPlus k) ∧
    DurfeeCCS.Step11.middlePhaseRadius n rMinus rPlus k ∈ Set.Ioo rMinus rPlus
STEP13_DECL_KIND DurfeeCCS.Step11.middleRoots_of_endpoint_phase theorem DurfeeCCS.Step11.PhaseLadder
DurfeeCCS.Step11.middleRoots_of_endpoint_phase {n d₀ : ℕ} {rMinus rPlus : ℝ} (hn : 6400 ≤ n) (hd : 9 ≤ d₀)
  (hrMinus : 0 < rMinus) (hr : rMinus < rPlus) (hrPlus : rPlus ≤ Real.exp 1 * √↑n)
  (hscale : 4 * Real.pi ≤ √(↑n * rMinus)) (hphaseMinus : DurfeeCCS.Step06.saddlePhase n rMinus < 9 * Real.pi)
  (hphasePlus : (↑d₀ - 1) * Real.pi < DurfeeCCS.Step06.saddlePhase n rPlus)
  (hsignMinus : 0 < Polynomial.eval (-rMinus ^ 2) (DurfeeCCS.durfeePolynomialReal n))
  (hsignPlus : (Polynomial.eval (-rPlus ^ 2) (DurfeeCCS.durfeePolynomialReal n)).sign = (-1) ^ d₀) :
  ∃ roots,
    ∀ (i : Fin (d₀ - 8)),
      roots i ∈ Set.Ioo (-rPlus ^ 2) (-rMinus ^ 2) ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (roots i)
STEP13_DECL_KIND DurfeeCCS.Step11.middle_sign_at_integer_phase theorem DurfeeCCS.Step11.PhaseLadder
DurfeeCCS.Step11.middle_sign_at_integer_phase {n : ℕ} {k : ℤ} {rMinus rPlus r : ℝ} (hn : 6400 ≤ n)
  (hrMinus : 0 < rMinus) (hrPlus : rPlus ≤ Real.exp 1 * √↑n) (hscale : 4 * Real.pi ≤ √(↑n * rMinus))
  (hr : r ∈ Set.Icc rMinus rPlus) (hphase : DurfeeCCS.Step06.saddlePhase n r = ↑k * Real.pi) :
  (Polynomial.eval (-r ^ 2) (DurfeeCCS.durfeePolynomialReal n)).sign = (-1) ^ k
STEP13_DECL_KIND DurfeeCCS.Step11.nearOrigin_endpoint_pos theorem DurfeeCCS.Step11.NearOrigin
DurfeeCCS.Step11.nearOrigin_endpoint_pos {n : ℕ} (hn : 6401 ≤ n) :
  0 < Polynomial.eval (-DurfeeCCS.Step11.nearOriginRadius n ^ 2) (DurfeeCCS.durfeePolynomialReal n)
STEP13_DECL_KIND DurfeeCCS.Step11.nearOrigin_phase_bound_strong theorem DurfeeCCS.Step11.NearOrigin
DurfeeCCS.Step11.nearOrigin_phase_bound_strong {n : ℕ} (hn : 6401 ≤ n) :
  |DurfeeCCS.Step06.saddlePhase n (DurfeeCCS.Step11.nearOriginRadius n) - 8 * Real.pi| <
    (4 * Real.pi + 1) * DurfeeCCS.Step11.nearOriginRadius n
STEP13_DECL_KIND DurfeeCCS.Step11.nearOrigin_phase_budget theorem DurfeeCCS.Step11.NearOrigin
DurfeeCCS.Step11.nearOrigin_phase_budget {n : ℕ} (hn : 6401 ≤ n) :
  (4 * Real.pi + 1) * DurfeeCCS.Step11.nearOriginRadius n < 0.35
STEP13_DECL_KIND DurfeeCCS.Step11.nearOrigin_seven_roots theorem DurfeeCCS.Step11.NearOrigin
DurfeeCCS.Step11.nearOrigin_seven_roots {n : ℕ} (hn : 6401 ≤ n) :
  ∃ e,
    ∀ (i : Fin 7),
      e i ∈ Set.Ioo (-DurfeeCCS.Step11.nearOriginRadius n ^ 2) 0 ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (e i)
STEP13_DECL_KIND DurfeeCCS.Step11.negativeRoots_of_threeIntervals theorem DurfeeCCS.Step11.ThreeIntervals
DurfeeCCS.Step11.negativeRoots_of_threeIntervals (P : Polynomial ℝ) {m d₀ : ℕ} (hd : 8 ≤ d₀) (hdm : d₀ ≤ m) {a b : ℝ}
  (hab : a < b) (hb : b < 0) (outer : Fin (m - d₀) ↪ ℝ) (middle : Fin (d₀ - 8) ↪ ℝ) (near : Fin 7 ↪ ℝ)
  (houter : ∀ (i : Fin (m - d₀)), outer i < a ∧ P.IsRoot (outer i))
  (hmiddle : ∀ (i : Fin (d₀ - 8)), a < middle i ∧ middle i < b ∧ P.IsRoot (middle i))
  (hnear : ∀ (i : Fin 7), b < near i ∧ near i < 0 ∧ P.IsRoot (near i)) :
  ∃ r, ∀ (i : Fin (m - 1)), r i < 0 ∧ P.IsRoot (r i)
STEP13_DECL_KIND DurfeeCCS.Step11.outerEndpoint theorem DurfeeCCS.Step11.OuterEndpoint
DurfeeCCS.Step11.outerEndpoint {n : ℕ} (hn : 6401 ≤ n) :
  ∃ d₀ rPlus,
    10 ≤ d₀ ∧
      d₀ < n.sqrt ∧
        1 < rPlus ∧
          rPlus < Real.exp 1 * √↑n ∧
            (Polynomial.eval (-rPlus ^ 2) (DurfeeCCS.durfeePolynomialReal n)).sign = (-1) ^ d₀ ∧
              (↑d₀ - 1) * Real.pi < DurfeeCCS.Step06.saddlePhase n rPlus ∧
                ∃ root,
                  ∀ (i : Fin (n.sqrt - d₀)), root i < -rPlus ^ 2 ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot (root i)
STEP13_DECL_KIND DurfeeCCS.Step11.strictMonoOn_middlePhaseRadius theorem DurfeeCCS.Step11.PhaseLadder
DurfeeCCS.Step11.strictMonoOn_middlePhaseRadius {n d₀ : ℕ} {rMinus rPlus : ℝ} (hrMinus : 0 < rMinus)
  (hr : rMinus ≤ rPlus) (hphaseMinus : DurfeeCCS.Step06.saddlePhase n rMinus < 9 * Real.pi)
  (hphasePlus : (↑d₀ - 1) * Real.pi < DurfeeCCS.Step06.saddlePhase n rPlus) :
  StrictMonoOn (DurfeeCCS.Step11.middlePhaseRadius n rMinus rPlus) (Set.Ico 9 d₀)
STEP13_DECL_KIND DurfeeCCS.Step13.dyadicValue_lt_iff_cross_mul theorem DurfeeCCS.Step13.FiniteCounts
DurfeeCCS.Step13.dyadicValue_lt_iff_cross_mul (a b : ℕ × ℕ) :
  DurfeeCCS.dyadicValue a < DurfeeCCS.dyadicValue b ↔
    a.1 * DurfeeCCS.dyadicDenominator b < b.1 * DurfeeCCS.dyadicDenominator a
STEP13_DECL_KIND DurfeeCCS.Step13.finite_order_check_count theorem DurfeeCCS.Step13.FiniteCounts
DurfeeCCS.Step13.finite_order_check_count : ∑ n ∈ Finset.Icc 1 6400, (n.sqrt - 3) = 319011
STEP13_DECL_KIND DurfeeCCS.Step13.finite_sign_check_count theorem DurfeeCCS.Step13.FiniteCounts
DurfeeCCS.Step13.finite_sign_check_count : ∑ n ∈ Finset.Icc 1 6400, (n.sqrt - 2) = 325403
STEP13_DECL_KIND DurfeeCCS.Step13.intCoeff other DurfeeCCS.Step13.Conventions
DurfeeCCS.Step13.intCoeff (H : PowerSeries ℤ) (j : ℤ) : ℤ
STEP13_DECL_KIND DurfeeCCS.Step13.intCoeff_natCast theorem DurfeeCCS.Step13.Conventions
DurfeeCCS.Step13.intCoeff_natCast (H : PowerSeries ℤ) (j : ℕ) : DurfeeCCS.Step13.intCoeff H ↑j = (PowerSeries.coeff j) H
STEP13_DECL_KIND DurfeeCCS.Step13.intCoeff_of_neg theorem DurfeeCCS.Step13.Conventions
DurfeeCCS.Step13.intCoeff_of_neg (H : PowerSeries ℤ) {j : ℤ} (h : j < 0) : DurfeeCCS.Step13.intCoeff H j = 0
STEP13_DECL_KIND DurfeeCCS.Step13.nearOrigin_angular_means_zero theorem DurfeeCCS.Step13.NearOriginAudit
DurfeeCCS.Step13.nearOrigin_angular_means_zero {r : ℝ} (hr : |r| ≤ 1) {ζ : ℂ} (hζ : 0 < ζ.re) :
  (DurfeeCCS.Step08.angularAverage fun θ => DurfeeCCS.Step08.pairedLog r θ ζ) = 0 ∧
    (DurfeeCCS.Step08.angularAverage fun θ => DurfeeCCS.Step08.nearOriginMainLog r θ ζ) = 0 ∧
      (DurfeeCCS.Step08.angularAverage fun θ => DurfeeCCS.Step08.nearOriginCorrection r θ ζ) = 0
STEP13_DECL_KIND DurfeeCCS.Step13.nearOrigin_log_errors theorem DurfeeCCS.Step13.NearOriginAudit
DurfeeCCS.Step13.nearOrigin_log_errors {r u v : ℝ} (hu : 0 < u) (hur : u ≤ r) (hr : r ≤ 1 / 40) (hv : |v| ≤ Real.pi)
  (θ : ℝ) :
  have ζ := DurfeeCCS.Step08.verticalPoint u v;
  have Δ := r ^ 2 / u;
  have S := 2 / u * ∑' (m : ℕ), r ^ (m + 2) / ↑(m + 2) ^ 2;
  ‖DurfeeCCS.Step08.nearOriginFirstRemainder r θ ζ‖ ≤ 0.16 * r * ‖ζ‖ * |Real.cos θ| ∧
    ‖DurfeeCCS.Step08.nearOriginTailRemainder r θ ζ‖ ≤ S ∧
      S ≤ r ^ 2 / (2 * u * (1 - r)) ∧
        r ^ 2 / (2 * u * (1 - r)) < 0.513 * Δ ∧
          ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step08.nearOriginMainLog r θ ζ‖ < 1.02 * Δ
STEP13_DECL_KIND DurfeeCCS.Step13.nearOrigin_middle_error_paper theorem DurfeeCCS.Step13.NearOriginAudit
DurfeeCCS.Step13.nearOrigin_middle_error_paper {r u : ℝ} (hu : 0 < u) (hur : u ≤ r) (hr : r ≤ 1 / 40)
  (hΔ : r ^ 2 / u ≤ 1) :
  have σ := r / u;
  have Δ := r ^ 2 / u;
  Real.exp σ / (2 * Real.pi) *
      ∫ (v : ℝ) in {v | 4 * u < |v| ∧ |v| ≤ Real.pi}, ‖DurfeeCCS.Step08.nearOriginMiddleError r u v‖ <
    Real.exp (3 * σ / 2 + 1.02 * Δ) * (0.48 * r ^ 2 + 0.36 * (r ^ 3 / u))
STEP13_DECL_KIND DurfeeCCS.Step13.nearOrigin_parseval_bounds theorem DurfeeCCS.Step13.NearOriginAudit
DurfeeCCS.Step13.nearOrigin_parseval_bounds {r u : ℝ} (hu : 0 < u) (hur : u ≤ r) (hr : r ≤ 1 / 40) :
  (DurfeeCCS.Step08.angularMean fun v =>
        DurfeeCCS.Step08.angularMean fun θ =>
          ‖DurfeeCCS.Step08.nearOriginMainLog r θ (DurfeeCCS.Step08.verticalPoint u v)‖ ^ 2) ≤
      r ^ 2 / u ∧
    √(DurfeeCCS.Step08.angularMean fun v =>
            DurfeeCCS.Step08.angularMean fun θ =>
              ‖DurfeeCCS.Step08.nearOriginFirstRemainder r θ (DurfeeCCS.Step08.verticalPoint u v)‖ ^ 2) <
        0.206 * r ∧
      (DurfeeCCS.Step08.angularMean fun v =>
          DurfeeCCS.Step08.angularMean fun θ =>
            ‖DurfeeCCS.Step08.nearOriginTailRemainder r θ (DurfeeCCS.Step08.verticalPoint u v)‖ ^ 2) <
        (0.354 * r ^ 2) ^ 2 / u
STEP13_DECL_KIND DurfeeCCS.Step13.nearOrigin_sinh_parseval theorem DurfeeCCS.Step13.NearOriginAudit
DurfeeCCS.Step13.nearOrigin_sinh_parseval {u : ℝ} (hu : 0 < u) {k : ℕ} (hk : 0 < k) :
  (DurfeeCCS.Step08.angularMean fun v => (‖2 * Complex.sinh (↑k * DurfeeCCS.Step08.verticalPoint u v / 2)‖ ^ 2)⁻¹) =
      (2 * Real.sinh (↑k * u))⁻¹ ∧
    (2 * Real.sinh (↑k * u))⁻¹ ≤ (2 * ↑k * u)⁻¹
STEP13_DECL_KIND DurfeeCCS.Step13.nearOrigin_smallArc_bounds theorem DurfeeCCS.Step13.NearOriginAudit
DurfeeCCS.Step13.nearOrigin_smallArc_bounds {r u v : ℝ} (hu : 0 < u) (hur : u ≤ r) (hr : r ≤ 1 / 40) (hv : |v| ≤ 4 * u)
  (θ : ℝ) :
  have ζ := DurfeeCCS.Step08.verticalPoint u v;
  ‖ζ‖ ≤ √17 * u ∧
    √17 * u < 0.104 ∧
      ‖(2 * Complex.sinh ζ)⁻¹ - (2 * ζ)⁻¹‖ < 84e-3 * ‖ζ‖ ∧
        ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step08.nearOriginMainLog r θ ζ -
                DurfeeCCS.Step08.nearOriginCorrection r θ ζ‖ ≤
            0.66 * r * u + 0.228 * r * (r ^ 2 / u) + 0.35 * r ^ 2 * u ∧
          ‖DurfeeCCS.Step08.nearOriginCorrection r θ ζ‖ ≤ r ^ 2 / u / 2
STEP13_DECL_KIND DurfeeCCS.Step13.p_eq_intCoeff_restrictedPair theorem DurfeeCCS.Step13.Conventions
DurfeeCCS.Step13.p_eq_intCoeff_restrictedPair (n d : ℕ) :
  ↑(DurfeeCCS.p n d) = DurfeeCCS.Step13.intCoeff (DurfeeCCS.restrictedPairSeries d) (↑n - ↑d ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step13.saddleG_formula theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddleG_formula (r θ : ℝ) :
  DurfeeCCS.Step06.saddleG r θ =
    -DurfeeCCS.Step06.principalDilog (-↑r * Complex.I * Complex.exp (↑θ * Complex.I)) -
      DurfeeCCS.Step06.principalDilog (-↑r * Complex.I * Complex.exp (-↑θ * Complex.I))
STEP13_DECL_KIND DurfeeCCS.Step13.saddle_alternating_series_bounds theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddle_alternating_series_bounds {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  3 * r ^ 2 / 8 ≤ (DurfeeCCS.Step06.saddleS r ^ 2).re ∧
    (DurfeeCCS.Step06.saddleS r ^ 2).re ≤ r ^ 2 / 2 ∧
      r * (1 - r ^ 2 / 9) ≤ (DurfeeCCS.Step06.saddleS r ^ 2).im / 2 ∧ (DurfeeCCS.Step06.saddleS r ^ 2).im / 2 ≤ r
STEP13_DECL_KIND DurfeeCCS.Step13.saddle_amplitude_phase_formulas theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddle_amplitude_phase_formulas (n : ℕ) (r : ℝ) :
  DurfeeCCS.Step06.saddleAmplitude n r =
      ‖DurfeeCCS.Step06.saddleS r‖ * (1 + r ^ 2) ^ (1 / 4) * Real.exp (2 * (DurfeeCCS.Step06.saddleS r).re * √↑n) /
        (2 * Real.pi * ↑n * √r) ∧
    DurfeeCCS.Step06.saddlePhase n r =
      2 * (DurfeeCCS.Step06.saddleS r).im * √↑n + (DurfeeCCS.Step06.saddleS r).arg - Real.pi / 4 + Real.arctan r / 2
STEP13_DECL_KIND DurfeeCCS.Step13.saddle_bessel_prefactor_ratio theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddle_bessel_prefactor_ratio {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  have ratio := √(2 * r * √↑n / (Real.pi * ‖DurfeeCCS.Step06.saddleS r‖ * √(1 + r ^ 2)));
  ‖DurfeeCCS.Step08.saddleBesselPrefactor n r‖ / DurfeeCCS.Step06.saddleAmplitude n r = ratio ∧
    ratio ≤ √(1.5 * DurfeeCCS.Step08.saddleOmega n r / Real.pi)
STEP13_DECL_KIND DurfeeCCS.Step13.saddle_central_kernel_model theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddle_central_kernel_model {n : ℕ} (hn : 0 < n) {r : ℝ} {p : ℂ}
  (hs : 0 < (DurfeeCCS.Step06.saddleS r).re) (hp : 0 < p.re) (hq : 0 < (p / DurfeeCCS.Step06.saddleS r).re) :
  ↑√2 * ((↑Real.pi)⁻¹ * (p / ↑√↑n) * (Complex.exp (2 * ↑√↑n * p) / (2 * ↑Real.pi * (2 * ↑√↑n * p)).sqrt)) =
    DurfeeCCS.Step08.saddleBesselPrefactor n r * (p / DurfeeCCS.Step06.saddleS r).sqrt *
      Complex.exp (2 * ↑√↑n * (p - DurfeeCCS.Step06.saddleS r))
STEP13_DECL_KIND DurfeeCCS.Step13.saddle_square_half_im_hasSum theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddle_square_half_im_hasSum {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  HasSum (fun j => (-1) ^ j * r ^ (2 * j + 1) / ↑(2 * j + 1) ^ 2) ((DurfeeCCS.Step06.saddleS r ^ 2).im / 2)
STEP13_DECL_KIND DurfeeCCS.Step13.saddle_square_re_hasSum theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.saddle_square_re_hasSum {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  HasSum (fun k => 2 * (-1) ^ k * r ^ (2 * (k + 1)) / ↑(2 * (k + 1)) ^ 2) (DurfeeCCS.Step06.saddleS r ^ 2).re
STEP13_DECL_KIND DurfeeCCS.Step13.sign_at_integral_phase theorem DurfeeCCS.Step13.SaddleAudit
DurfeeCCS.Step13.sign_at_integral_phase {n : ℕ} {k : ℤ} {r : ℝ} (hn : 6400 ≤ n) (hmin : 16 * Real.pi ^ 2 / ↑n ≤ r)
  (hmax : r ≤ Real.exp 1 * √↑n) (hphase : DurfeeCCS.Step06.saddlePhase n r = ↑k * Real.pi) :
  (DurfeeCCS.Step08.durfeeNegativeValue n r).sign = (-1) ^ k
STEP13_DECL_KIND DurfeeCCS.Step13.twoColourEuler_log theorem DurfeeCCS.Step13.EulerRearrangement
DurfeeCCS.Step13.twoColourEuler_log {u : ℝ} (hu : 0 < u) :
  have P := ∏' (ν : ℕ), (1 - Real.exp (-(↑ν + 1) * u))⁻¹ ^ 2;
  have L := fun k => 1 / ((↑k + 1) * (Real.exp ((↑k + 1) * u) - 1));
  0 < P ∧ Summable L ∧ Real.log P = 2 * ∑' (k : ℕ), L k ∧ Real.log P ≤ Real.pi ^ 2 / (3 * u)
STEP13_DECL_KIND DurfeeCCS.Step13.twoColour_exp_bound_param theorem DurfeeCCS.Step13.EulerRearrangement
DurfeeCCS.Step13.twoColour_exp_bound_param (t : ℕ) {u : ℝ} (hu : 0 < u) :
  ↑(DurfeeCCS.Step06.twoColourPartitionCount t) ≤ Real.exp (u * ↑t + Real.pi ^ 2 / (3 * u))
STEP13_DECL_KIND DurfeeCCS.Step14.arg_neg_axis_rotation theorem DurfeeCCS.Step14.Hankel
DurfeeCCS.Step14.arg_neg_axis_rotation {x : ℝ} (hx : 0 < x) : (-↑x * Complex.I).arg = -(Real.pi / 2)
STEP13_DECL_KIND DurfeeCCS.Step14.bromwichLeftSemicircle_endpoints theorem DurfeeCCS.Step14.Bromwich
DurfeeCCS.Step14.bromwichLeftSemicircle_endpoints (u R : ℝ) :
  circleMap (↑u) R (Real.pi / 2) = DurfeeCCS.Step08.verticalPoint u R ∧
    circleMap (↑u) R (Real.pi + Real.pi / 2) = DurfeeCCS.Step08.verticalPoint u (-R)
STEP13_DECL_KIND DurfeeCCS.Step14.dedekindSum_reciprocity theorem DurfeeCCS.Step14.RademacherDedekind
DurfeeCCS.Step14.dedekindSum_reciprocity {a b : ℕ} (ha : 0 < a) (hb : 0 < b) (hab : a.Coprime b) :
  DurfeeCCS.Step06.dedekindSum (↑a) b + DurfeeCCS.Step06.dedekindSum (↑b) a =
    -1 / 4 + (↑a / ↑b + ↑b / ↑a + 1 / (↑a * ↑b)) / 12
STEP13_DECL_KIND DurfeeCCS.Step14.eta_square_smul_dedekind theorem DurfeeCCS.Step14.RademacherMultiplier
DurfeeCCS.Step14.eta_square_smul_dedekind (γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hc : 0 < ↑γ 1 0)
  (τ : UpperHalfPlane) :
  ModularForm.eta ↑(γ • τ) ^ 2 =
    Complex.exp
        (↑(2 * Real.pi *
              ((↑(↑γ 0 0) + ↑(↑γ 1 1)) / (12 * ↑(↑γ 1 0)) - DurfeeCCS.Step06.dedekindSum (↑γ 1 1) (↑γ 1 0).toNat -
                1 / 4)) *
          Complex.I) *
      (UpperHalfPlane.denom (Matrix.SpecialLinearGroup.toGL ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ)) γ))
          ↑τ *
        ModularForm.eta ↑τ ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step14.fareyChain_adjacent theorem DurfeeCCS.Step14.RademacherFareyChain
DurfeeCCS.Step14.fareyChain_adjacent {N i : ℕ} (hN : 0 < N) (hi : i + 1 < (DurfeeCCS.Step14.fareyChain N).length) :
  have r := (DurfeeCCS.Step14.fareyChain N)[i];
  have s := (DurfeeCCS.Step14.fareyChain N)[i + 1];
  ↑r.den * s.num - r.num * ↑s.den = 1 ∧ N < r.den + s.den
STEP13_DECL_KIND DurfeeCCS.Step14.hankelFirstKindVertical_eq_laplaceContour theorem DurfeeCCS.Step14.Hankel
DurfeeCCS.Step14.hankelFirstKindVertical_eq_laplaceContour (ν : ℕ) (hν : ν = 0 ∨ ν = 1) (x : ℝ) :
  DurfeeCCS.Step14.hankelFirstKindVertical ν x =
    ↑(2 * (x / 2) ^ ν / (√Real.pi * Real.Gamma (↑ν + 1 / 2))) *
      (-Complex.I *
        ∫ (y : ℝ) in Set.Ioi 0, (1 + (Complex.I - ↑y) ^ 2) ^ (↑ν - 1 / 2) * Complex.exp (↑x * (Complex.I - ↑y)))
STEP13_DECL_KIND DurfeeCCS.Step14.hankelFirstKindVertical_nemes theorem DurfeeCCS.Step14.Hankel
DurfeeCCS.Step14.hankelFirstKindVertical_nemes (ν : ℕ) (hν : ν = 0 ∨ ν = 1) {x : ℝ} (hx : 0 < x) :
  DurfeeCCS.Step14.hankelFirstKindVertical ν x =
    ↑√(2 / (Real.pi * x)) * Complex.exp (↑(DurfeeCCS.Step06.besselPhase ν x) * Complex.I) *
      (1 + DurfeeCCS.Step14.nemesKFirstRemainder ν (-↑x * Complex.I))
STEP13_DECL_KIND DurfeeCCS.Step14.hankelFirstKindVertical_re_eq_besselJ theorem DurfeeCCS.Step14.Hankel
DurfeeCCS.Step14.hankelFirstKindVertical_re_eq_besselJ (ν : ℕ) (hν : ν = 0 ∨ ν = 1) {x : ℝ} (hx : 0 < x) :
  (DurfeeCCS.Step14.hankelFirstKindVertical ν x).re = (DurfeeCCS.Step06.besselJ ν ↑x).re
STEP13_DECL_KIND DurfeeCCS.Step14.integral_fordCoefficientIntegrand_split theorem DurfeeCCS.Step14.RademacherCuspSplit
DurfeeCCS.Step14.integral_fordCoefficientIntegrand_split {n h k : ℕ} (hn : 0 < n) (hk : 0 < k) (hg : h.Coprime k) :
  ∃ a,
    ∀ (l r : ℝ),
      ∫ (v : ℝ) in l..r, DurfeeCCS.Step14.fordCoefficientIntegrand n h k v =
        DurfeeCCS.Step06.twoColourPhase n h k *
          ((∫ (v : ℝ) in l..r, DurfeeCCS.Step14.fordPolarIntegrand n k v) +
            (∫ (v : ℝ) in l..r,
                DurfeeCCS.Step14.fordNonpolarKernel (2 * Real.pi * ↑a / ↑k) (DurfeeCCS.Step14.fordPolarB n k)
                  (DurfeeCCS.Step08.verticalPoint 1 v)) /
              ↑k ^ 3)
STEP13_DECL_KIND DurfeeCCS.Step14.integral_fordNonpolarKernel_eq_zero theorem DurfeeCCS.Step14.RademacherNonpolar
DurfeeCCS.Step14.integral_fordNonpolarKernel_eq_zero (phase b : ℝ) :
  ∫ (v : ℝ), DurfeeCCS.Step14.fordNonpolarKernel phase b (DurfeeCCS.Step08.verticalPoint 1 v) = 0
STEP13_DECL_KIND DurfeeCCS.Step14.integral_fordPolarIntegrand theorem DurfeeCCS.Step14.RademacherPolarCompletion
DurfeeCCS.Step14.integral_fordPolarIntegrand {n k : ℕ} (hn : 0 < n) (hk : 0 < k) :
  ∫ (v : ℝ), DurfeeCCS.Step14.fordPolarIntegrand n k v =
    ↑(2 * Real.pi / (12 * ↑n - 1)) / ↑k * DurfeeCCS.Step06.besselI 2 ↑(DurfeeCCS.Step06.twoColourBesselScale n / ↑k)
STEP13_DECL_KIND DurfeeCCS.Step14.norm_bromwichLeftSemicircle_le theorem DurfeeCCS.Step14.Bromwich
DurfeeCCS.Step14.norm_bromwichLeftSemicircle_le {u x R : ℝ} (hu : 0 ≤ u) (hx : 0 ≤ x) (hR : u < R) (j : ℕ) :
  ‖DurfeeCCS.Step14.bromwichLeftSemicircle u x R j‖ ≤ Real.pi * R * Real.exp (x * u) * ((R - u) ^ j)⁻¹
STEP13_DECL_KIND DurfeeCCS.Step14.norm_fordPolar_truncation_le theorem DurfeeCCS.Step14.RademacherPolarCompletion
DurfeeCCS.Step14.norm_fordPolar_truncation_le {n k N : ℕ} (hn : 0 < n) (hk : 0 < k) (hN : 0 < N) {left right : ℝ}
  (hl : 0 ≤ left) (hr : 0 ≤ right) (hlN : ↑N ≤ ↑k * (left + 1)) (hrN : ↑N ≤ ↑k * (right + 1)) :
  ‖(∫ (v : ℝ) in -left..right, DurfeeCCS.Step14.fordPolarIntegrand n k v) -
        ∫ (v : ℝ), DurfeeCCS.Step14.fordPolarIntegrand n k v‖ ≤
    8 * Real.exp (Real.pi / 6 + 2 * Real.pi * ↑n) / (↑k * ↑N ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step14.norm_nemesKFirstRemainder_neg_mul_I_le theorem DurfeeCCS.Step14.Hankel
DurfeeCCS.Step14.norm_nemesKFirstRemainder_neg_mul_I_le (ν : ℕ) (hν : ν = 0 ∨ ν = 1) {x : ℝ} (hx : 0 < x) :
  ‖DurfeeCCS.Step14.nemesKFirstRemainder ν (-↑x * Complex.I)‖ ≤ |4 * ↑ν ^ 2 - 1| / (8 * x)
STEP13_DECL_KIND DurfeeCCS.Step14.norm_weighted_fordNonpolar_segment_le theorem DurfeeCCS.Step14.RademacherNonpolar
DurfeeCCS.Step14.norm_weighted_fordNonpolar_segment_le (phase b : ℝ) {ω : ℂ} (hω : ‖ω‖ ≤ 1) {N k l r : ℝ} (hN : 0 < N)
  (hk : 0 < k) (hl : 0 ≤ l) (hr : 0 ≤ r) (hNl : N ≤ k + l) (hNr : N ≤ k + r) :
  ‖ω / ↑k ^ 3 *
        ∫ (v : ℝ) in -(l / k)..r / k,
          DurfeeCCS.Step14.fordNonpolarKernel phase b (DurfeeCCS.Step08.verticalPoint 1 v)‖ ≤
    4 * Real.exp (Real.pi + |b|) / (k * N ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step14.partition_card_pentagonal_recurrence theorem DurfeeCCS.Step14.Pentagonal
DurfeeCCS.Step14.partition_card_pentagonal_recurrence {n : ℕ} (hn : 0 < n) :
  ↑(Fintype.card n.Partition) =
    ∑ j ∈ Finset.range n,
      (-1) ^ j *
        ((if pentagonal (↑j + 1) ≤ n then ↑(Fintype.card (n - pentagonal (↑j + 1)).Partition) else 0) +
          if pentagonal (-(↑j + 1)) ≤ n then ↑(Fintype.card (n - pentagonal (-(↑j + 1))).Partition) else 0)
STEP13_DECL_KIND DurfeeCCS.Step14.partition_card_zero theorem DurfeeCCS.Step14.Pentagonal
DurfeeCCS.Step14.partition_card_zero : Fintype.card (Nat.Partition 0) = 1
STEP13_DECL_KIND DurfeeCCS.Step14.pentagonalKernel_mul_ordinaryPartitionSeries theorem DurfeeCCS.Step14.Pentagonal
DurfeeCCS.Step14.pentagonalKernel_mul_ordinaryPartitionSeries :
  DurfeeCCS.Step14.pentagonalKernel * DurfeeCCS.Step06.ordinaryPartitionSeries = 1
STEP13_DECL_KIND DurfeeCCS.Step14.sum_fareyChain_dropLast theorem DurfeeCCS.Step14.RademacherFareyChain
DurfeeCCS.Step14.sum_fareyChain_dropLast.{u_1} {A : Type u_1} [AddCommMonoid A] {N : ℕ} (hN : 0 < N) (f : ℤ → ℕ → A) :
  ∑ r ∈ (DurfeeCCS.Step14.fareyChain N).dropLast.toFinset, f r.num r.den =
    ∑ k ∈ Finset.Icc 1 N, ∑ h ∈ Finset.range k with h.Coprime k, f (↑h) k
STEP13_DECL_KIND DurfeeCCS.Step14.sum_fareyChain_initial_by_den theorem DurfeeCCS.Step14.RademacherIndexing
DurfeeCCS.Step14.sum_fareyChain_initial_by_den.{u_1} {M : Type u_1} [AddCommMonoid M] {N : ℕ} (hN : 0 < N) (g : ℕ → M) :
  ∑ j ∈ Finset.range ((DurfeeCCS.Step14.fareyChain N).length - 1), g j =
    ∑ k ∈ Finset.Icc 1 N,
      ∑ h ∈ Finset.range k with h.Coprime k, g (List.idxOf (↑h / ↑k) (DurfeeCCS.Step14.fareyChain N))
STEP13_DECL_KIND DurfeeCCS.Step14.tendsto_bromwichClosedContour theorem DurfeeCCS.Step14.Bromwich
DurfeeCCS.Step14.tendsto_bromwichClosedContour {u x : ℝ} (hu : 0 < u) (hx : 0 < x) {j : ℕ} (hj : 2 ≤ j) :
  Filter.Tendsto
    (fun R =>
      (Complex.I *
          ∫ (v : ℝ) in -R..R,
            Complex.exp (↑x * DurfeeCCS.Step08.verticalPoint u v) / DurfeeCCS.Step08.verticalPoint u v ^ j) +
        DurfeeCCS.Step14.bromwichLeftSemicircle u x R j)
    Filter.atTop (nhds (↑(2 * Real.pi) * Complex.I * (↑x ^ (j - 1) / ↑(j - 1).factorial)))
STEP13_DECL_KIND DurfeeCCS.Step14.tendsto_bromwichLeftSemicircle_bound_zero theorem DurfeeCCS.Step14.Bromwich
DurfeeCCS.Step14.tendsto_bromwichLeftSemicircle_bound_zero (u x : ℝ) {j : ℕ} (hj : 2 ≤ j) :
  Filter.Tendsto (fun R => Real.pi * R * Real.exp (x * u) * ((R - u) ^ j)⁻¹) Filter.atTop (nhds 0)
STEP13_DECL_KIND DurfeeCCS.Step14.tendsto_bromwichLeftSemicircle_zero theorem DurfeeCCS.Step14.Bromwich
DurfeeCCS.Step14.tendsto_bromwichLeftSemicircle_zero {u x : ℝ} (hu : 0 ≤ u) (hx : 0 ≤ x) {j : ℕ} (hj : 2 ≤ j) :
  Filter.Tendsto (fun R => DurfeeCCS.Step14.bromwichLeftSemicircle u x R j) Filter.atTop (nhds 0)
STEP13_DECL_KIND DurfeeCCS.Step14.theta38_tail_summands_strictAntiOn theorem DurfeeCCS.Step14.TailMonotonicity
DurfeeCCS.Step14.theta38_tail_summands_strictAntiOn :
  StrictAntiOn
      (fun x =>
        √(DurfeeCCS.Step07.theta38Growth x * x) * Real.exp (-1.48481 ^ 2 * x / DurfeeCCS.Step07.theta38Growth x))
      (Set.Ici 80) ∧
    StrictAntiOn
      (fun x => √(DurfeeCCS.Step07.theta38Growth x * x) * Real.exp (-DurfeeCCS.Step07.theta38TailD * (x / 80)))
      (Set.Ici 80)
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourCoefficient_inverse_cusp_dedekind theorem DurfeeCCS.Step14.RademacherMultiplier
DurfeeCCS.Step14.twoColourCoefficient_inverse_cusp_dedekind (n : ℕ) {h k : ℕ} (hk : 0 < k) (hg : h.Coprime k) :
  ∃ a,
    ∀ {w : ℂ},
      0 < w.re →
        have τ := ↑h / ↑k + Complex.I / (↑k ^ 2 * w);
        Complex.exp (-(2 * ↑Real.pi * Complex.I * ↑n * τ)) *
              DurfeeCCS.Step06.twoColourGenerating (Complex.exp (2 * ↑Real.pi * Complex.I * τ)) /
            (↑k ^ 2 * w ^ 2) =
          DurfeeCCS.Step06.twoColourPhase n h k *
              (DurfeeCCS.Step06.rademacherPolarKernel (Real.pi / 6) (2 * Real.pi * (↑n - 1 / 12) / ↑k ^ 2) w / ↑k ^ 3) *
            DurfeeCCS.Step06.twoColourGenerating (Complex.exp (2 * ↑Real.pi * Complex.I * (↑a / ↑k + Complex.I * w)))
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourGenerating_inverse_cusp_dedekind theorem DurfeeCCS.Step14.RademacherMultiplier
DurfeeCCS.Step14.twoColourGenerating_inverse_cusp_dedekind {h k : ℕ} (hk : 0 < k) (hg : h.Coprime k) :
  ∃ a,
    ∀ {w : ℂ},
      0 < w.re →
        DurfeeCCS.Step06.twoColourGenerating
            (Complex.exp (2 * ↑Real.pi * Complex.I * (↑h / ↑k + Complex.I / (↑k ^ 2 * w)))) =
          Complex.exp (↑(2 * Real.pi * DurfeeCCS.Step06.dedekindSum (↑h) k) * Complex.I) * (1 / (↑k * w)) *
              Complex.exp (↑Real.pi * w / 6 - ↑Real.pi / (6 * ↑k ^ 2 * w)) *
            DurfeeCCS.Step06.twoColourGenerating (Complex.exp (2 * ↑Real.pi * Complex.I * (↑a / ↑k + Complex.I * w)))
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourPartitionCount_eq_fareyChain_arc_sum theorem DurfeeCCS.Step14.RademacherChainContour
DurfeeCCS.Step14.twoColourPartitionCount_eq_fareyChain_arc_sum (n : ℕ) {N : ℕ} (hN : 0 < N) :
  have L := DurfeeCCS.Step14.fareyChain N;
  have m := L.length - 1;
  have v := fun j => L.getD j 0;
  ∃ left right,
    (∀ j < m, 0 ≤ left j ∧ 0 ≤ right j ∧ ↑N ≤ ↑(v j).den * (left j + 1) ∧ ↑N ≤ ↑(v j).den * (right j + 1)) ∧
      ↑(DurfeeCCS.Step06.twoColourPartitionCount n) =
        ∑ j ∈ Finset.range m,
          ∫ (t : ℝ) in -left j..right j, DurfeeCCS.Step14.fordPathIntegrand n (v j).num (↑(v j).den) t
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourPartitionCount_eq_ford_residue_sum theorem DurfeeCCS.Step14.RademacherIdentity
DurfeeCCS.Step14.twoColourPartitionCount_eq_ford_residue_sum (n : ℕ) {N : ℕ} (hN : 0 < N) :
  ∃ left right,
    (∀ k ∈ Finset.Icc 1 N,
        ∀ h ∈ {h ∈ Finset.range k | h.Coprime k},
          0 ≤ left h k ∧ 0 ≤ right h k ∧ ↑N ≤ ↑k * (left h k + 1) ∧ ↑N ≤ ↑k * (right h k + 1)) ∧
      ↑(DurfeeCCS.Step06.twoColourPartitionCount n) =
        ∑ k ∈ Finset.Icc 1 N,
          ∑ h ∈ Finset.range k with h.Coprime k,
            ∫ (v : ℝ) in -left h k..right h k, DurfeeCCS.Step14.fordCoefficientIntegrand n h k v
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourPartitionCount_eq_rademacherRHS theorem DurfeeCCS.Step14.RademacherIdentity
DurfeeCCS.Step14.twoColourPartitionCount_eq_rademacherRHS {n : ℕ} (hn : 0 < n) :
  ↑(DurfeeCCS.Step06.twoColourPartitionCount n) = DurfeeCCS.Step06.twoColourRademacherRHS n
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourRademacherIdentity_of_ford_integrals theorem DurfeeCCS.Step14.RademacherAssembly
DurfeeCCS.Step14.twoColourRademacherIdentity_of_ford_integrals
  (decompose :
    ∀ (n N : ℕ),
      0 < n →
        0 < N →
          ∃ left right,
            (∀ k ∈ Finset.Icc 1 N,
                ∀ h ∈ {h ∈ Finset.range k | h.Coprime k},
                  0 ≤ left h k ∧ 0 ≤ right h k ∧ ↑N ≤ ↑k * (left h k + 1) ∧ ↑N ≤ ↑k * (right h k + 1)) ∧
              ↑(DurfeeCCS.Step06.twoColourPartitionCount n) =
                ∑ k ∈ Finset.Icc 1 N,
                  ∑ h ∈ Finset.range k with h.Coprime k,
                    ∫ (v : ℝ) in -left h k..right h k, DurfeeCCS.Step14.fordCoefficientIntegrand n h k v) :
  DurfeeCCS.Step06.TwoColourRademacherIdentity
STEP13_DECL_KIND DurfeeCCS.Step14.twoColourRademacherIdentity_of_truncated_error theorem DurfeeCCS.Step14.RademacherPolarCompletion
DurfeeCCS.Step14.twoColourRademacherIdentity_of_truncated_error
  (h :
    ∀ (n : ℕ),
      0 < n →
        ∃ C,
          ∀ (N : ℕ),
            0 < N →
              ‖↑(DurfeeCCS.Step06.twoColourPartitionCount n) -
                    ↑(2 * Real.pi / (12 * ↑n - 1)) *
                      ∑ k ∈ Finset.range N, DurfeeCCS.Step06.twoColourRademacherTerm n (k + 1)‖ ≤
                C / ↑N) :
  DurfeeCCS.Step06.TwoColourRademacherIdentity
STEP13_DECL_KIND DurfeeCCS.Step14.twoColour_partition_rademacher theorem DurfeeCCS.Step14.RademacherIdentity
DurfeeCCS.Step14.twoColour_partition_rademacher : DurfeeCCS.Step06.TwoColourRademacherIdentity
STEP13_DECL_KIND DurfeeCCS.checkCertificate_sound theorem DurfeeCCS.CertificateCheck
DurfeeCCS.checkCertificate_sound {coeffs : List ℤ} {points : List (ℕ × ℕ)}
  (h : DurfeeCCS.checkCertificate coeffs points = Bool.true) :
  (∀ (i : Fin points.length), 0 < DurfeeCCS.dyadicValue (points.get i)) ∧
    (StrictMono fun i => DurfeeCCS.dyadicValue (points.get i)) ∧
      ∀ (i : Fin points.length),
        0 < (-1) ^ (↑i + 1) * DurfeeCCS.evalAscending coeffs (-DurfeeCCS.dyadicValue (points.get i))
STEP13_DECL_KIND DurfeeCCS.checkCoefficientBlock_sound theorem DurfeeCCS.CoefficientCertificate
DurfeeCCS.checkCoefficientBlock_sound {lo : ℕ} {columns rows : List (List ℤ)}
  (hlen : ∀ c ∈ columns, c.length = rows.length)
  (hcolumns : ∀ (j : ℕ) (hj : j < columns.length), ∀ i < rows.length, columns[j][i]! = ↑(DurfeeCCS.p (lo + i) (j + 1)))
  (h : DurfeeCCS.checkCoefficientBlock lo columns rows = Bool.true) (i : Fin rows.length) :
  rows[↑i] = List.ofFn fun j => ↑(DurfeeCCS.p (lo + ↑i) (↑j + 1))
STEP13_DECL_KIND DurfeeCCS.coeff_restrictedPairSeries_eq_count theorem DurfeeCCS.GeneratingFunction
DurfeeCCS.coeff_restrictedPairSeries_eq_count (d n : ℕ) :
  (PowerSeries.coeff n) (DurfeeCCS.restrictedPairSeries d) =
    ∑ ab ∈ Finset.HasAntidiagonal.antidiagonal n,
      DurfeeCCS.restrictedPartitionCount d ab.1 * DurfeeCCS.restrictedPartitionCount d ab.2
STEP13_DECL_KIND DurfeeCCS.degree_and_zeroMultiplicity theorem DurfeeCCS.Degree
DurfeeCCS.degree_and_zeroMultiplicity {n : ℕ} (hn : 0 < n) :
  (∀ (d : ℕ), 1 ≤ d → d ≤ n.sqrt → 0 < DurfeeCCS.p n d) ∧
    DurfeeCCS.p n 1 = n ∧
      (DurfeeCCS.durfeePolynomial n).degree = ↑n.sqrt ∧ Polynomial.rootMultiplicity 0 (DurfeeCCS.durfeePolynomial n) = 1
STEP13_DECL_KIND DurfeeCCS.durfeeAnalyticF_eq_diagonal theorem DurfeeCCS.Step06.GeneratingAnalytic
DurfeeCCS.durfeeAnalyticF_eq_diagonal (x : ℂ) {q : ℂ} (hq : ‖q‖ < 1) :
  DurfeeCCS.durfeeAnalyticF x q = ∑' (d : ℕ), q ^ (d * d) * x ^ d * (DurfeeCCS.qPochhammer q q d)⁻¹ ^ 2
STEP13_DECL_KIND DurfeeCCS.durfeeDecompositionAtMostParts other DurfeeCCS.EquationOne
DurfeeCCS.durfeeDecompositionAtMostParts {n d : ℕ} (h : d * d ≤ n) :
  DurfeeCCS.DiagramFiber n d ≃
    (ab : ↥(Finset.HasAntidiagonal.antidiagonal (n - d * d))) × { A // A.parts.card ≤ d } × { B // B.parts.card ≤ d }
STEP13_DECL_KIND DurfeeCCS.durfeeDistribution_singleton theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.durfeeDistribution_singleton (n d : ℕ) :
  (DurfeeCCS.durfeeDistribution n) {d} = ↑(DurfeeCCS.p n d) / ↑(Fintype.card n.Partition)
STEP13_DECL_KIND DurfeeCCS.durfeeGeneratingSeries_eq_squares theorem DurfeeCCS.EquationOne
DurfeeCCS.durfeeGeneratingSeries_eq_squares :
  DurfeeCCS.durfeeGeneratingSeries =
    PowerSeries.mk fun n =>
      ∑ d ∈ Finset.range (n.sqrt + 1),
        (Polynomial.monomial d) ((PowerSeries.coeff n) (PowerSeries.X ^ (d * d) * DurfeeCCS.restrictedPairSeries d))
STEP13_DECL_KIND DurfeeCCS.durfeeLatticeMass_eq_uniform_probability theorem DurfeeCCS.Step12.LocalLimitDurfee
DurfeeCCS.durfeeLatticeMass_eq_uniform_probability (n : ℕ) (k : ℤ) :
  DurfeeCCS.durfeeLatticeMass n k = (DurfeeCCS.uniformPartitionMeasure n).real {P | ↑(DurfeeCCS.partitionSide P) = k}
STEP13_DECL_KIND DurfeeCCS.durfeePGF_eval_eq_div theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.durfeePGF_eval_eq_div (n : ℕ) (x : ℝ) :
  Polynomial.eval x (DurfeeCCS.durfeePGF n) =
    Polynomial.eval x (DurfeeCCS.durfeePolynomialReal n) / Polynomial.eval 1 (DurfeeCCS.durfeePolynomialReal n)
STEP13_DECL_KIND DurfeeCCS.durfeePGF_eval_eq_integral theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.durfeePGF_eval_eq_integral (n : ℕ) (x : ℝ) :
  Polynomial.eval x (DurfeeCCS.durfeePGF n) =
    ∫ (P : n.Partition), x ^ DurfeeCCS.partitionSide P ∂DurfeeCCS.uniformPartitionMeasure n
STEP13_DECL_KIND DurfeeCCS.durfeePGF_factorization theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.durfeePGF_factorization {n : ℕ} (r : Fin (n.sqrt - 1) ↪ ℝ) (hr : ∀ (i : Fin (n.sqrt - 1)), 0 < r i)
  (hfac :
    DurfeeCCS.durfeePolynomialReal n =
      Polynomial.C ↑(DurfeeCCS.p n n.sqrt) * Polynomial.X * ∏ i, (Polynomial.X + Polynomial.C (r i))) :
  DurfeeCCS.durfeePGF n =
    Polynomial.X *
      ∏ i,
        (Polynomial.C (1 - ↑(DurfeeCCS.durfeeRootProbability (r i) ⋯)) +
          Polynomial.C ↑(DurfeeCCS.durfeeRootProbability (r i) ⋯) * Polynomial.X)
STEP13_DECL_KIND DurfeeCCS.durfeePGF_of_sqrt_eq_one theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.durfeePGF_of_sqrt_eq_one {n : ℕ} (h : n.sqrt = 1) : DurfeeCCS.durfeePGF n = Polynomial.X
STEP13_DECL_KIND DurfeeCCS.durfeePolynomialReal_eval_one theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.durfeePolynomialReal_eval_one (n : ℕ) :
  Polynomial.eval 1 (DurfeeCCS.durfeePolynomialReal n) = ↑(Fintype.card n.Partition)
STEP13_DECL_KIND DurfeeCCS.durfeePolynomial_eq_sum_partitions theorem DurfeeCCS.PartitionForm
DurfeeCCS.durfeePolynomial_eq_sum_partitions (n : ℕ) :
  DurfeeCCS.durfeePolynomial n = ∑ P, Polynomial.X ^ DurfeeCCS.partitionSide P
STEP13_DECL_KIND DurfeeCCS.durfeePolynomial_eval_one_eq_card_partitions theorem DurfeeCCS.PartitionTotals
DurfeeCCS.durfeePolynomial_eval_one_eq_card_partitions (n : ℕ) :
  Polynomial.eval 1 (DurfeeCCS.durfeePolynomial n) = ↑(Fintype.card n.Partition)
STEP13_DECL_KIND DurfeeCCS.durfeeQuotient other DurfeeCCS.Quotient
DurfeeCCS.durfeeQuotient (n : ℕ) : Polynomial ℤ
STEP13_DECL_KIND DurfeeCCS.durfeeSide_bernoulli_mean_variance theorem DurfeeCCS.Step12.Probability
DurfeeCCS.durfeeSide_bernoulli_mean_variance (n : ℕ) (hn : 1 ≤ n) :
  ∃ r,
    ∃ (hr : ∀ (i : Fin (n.sqrt - 1)), 0 < r i),
      DurfeeCCS.durfeePolynomialReal n =
          Polynomial.C ↑(DurfeeCCS.p n n.sqrt) * Polynomial.X * ∏ i, (Polynomial.X + Polynomial.C (r i)) ∧
        have q := fun i => DurfeeCCS.durfeeRootProbability (r i) ⋯;
        ProbabilityTheory.iIndepFun DurfeeCCS.Step12.bernoulliCoordinate (DurfeeCCS.Step12.bernoulliProduct q) ∧
          (∀ (i : Fin (n.sqrt - 1)),
              ProbabilityTheory.HasLaw (DurfeeCCS.Step12.bernoulliCoordinate i)
                (ProbabilityTheory.bernoulliMeasure 1 0 (q i)) (DurfeeCCS.Step12.bernoulliProduct q)) ∧
            ProbabilityTheory.HasLaw DurfeeCCS.Step12.shiftedBernoulliCount (DurfeeCCS.durfeeDistribution n)
                (DurfeeCCS.Step12.bernoulliProduct q) ∧
              DurfeeCCS.durfeeMean n = 1 + ∑ i, 1 / (1 + r i) ∧ DurfeeCCS.durfeeVariance n = ∑ i, r i / (1 + r i) ^ 2
STEP13_DECL_KIND DurfeeCCS.durfeeSide_central_limit theorem DurfeeCCS.Step12.CentralLimitDurfee
DurfeeCCS.durfeeSide_central_limit (hV : Filter.Tendsto DurfeeCCS.durfeeVariance Filter.atTop Filter.atTop) :
  MeasureTheory.TendstoInDistribution (fun n P => DurfeeCCS.durfeeStandardized n (DurfeeCCS.partitionSide P))
    Filter.atTop id DurfeeCCS.uniformPartitionMeasure (ProbabilityTheory.gaussianReal 0 1)
STEP13_DECL_KIND DurfeeCCS.durfeeSide_local_limit theorem DurfeeCCS.Step12.LocalLimitDurfee
DurfeeCCS.durfeeSide_local_limit (hVar : Filter.Tendsto DurfeeCCS.durfeeVariance Filter.atTop Filter.atTop) :
  Filter.Tendsto
    (fun n =>
      ⨆ k,
        |√(DurfeeCCS.durfeeVariance n) * DurfeeCCS.durfeeLatticeMass n k -
            DurfeeCCS.standardNormalDensity ((↑k - DurfeeCCS.durfeeMean n) / √(DurfeeCCS.durfeeVariance n))|)
    Filter.atTop (nhds 0)
STEP13_DECL_KIND DurfeeCCS.durfeeSide_moments_of_sqrt_eq_one theorem DurfeeCCS.Step12.Probability
DurfeeCCS.durfeeSide_moments_of_sqrt_eq_one {n : ℕ} (h : n.sqrt = 1) :
  DurfeeCCS.durfeeMean n = 1 ∧ DurfeeCCS.durfeeVariance n = 0
STEP13_DECL_KIND DurfeeCCS.durfee_all_modes_near_mean theorem DurfeeCCS.Step12.ModeConsequences
DurfeeCCS.durfee_all_modes_near_mean {n d : ℕ} (hn : 1 ≤ n)
  (hmode : ∀ (j : ℕ), DurfeeCCS.durfeeMass n j ≤ DurfeeCCS.durfeeMass n d) : |↑d - DurfeeCCS.durfeeMean n| < 1
STEP13_DECL_KIND DurfeeCCS.durfee_all_modes_within_one theorem DurfeeCCS.Step12.ModeConsequences
DurfeeCCS.durfee_all_modes_within_one {n d : ℕ} (hn : 1 ≤ n)
  (hmode : ∀ (j : ℕ), DurfeeCCS.durfeeMass n j ≤ DurfeeCCS.durfeeMass n d) : |↑d - DurfeeCCS.durfeeMean n| ≤ 1
STEP13_DECL_KIND DurfeeCCS.durfee_complex_roots_exact theorem DurfeeCCS.Main
DurfeeCCS.durfee_complex_roots_exact (n : ℕ) (hn : 1 ≤ n) :
  ∃ r,
    (∀ (i : Fin (n.sqrt - 1)), r i < 0) ∧
      (DurfeeCCS.durfeePolynomialComplex n).roots.card = n.sqrt ∧
        (∀ (z : ℂ), (DurfeeCCS.durfeePolynomialComplex n).IsRoot z ↔ z = 0 ∨ ∃ i, z = ↑(r i)) ∧
          ∀ (z : ℂ),
            (DurfeeCCS.durfeePolynomialComplex n).IsRoot z →
              Polynomial.rootMultiplicity z (DurfeeCCS.durfeePolynomialComplex n) = 1
STEP13_DECL_KIND DurfeeCCS.durfee_factorization theorem DurfeeCCS.Main
DurfeeCCS.durfee_factorization (n : ℕ) (hn : 1 ≤ n) :
  ∃ r,
    (∀ (i : Fin (n.sqrt - 1)), 0 < r i) ∧
      DurfeeCCS.durfeePolynomialReal n =
        Polynomial.C ↑(DurfeeCCS.p n n.sqrt) * Polynomial.X * ∏ i, (Polynomial.X + Polynomial.C (r i))
STEP13_DECL_KIND DurfeeCCS.durfee_factorization_one theorem DurfeeCCS.Main
DurfeeCCS.durfee_factorization_one :
  DurfeeCCS.durfeePolynomialReal 1 =
    Polynomial.C ↑(DurfeeCCS.p 1 1) * Polynomial.X * ∏ i, (Polynomial.X + Polynomial.C i.elim0)
STEP13_DECL_KIND DurfeeCCS.durfee_negative_root_count theorem DurfeeCCS.Main
DurfeeCCS.durfee_negative_root_count (n : ℕ) (hn : 1 ≤ n) :
  Nat.card { x // x < 0 ∧ (DurfeeCCS.durfeePolynomialReal n).IsRoot x } = n.sqrt - 1
STEP13_DECL_KIND DurfeeCCS.durfee_newton_normalized theorem DurfeeCCS.Step12.Newton
DurfeeCCS.durfee_newton_normalized (n d : ℕ) (hn : 1 ≤ n) (hd : 1 < d) (hm : d < n.sqrt) :
  have m := n.sqrt - 1;
  ↑(DurfeeCCS.p n (d - 1)) / ↑(m.choose (d - 2)) * (↑(DurfeeCCS.p n (d + 1)) / ↑(m.choose d)) ≤
    (↑(DurfeeCCS.p n d) / ↑(m.choose (d - 1))) ^ 2
STEP13_DECL_KIND DurfeeCCS.durfee_simple_exact_negative_roots theorem DurfeeCCS.Main
DurfeeCCS.durfee_simple_exact_negative_roots (n : ℕ) (hn : 1 ≤ n) : DurfeeCCS.HasDurfeeRoots n
STEP13_DECL_KIND DurfeeCCS.durfee_strict_logConcave theorem DurfeeCCS.Step12.LogConcavity
DurfeeCCS.durfee_strict_logConcave (n d : ℕ) (hn : 1 ≤ n) (hd : 1 < d) (hm : d < n.sqrt) :
  DurfeeCCS.p n (d - 1) * DurfeeCCS.p n (d + 1) < DurfeeCCS.p n d ^ 2
STEP13_DECL_KIND DurfeeCCS.durfee_unimodal theorem DurfeeCCS.Step12.LogConcavity
DurfeeCCS.durfee_unimodal (n : ℕ) (hn : 1 ≤ n) :
  ∃ mode,
    1 ≤ mode ∧
      mode ≤ n.sqrt ∧ MonotoneOn (DurfeeCCS.p n) (Set.Icc 1 mode) ∧ AntitoneOn (DurfeeCCS.p n) (Set.Icc mode n.sqrt)
STEP13_DECL_KIND DurfeeCCS.dyadicHorner_represents theorem DurfeeCCS.CertificateCheck
DurfeeCCS.dyadicHorner_represents (coeffs : List ℤ) (u e : ℕ) :
  have r := DurfeeCCS.dyadicHorner coeffs u e;
  ↑r.1 - ↑r.2.1 = (DurfeeCCS.homogeneousHorner (-↑u) (↑(DurfeeCCS.dyadicDenominator (u, e))) coeffs).1 ∧
    r.2.2 = e * coeffs.length
STEP13_DECL_KIND DurfeeCCS.finiteWitnessBlock_of_checks theorem DurfeeCCS.FiniteCertificates
DurfeeCCS.finiteWitnessBlock_of_checks {columns : List (List ℤ)} {rows : List DurfeeCCS.FiniteWitnessRow} {lo limit : ℕ}
  (hlength : ∀ c ∈ columns, c.length = limit)
  (hcoeff : ∀ (j : ℕ) (hj : j < columns.length), DurfeeCCS.CoefficientRowSpec (j + 1) columns[j])
  (hbound : lo + rows.length ≤ limit)
  (hmatch :
    DurfeeCCS.checkCoefficientBlock lo (DurfeeCCS.coefficientSlices columns lo rows.length) (List.map Prod.fst rows) =
      Bool.true)
  (hsign : DurfeeCCS.checkFiniteWitnessBlock rows = Bool.true) (n : ℕ) :
  lo ≤ n → n < lo + rows.length → DurfeeCCS.HasDyadicFiniteWitnesses n
STEP13_DECL_KIND DurfeeCCS.hasDurfeeRoots_of_small theorem DurfeeCCS.FiniteRoots
DurfeeCCS.hasDurfeeRoots_of_small {n : ℕ} (hn : 0 < n) (hn' : n ≤ 8) : DurfeeCCS.HasDurfeeRoots n
STEP13_DECL_KIND DurfeeCCS.homogeneousHorner_eq theorem DurfeeCCS.CertificateCheck
DurfeeCCS.homogeneousHorner_eq (a b : ℤ) (cs : List ℤ) (hb : b ≠ 0) :
  ↑(DurfeeCCS.homogeneousHorner a b cs).1 = ↑b ^ (cs.length - 1) * DurfeeCCS.evalAscending cs (↑a / ↑b)
STEP13_DECL_KIND DurfeeCCS.ordinaryDurfee_allRootsReal theorem DurfeeCCS.Main
DurfeeCCS.ordinaryDurfee_allRootsReal (n : ℕ) (hn : 1 ≤ n) {z : ℂ}
  (hz : (DurfeeCCS.durfeePolynomialComplex n).IsRoot z) : ∃ x, z = ↑x
STEP13_DECL_KIND DurfeeCCS.partitionSide other DurfeeCCS.PartitionForm
DurfeeCCS.partitionSide {n : ℕ} (P : n.Partition) : ℕ
STEP13_DECL_KIND DurfeeCCS.qPochhammer other DurfeeCCS.Step06.GeneratingAnalytic
DurfeeCCS.qPochhammer (a q : ℂ) (d : ℕ) : ℂ
STEP13_DECL_KIND DurfeeCCS.quotientCoefficients_correct theorem DurfeeCCS.CoefficientDP
DurfeeCCS.quotientCoefficients_correct (length degree n m : ℕ) (hn : n < length) (hm : m ≤ degree) (hs : m ≤ n.sqrt) :
  DurfeeCCS.quotientCoefficients (DurfeeCCS.pairCoefficientRows length degree) n m =
    List.ofFn fun i => ↑(DurfeeCCS.p n (↑i + 1))
STEP13_DECL_KIND DurfeeCCS.rootProduct_all_modes_near_mean theorem DurfeeCCS.Step12.Mode
DurfeeCCS.rootProduct_all_modes_near_mean.{u_1} {ι : Type u_1} (s : Finset ι) (r : ι → ℝ) (hr : ∀ i ∈ s, 0 < r i)
  {k : ℕ} (hk : k ≤ s.card)
  (hmode :
    ∀ j ≤ s.card,
      (∏ i ∈ s, (Polynomial.X + Polynomial.C (r i))).coeff j ≤ (∏ i ∈ s, (Polynomial.X + Polynomial.C (r i))).coeff k) :
  |↑k - ∑ i ∈ s, 1 / (1 + r i)| < 1
STEP13_DECL_KIND DurfeeCCS.standardNormalDensity_eq_gaussianPDFReal theorem DurfeeCCS.Step12.LocalLimitDurfee
DurfeeCCS.standardNormalDensity_eq_gaussianPDFReal (x : ℝ) :
  DurfeeCCS.standardNormalDensity x = ProbabilityTheory.gaussianPDFReal 0 1 x
STEP13_DECL_KIND DurfeeCCS.sum_quotientCoefficients_eq_card_partitions theorem DurfeeCCS.PartitionTotals
DurfeeCCS.sum_quotientCoefficients_eq_card_partitions {n : ℕ} (hn : 0 < n) :
  (List.ofFn fun i => ↑(DurfeeCCS.p n (↑i + 1))).sum = ↑(Fintype.card n.Partition)
STEP13_DECL_KIND DurfeeCCS.summable_norm_durfeeAnalyticDiagonal theorem DurfeeCCS.Step06.GeneratingAnalytic
DurfeeCCS.summable_norm_durfeeAnalyticDiagonal (x : ℂ) {q : ℂ} (hq : ‖q‖ < 1) :
  Summable fun d => ‖q ^ (d * d) * x ^ d * (DurfeeCCS.qPochhammer q q d)⁻¹ ^ 2‖
STEP13_DECL_KIND DurfeeCCS.summable_norm_durfeeAnalyticF theorem DurfeeCCS.Step06.GeneratingAnalytic
DurfeeCCS.summable_norm_durfeeAnalyticF (x : ℂ) {q : ℂ} (hq : ‖q‖ < 1) :
  Summable fun n => ‖Polynomial.eval x (DurfeeCCS.durfeePolynomialComplex n) * q ^ n‖
STEP13_DECL_KIND DurfeeCCS.tendsto_gaussianReal_of_bernoulli_charFun theorem DurfeeCCS.Step12.CentralLimit
DurfeeCCS.tendsto_gaussianReal_of_bernoulli_charFun.{u_1} {ι : ℕ → Type u_1} [(n : ℕ) → Fintype (ι n)]
  (p : (n : ℕ) → ι n → ℝ) (hp : ∀ (n : ℕ) (i : ι n), p n i ∈ Set.Icc 0 1)
  (hV : Filter.Tendsto (fun n => DurfeeCCS.bernoulliVariance (p n)) Filter.atTop Filter.atTop)
  (μ : ℕ → MeasureTheory.ProbabilityMeasure ℝ)
  (hμ :
    ∀ (n : ℕ) (t : ℝ),
      MeasureTheory.charFun (↑(μ n)) t =
        ∏ i, DurfeeCCS.centeredBernoulliChar (p n i) (t / √(DurfeeCCS.bernoulliVariance (p n)))) :
  Filter.Tendsto μ Filter.atTop (nhds ⟨ProbabilityTheory.gaussianReal 0 1, ⋯⟩)
STEP13_DECL_KIND DurfeeCCS.tendsto_iSup_bernoulliLatticeMass_standardNormal theorem DurfeeCCS.Step12.LocalLimit
DurfeeCCS.tendsto_iSup_bernoulliLatticeMass_standardNormal.{u_1} {ι : ℕ → Type u_1} [(n : ℕ) → Fintype (ι n)]
  (p : (n : ℕ) → ι n → ℝ) (hp : ∀ (n : ℕ) (i : ι n), p n i ∈ Set.Icc 0 1) (s : ℕ → Finset ℤ) (mass : ℕ → ℤ → ℝ)
  (μ : ℕ → ℝ) (hmass : ∀ (n : ℕ), ∀ k ∉ s n, mass n k = 0)
  (hV : Filter.Tendsto (fun n => DurfeeCCS.bernoulliVariance (p n)) Filter.atTop Filter.atTop)
  (hfactor :
    ∀ᶠ (n : ℕ) in Filter.atTop,
      ∀ (t : ℝ),
        DurfeeCCS.latticeChar (s n) (mass n) (μ n) (√(DurfeeCCS.bernoulliVariance (p n))) t =
          ∏ i, DurfeeCCS.centeredBernoulliChar (p n i) (t / √(DurfeeCCS.bernoulliVariance (p n)))) :
  Filter.Tendsto
    (fun n =>
      ⨆ k,
        |√(DurfeeCCS.bernoulliVariance (p n)) * mass n k -
            DurfeeCCS.standardNormalDensity ((↑k - μ n) / √(DurfeeCCS.bernoulliVariance (p n)))|)
    Filter.atTop (nhds 0)
STEP13_DECL_KIND DurfeeCCS.uniformPartitionMeasure_singleton theorem DurfeeCCS.Step12.FiniteLaw
DurfeeCCS.uniformPartitionMeasure_singleton (n : ℕ) (P : n.Partition) :
  (DurfeeCCS.uniformPartitionMeasure n) {P} = (↑(Fintype.card n.Partition))⁻¹
STEP13_DECL_KIND DurfeeCCS.verifyPairRow_sound theorem DurfeeCCS.CoefficientCertificate
DurfeeCCS.verifyPairRow_sound {d : ℕ} {previous current : List ℤ} (hprev : DurfeeCCS.CoefficientRowSpec d previous)
  (h : DurfeeCCS.verifyPairRow d previous current = Bool.true) : DurfeeCCS.CoefficientRowSpec (d + 1) current
