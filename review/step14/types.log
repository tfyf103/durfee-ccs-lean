STEP13_DECL_KIND DurfeeCCS.Step10.farCentral_lower theorem DurfeeCCS.Step10.OuterFarCentral
DurfeeCCS.Step10.farCentral_lower (hc : DurfeeCCS.Step10.FarCoefficientBounds) {n d : ℕ} (hn : 6401 ≤ n) (hd : 1 ≤ d)
  (hdm : d < n.sqrt) (hfar : DurfeeCCS.Step10.farThreshold n ≤ DurfeeCCS.Step10.farSample n d) :
