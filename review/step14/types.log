    DurfeeCCS.Step10.outerDelta (DurfeeCCS.Step10.outerY n) (DurfeeCCS.Step10.outerStart n + 2) -
      DurfeeCCS.Step10.outerDelta (DurfeeCCS.Step10.outerY n) (DurfeeCCS.Step10.outerStart n)
STEP13_DECL_KIND DurfeeCCS.Step10.outerDelta_start_lower theorem DurfeeCCS.Step10.OuterGeometryBounds
DurfeeCCS.Step10.outerDelta_start_lower {n : ℕ} (hn : 6401 ≤ n) :
