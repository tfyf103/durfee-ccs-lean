STEP13_DECL_KIND DurfeeCCS.Step10.farCentral_lossParts theorem DurfeeCCS.Step10.OuterFarCentral
DurfeeCCS.Step10.farCentral_lossParts (hc : DurfeeCCS.Step10.FarCoefficientBounds) {n d : ℕ} (hn : 6401 ≤ n)
  (hd : 1 ≤ d) (hdm : d < n.sqrt) (hfar : DurfeeCCS.Step10.farThreshold n ≤ DurfeeCCS.Step10.farSample n d) :
  have t := n - d ^ 2 - d - 1;
  have f := DurfeeCCS.Step10.farRadius n d;
  2 / (0.9 * DurfeeCCS.Step10.outerComparisonB f) *
        ∑ v ∈ Finset.Ico 25 (t + 1), ↑(DurfeeCCS.Step06.twoColourPartitionCount v) <
      26053e-6 ∧
