  Real.exp (DurfeeCCS.Step08.saddleOmega n r) / (2 * Real.pi) *
      ∫ (v : ℝ) in Set.Icc (-(16 * u)) (16 * u),
        ‖DurfeeCCS.Step08.durfeeExponentialMean r u v - DurfeeCCS.Step08.saddleExponentialMean r u v‖ ≤
    DurfeeCCS.Step06.saddleAmplitude n r * DurfeeCCS.Step08.firstSaddleMainArcBudget n r
STEP13_DECL_KIND DurfeeCCS.Step08.firstSaddle_sign theorem DurfeeCCS.Step08.FirstSaddleProof
DurfeeCCS.Step08.firstSaddle_sign {n : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1)
  (hscale : 4 * Real.pi ≤ √(↑n * r)) :
  (Real.cos (DurfeeCCS.Step06.saddlePhase n r) = 1 → 0 < DurfeeCCS.Step08.durfeeNegativeValue n r) ∧
    (Real.cos (DurfeeCCS.Step06.saddlePhase n r) = -1 → DurfeeCCS.Step08.durfeeNegativeValue n r < 0)
STEP13_DECL_KIND DurfeeCCS.Step08.firstSaddle_sign_at_phase theorem DurfeeCCS.Step08.FirstSaddlePhaseSign
DurfeeCCS.Step08.firstSaddle_sign_at_phase {n k : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1)
  (hscale : 4 * Real.pi ≤ √(↑n * r)) (hphase : DurfeeCCS.Step06.saddlePhase n r = ↑k * Real.pi) :
  (DurfeeCCS.Step08.durfeeNegativeValue n r).sign = (-1) ^ k
STEP13_DECL_KIND DurfeeCCS.Step08.integrable_nearOriginAngularModel theorem DurfeeCCS.Step08.NearOriginModelIntegral
DurfeeCCS.Step08.integrable_nearOriginAngularModel {u : ℝ} (hu : 0 < u) (r x : ℝ) :
  MeasureTheory.Integrable
    (fun v =>
      Complex.exp (↑x * DurfeeCCS.Step08.verticalPoint u v) *
        DurfeeCCS.Step08.nearOriginAngularModel r (DurfeeCCS.Step08.verticalPoint u v))
    MeasureTheory.MeasureSpace.volume
STEP13_DECL_KIND DurfeeCCS.Step08.integrable_saddleExponentialMean theorem DurfeeCCS.Step08.SaddleModelIntegral
DurfeeCCS.Step08.integrable_saddleExponentialMean {r u : ℝ} (hr : |r| ≤ 1) (hu : 0 < u) (x : ℝ) :
  MeasureTheory.Integrable
    (fun v => Complex.exp (↑x * DurfeeCCS.Step08.verticalPoint u v) * DurfeeCCS.Step08.saddleExponentialMean r u v)
    MeasureTheory.MeasureSpace.volume
STEP13_DECL_KIND DurfeeCCS.Step08.integral_exp_verticalPoint_nat theorem DurfeeCCS.Step08.DurfeeContour
DurfeeCCS.Step08.integral_exp_verticalPoint_nat {n : ℕ} (hn : 0 < n) (u : ℝ) :
  ∫ (v : ℝ) in -Real.pi..Real.pi, Complex.exp (↑n * DurfeeCCS.Step08.verticalPoint u v) = 0
STEP13_DECL_KIND DurfeeCCS.Step08.integral_nearOriginAngularModel_eq_nearOriginModel theorem DurfeeCCS.Step08.NearOriginModelIntegral
DurfeeCCS.Step08.integral_nearOriginAngularModel_eq_nearOriginModel {u r σ : ℝ} {n : ℕ} (hu : 0 < u) (hn : 0 < n)
  (hσ : σ ^ 2 = ↑n * r) :
  (↑(2 * Real.pi))⁻¹ *
      ∫ (v : ℝ),
        Complex.exp (↑n * DurfeeCCS.Step08.verticalPoint u v) *
          DurfeeCCS.Step08.nearOriginAngularModel r (DurfeeCCS.Step08.verticalPoint u v) =
    DurfeeCCS.Step08.nearOriginModel σ n
STEP13_DECL_KIND DurfeeCCS.Step08.integral_norm_nearOriginBase_outer_le theorem DurfeeCCS.Step08.NearOriginOuterBounds
DurfeeCCS.Step08.integral_norm_nearOriginBase_outer_le {r u : ℝ} (hr : 0 ≤ r) (hu : 0 < u) (hup : 4 * u ≤ Real.pi) :
  ∫ (v : ℝ) in {v | Real.pi < |v|},
      ‖DurfeeCCS.Step08.angularAverage fun θ =>
          Complex.exp (DurfeeCCS.Step08.nearOriginMainLog r θ (DurfeeCCS.Step08.verticalPoint u v)) - 1‖ ≤
    2 * Real.exp (r / u / 2) * r ^ 2 / Real.pi
STEP13_DECL_KIND DurfeeCCS.Step08.integral_norm_nearOriginCentralError_le theorem DurfeeCCS.Step08.NearOriginArcBounds
DurfeeCCS.Step08.integral_norm_nearOriginCentralError_le {r u : ℝ} (hr₀ : 0 < r) (hr₁ : r ≤ 1 / 40) (hu₀ : 0 < u)
  (hu₁ : u ≤ 1 / 40) :
  ∫ (v : ℝ) in Set.Icc (-(4 * u)) (4 * u), ‖DurfeeCCS.Step08.nearOriginCentralError r u v‖ ≤
    15 * u * Real.exp (r / u) / (r / u) * DurfeeCCS.Step08.nearOriginCentralCoefficient r u
STEP13_DECL_KIND DurfeeCCS.Step08.integral_norm_nearOriginCorrection_outer_le theorem DurfeeCCS.Step08.NearOriginOuterBounds
DurfeeCCS.Step08.integral_norm_nearOriginCorrection_outer_le {r u : ℝ} (hr : 0 < r) (hu : 0 < u) :
  ∫ (v : ℝ) in {v | 4 * u < |v|},
      ‖DurfeeCCS.Step08.angularAverage fun θ =>
          Complex.exp (DurfeeCCS.Step08.nearOriginMainLog r θ (DurfeeCCS.Step08.verticalPoint u v)) *
            DurfeeCCS.Step08.nearOriginCorrection r θ (DurfeeCCS.Step08.verticalPoint u v)‖ ≤
    Real.pi * Real.exp (r / u / 2) * r ^ 3 / (2 * u)
STEP13_DECL_KIND DurfeeCCS.Step08.integral_norm_nearOriginMiddleError_le theorem DurfeeCCS.Step08.NearOriginMiddleEstimate
DurfeeCCS.Step08.integral_norm_nearOriginMiddleError_le {r u : ℝ} (hu : 0 < u) (hu_r : u ≤ r) (hr : r ≤ 1 / 40)
  (hΔ : r ^ 2 / u ≤ 1) :
  (2 * Real.pi)⁻¹ * ∫ (v : ℝ) in {v | 4 * u < |v| ∧ |v| ≤ Real.pi}, ‖DurfeeCCS.Step08.nearOriginMiddleError r u v‖ ≤
    Real.exp (r / u / 2 + 1.02 * (r ^ 2 / u)) * (0.48 * r ^ 2 + 0.36 * (r ^ 3 / u))
STEP13_DECL_KIND DurfeeCCS.Step08.integral_rayLog theorem DurfeeCCS.Step08.MidpointRay
DurfeeCCS.Step08.integral_rayLog {w α : ℂ} (hw : ‖w‖ < 1) (hα : α.re = 1) :
  ∫ (x : ℝ) in Set.Ioi 0, DurfeeCCS.Step08.rayLog w α x = -DurfeeCCS.Step06.principalDilog w / α
STEP13_DECL_KIND DurfeeCCS.Step08.integral_saddleBesselModel theorem DurfeeCCS.Step08.SaddleBesselModel
DurfeeCCS.Step08.integral_saddleBesselModel {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r)
  (hRate : 0 < (DurfeeCCS.Step08.saddleBesselRate n r).re) :
  ∫ (ψ : ℝ) in Set.Ioi 0, DurfeeCCS.Step08.saddleBesselModel n r ψ =
    DurfeeCCS.Step06.saddleS r * Complex.exp (2 * ↑√↑n * DurfeeCCS.Step06.saddleS r) /
      (2 * ↑Real.pi * ↑n * (DurfeeCCS.Step08.saddleBesselSlope r).sqrt)
STEP13_DECL_KIND DurfeeCCS.Step08.integral_saddleBessel_angle_change theorem DurfeeCCS.Step08.SaddleBesselJacobian
DurfeeCCS.Step08.integral_saddleBessel_angle_change (f : ℝ → ℂ) (hf : Continuous f) (heven : Function.Even f) {c : ℝ}
  (hc : 0 ≤ c) (hc' : c ≤ Real.pi / 2) :
  ∫ (θ : ℝ) in -c..c, f θ = ↑√2 * ∫ (ψ : ℝ) in 0..1 - Real.cos c, f (Real.arccos (1 - ψ)) / ↑(√ψ * √(1 - ψ / 2))
STEP13_DECL_KIND DurfeeCCS.Step08.integral_saddleExponentialMean_eq_saddleBesselAverage theorem DurfeeCCS.Step08.SaddleModelIntegral
DurfeeCCS.Step08.integral_saddleExponentialMean_eq_saddleBesselAverage {r u : ℝ} {n : ℕ} (hr : |r| ≤ 1) (hu : 0 < u)
  (hn : 0 < n) :
  (↑(2 * Real.pi))⁻¹ *
      ∫ (v : ℝ), Complex.exp (↑n * DurfeeCCS.Step08.verticalPoint u v) * DurfeeCCS.Step08.saddleExponentialMean r u v =
    ↑(DurfeeCCS.Step08.saddleBesselAverage n r)
STEP13_DECL_KIND DurfeeCCS.Step08.integral_vertical_kernel theorem DurfeeCCS.Step08.NearOriginLaplace
DurfeeCCS.Step08.integral_vertical_kernel {u x : ℝ} (hu : 0 < u) (hx : 0 < x) {j : ℕ} (hj : 2 ≤ j) :
  (↑(2 * Real.pi))⁻¹ *
      ∫ (v : ℝ), Complex.exp (↑x * DurfeeCCS.Step08.verticalPoint u v) / DurfeeCCS.Step08.verticalPoint u v ^ j =
    ↑x ^ (j - 1) / ↑(j - 1).factorial
STEP13_DECL_KIND DurfeeCCS.Step08.integral_vertical_power_series theorem DurfeeCCS.Step08.NearOriginModelIntegral
DurfeeCCS.Step08.integral_vertical_power_series {u x : ℝ} (hu : 0 < u) (a : ℕ → ℂ) (j : ℕ → ℕ) (hj : ∀ (d : ℕ), 2 ≤ j d)
  (ha : Summable fun d => ‖a d‖ / u ^ (j d - 2)) :
  MeasureTheory.Integrable
      (fun v =>
        Complex.exp (↑x * DurfeeCCS.Step08.verticalPoint u v) *
          ∑' (d : ℕ), a d / DurfeeCCS.Step08.verticalPoint u v ^ j d)
      MeasureTheory.MeasureSpace.volume ∧
    (0 < x →
      (↑(2 * Real.pi))⁻¹ *
          ∫ (v : ℝ),
            Complex.exp (↑x * DurfeeCCS.Step08.verticalPoint u v) *
              ∑' (d : ℕ), a d / DurfeeCCS.Step08.verticalPoint u v ^ j d =
        ∑' (d : ℕ), a d * (↑x ^ (j d - 1) / ↑(j d - 1).factorial))
STEP13_DECL_KIND DurfeeCCS.Step08.intervalIntegrable_saddle_log theorem DurfeeCCS.Step08.PhaseGapIntegral
DurfeeCCS.Step08.intervalIntegrable_saddle_log {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (θ : ℝ) :
  IntervalIntegrable (fun y => Complex.log (DurfeeCCS.Step08.saddleLogArgument θ y) / ↑y)
    MeasureTheory.MeasureSpace.volume 0 r
STEP13_DECL_KIND DurfeeCCS.Step08.lemma33 theorem DurfeeCCS.Step08.PhaseGapEndpoint
DurfeeCCS.Step08.lemma33 {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  have s := DurfeeCCS.Step06.saddleS r;
  have a := s.re;
  have ρ := DurfeeCCS.Step08.saddleSlope r;
  have κ := DurfeeCCS.Step08.saddleCurvature r;
  have γ := DurfeeCCS.Step08.saddleGamma r;
  (∀ (θ : ℝ),
      DurfeeCCS.Step06.saddleG r θ = ∫ (y : ℝ) in 0..r, Complex.log (DurfeeCCS.Step08.saddleLogArgument θ y) / ↑y) ∧
    (∀ (θ : ℝ),
        r ^ 2 / (1 + r ^ 2) * Real.sin θ ^ 2 ≤ (s ^ 2).re - (DurfeeCCS.Step06.saddleG r θ).re ∧
          2 * r / (1 + r ^ 2) * (1 - Real.cos θ) ≤ (s ^ 2).im - (DurfeeCCS.Step06.saddleG r θ).im) ∧
      (r ≤ a ^ 2 ∧ a ^ 2 ≤ r * (1 + 0.282 * r) ∧ 1 - 0.282 * r ≤ ρ ∧ ρ ≤ 1 ∧ 16 * r / 9 ≤ ‖s‖ ^ 2) ∧
        (1 / ((1 + r ^ 2) * (1 + 0.282 * r)) ≤ κ ∧ κ ≤ 1 ∧ 0.39 < κ) ∧
          (∀ (n : ℕ),
              0 < n →
                4 * Real.pi ≤ √(↑n * r) →
                  have ω := a * √↑n;
                  4 * Real.pi ≤ ω ∧ 2 * Real.exp (2 * ω) / (3 * Real.pi * ↑n) ≤ DurfeeCCS.Step06.saddleAmplitude n r) ∧
            (∀ (θ η : ℝ),
                |θ| ≤ Real.pi / 2 →
                  0 ≤ η →
                    have ψ := 1 - Real.cos θ;
                    γ * ψ ≤ ((η - ρ) ^ 2 + r * κ * ψ * (2 - ψ) + 2 * κ * η * ψ) / (1 + η ^ 2) ∧
                      ((η - ρ) ^ 2 + r * κ * ψ * (2 - ψ) + 2 * κ * η * ψ) / (1 + η ^ 2) ≤
                        DurfeeCCS.Step08.saddleGap r θ η) ∧
              (∀ (θ : ℝ),
                  |θ| ≤ Real.pi / 2 → (DurfeeCCS.Step06.saddleG r θ).sqrt.re ≤ a * √(1 - γ * (1 - Real.cos θ))) ∧
                ContinuousOn (fun θ => (DurfeeCCS.Step06.saddleG r θ).sqrt) (Set.Icc (-(Real.pi / 2)) (Real.pi / 2)) ∧
                  (∀ (θ η : ℝ), 0 ≤ η → (η - ρ) ^ 2 / (1 + η ^ 2) ≤ DurfeeCCS.Step08.saddleGap r θ η) ∧
                    ∀ (θ η : ℝ),
                      Real.pi / 2 < |θ| → |θ| ≤ Real.pi → 0 ≤ η → 1 - r / 2 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.lemma34 theorem DurfeeCCS.Step08.SaddleBesselApproximation
DurfeeCCS.Step08.lemma34 {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  |DurfeeCCS.Step08.saddleBesselAverage n r -
        DurfeeCCS.Step06.saddleAmplitude n r * Real.cos (DurfeeCCS.Step06.saddlePhase n r)| ≤
    DurfeeCCS.Step06.saddleAmplitude n r *
      DurfeeCCS.Step07.firstSaddleE (DurfeeCCS.Step08.saddleOmega n r) (DurfeeCCS.Step08.saddleGamma r)
STEP13_DECL_KIND DurfeeCCS.Step08.lemma34_paper theorem DurfeeCCS.Step08.SaddleBesselApproximation
DurfeeCCS.Step08.lemma34_paper {n : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1)
  (_hscale : 4 * Real.pi ≤ √(↑n * r)) :
  |DurfeeCCS.Step08.saddleBesselAverage n r -
        DurfeeCCS.Step06.saddleAmplitude n r * Real.cos (DurfeeCCS.Step06.saddlePhase n r)| ≤
    DurfeeCCS.Step06.saddleAmplitude n r * DurfeeCCS.Step08.saddleBesselPaperError (DurfeeCCS.Step08.saddleOmega n r) r
STEP13_DECL_KIND DurfeeCCS.Step08.midpoint_rule_Ioi theorem DurfeeCCS.Step08.MidpointRule
DurfeeCCS.Step08.midpoint_rule_Ioi.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {f f' f'' : ℝ → E} {u : ℝ} (hu : 0 < u) (hf : ∀ x ≥ 0, HasDerivAt f (f' x) x) (hf' : ∀ x ≥ 0, HasDerivAt f' (f'' x) x)
  (hc : ContinuousOn f'' (Set.Ici 0)) (hfi : MeasureTheory.IntegrableOn f (Set.Ioi 0) MeasureTheory.MeasureSpace.volume)
  (hdi : MeasureTheory.IntegrableOn f'' (Set.Ioi 0) MeasureTheory.MeasureSpace.volume)
  (hs : Summable fun j => f ((↑j + 1 / 2) * u)) :
  ‖∑' (j : ℕ), f ((↑j + 1 / 2) * u) - u⁻¹ • ∫ (x : ℝ) in Set.Ioi 0, f x‖ ≤ u / 8 * ∫ (x : ℝ) in Set.Ioi 0, ‖f'' x‖
STEP13_DECL_KIND DurfeeCCS.Step08.midpoint_rule_interval theorem DurfeeCCS.Step08.MidpointRule
DurfeeCCS.Step08.midpoint_rule_interval.{u_1} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {f f' f'' : ℝ → E} {a b : ℝ} (hab : a ≤ b) (hf : ∀ x ∈ Set.Icc a b, HasDerivAt f (f' x) x)
  (hf' : ∀ x ∈ Set.Icc a b, HasDerivAt f' (f'' x) x) (hc : ContinuousOn f'' (Set.Icc a b)) :
  ‖(b - a) • f ((a + b) / 2) - ∫ (x : ℝ) in a..b, f x‖ ≤ (b - a) ^ 2 / 8 * ∫ (x : ℝ) in a..b, ‖f'' x‖
STEP13_DECL_KIND DurfeeCCS.Step08.minorArc_centers_separated theorem DurfeeCCS.Step08.MinorArcGeometry
DurfeeCCS.Step08.minorArc_centers_separated {p q : ℚ} (hp : p.den ≤ 7) (hq : q.den ≤ 7) (hne : p ≠ q) :
  2 * Real.pi / 42 ≤ |2 * Real.pi * ↑p - 2 * Real.pi * ↑q|
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginAngularModel_eq_series theorem DurfeeCCS.Step08.ModelAngular
DurfeeCCS.Step08.nearOriginAngularModel_eq_series (r : ℝ) {ζ : ℂ} (hζ : ζ ≠ 0) :
  DurfeeCCS.Step08.nearOriginAngularModel r ζ =
    ∑' (d : ℕ), DurfeeCCS.Step08.nearOriginAngularBaseTerm r ζ d -
      ↑r ^ 4 / 2 * ∑' (d : ℕ), DurfeeCCS.Step08.nearOriginAngularCorrectionTerm r ζ d
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginBudget other DurfeeCCS.Step08.NearOriginDefs
DurfeeCCS.Step08.nearOriginBudget (σ : ℝ) (n : ℕ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginCorrection other DurfeeCCS.Step08.NearOriginDefs
DurfeeCCS.Step08.nearOriginCorrection (r θ : ℝ) (ζ : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginDelta other DurfeeCCS.Step08.NearOriginDefs
DurfeeCCS.Step08.nearOriginDelta (σ : ℝ) (n : ℕ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginEpsilon other DurfeeCCS.Step08.NearOriginDefs
DurfeeCCS.Step08.nearOriginEpsilon (σ : ℝ) (n : ℕ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginMainLog other DurfeeCCS.Step08.NearOriginDefs
DurfeeCCS.Step08.nearOriginMainLog (r θ : ℝ) (ζ : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOriginModel_eq_series theorem DurfeeCCS.Step08.NearOriginModelSeries
DurfeeCCS.Step08.nearOriginModel_eq_series (σ : ℝ) (n : ℕ) :
  DurfeeCCS.Step08.nearOriginModel σ n =
    (↑n)⁻¹ * ∑' (k : ℕ), (-1) ^ (k + 1) * ↑σ ^ (4 * (k + 1)) / (↑(k + 1).factorial ^ 2 * ↑(2 * k + 1).factorial) -
      ↑σ ^ 4 / (2 * ↑n ^ 2) *
        ∑' (k : ℕ), (-1) ^ k * ↑σ ^ (4 * k + 4) / (↑k.factorial * ↑(k + 2).factorial * ↑(2 * k + 2).factorial)
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_approximation theorem DurfeeCCS.Step08.NearOriginApproximation
DurfeeCCS.Step08.nearOrigin_approximation : DurfeeCCS.Step08.NearOriginApproximationStatement
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_budget_normalize theorem DurfeeCCS.Step08.NearOriginBudget
DurfeeCCS.Step08.nearOrigin_budget_normalize {σ : ℝ} {n : ℕ} (hσ : 0 < σ) (hn : 0 < n) {central : ℝ}
  (hc :
    central =
      DurfeeCCS.Step08.nearOriginEpsilon σ n *
          Real.exp (DurfeeCCS.Step08.nearOriginDelta σ n / 2 + DurfeeCCS.Step08.nearOriginEpsilon σ n) +
        DurfeeCCS.Step08.nearOriginDelta σ n ^ 2 / 8 * Real.exp (DurfeeCCS.Step08.nearOriginDelta σ n / 2)) :
  have r := σ ^ 2 / ↑n;
  have u := σ / ↑n;
  Real.exp σ *
      ((2 * Real.pi)⁻¹ * (15 * u * Real.exp (r / u) / (r / u) * central) +
            Real.exp (r / u / 2 + 1.02 * (r ^ 2 / u)) * (0.48 * r ^ 2 + 0.36 * (r ^ 3 / u)) +
          (2 * Real.pi)⁻¹ * (2 * Real.exp (r / u / 2) * r ^ 2 / Real.pi) +
        (2 * Real.pi)⁻¹ * (Real.pi * Real.exp (r / u / 2) * r ^ 3 / (2 * u))) =
    Real.exp (2 * σ) * DurfeeCCS.Step08.nearOriginBudget σ n / ↑n
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_central_epsilon_normalize theorem DurfeeCCS.Step08.NearOriginBudget
DurfeeCCS.Step08.nearOrigin_central_epsilon_normalize (σ : ℝ) {n : ℕ} (hn : 0 < n) :
  have r := σ ^ 2 / ↑n;
  have u := σ / ↑n;
  0.66 * r * u + 0.228 * r * DurfeeCCS.Step08.nearOriginDelta σ n + 0.35 * r ^ 2 * u =
    DurfeeCCS.Step08.nearOriginEpsilon σ n
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_contour_difference_le theorem DurfeeCCS.Step08.NearOriginContour
DurfeeCCS.Step08.nearOrigin_contour_difference_le {n : ℕ} {r u σ : ℝ} (hn : 0 < n) (hr : 0 < r) (hr₁ : r ≤ 1 / 40)
  (hu : 0 < u) (hup : 4 * u ≤ Real.pi) (hσ : σ ^ 2 = ↑n * r) :
  ‖↑(DurfeeCCS.Step08.durfeeNegativeValue n r) - DurfeeCCS.Step08.nearOriginModel σ n‖ ≤
    Real.exp (↑n * u) / (2 * Real.pi) *
      ((((∫ (v : ℝ) in Set.Icc (-(4 * u)) (4 * u), ‖DurfeeCCS.Step08.nearOriginCentralError r u v‖) +
            ∫ (v : ℝ) in {v | 4 * u < |v| ∧ |v| ≤ Real.pi}, ‖DurfeeCCS.Step08.nearOriginMiddleError r u v‖) +
          ∫ (v : ℝ) in {v | Real.pi < |v|},
            ‖DurfeeCCS.Step08.angularAverage fun θ =>
                Complex.exp (DurfeeCCS.Step08.nearOriginMainLog r θ (DurfeeCCS.Step08.verticalPoint u v)) - 1‖) +
        ∫ (v : ℝ) in {v | 4 * u < |v|},
          ‖DurfeeCCS.Step08.angularAverage fun θ =>
              Complex.exp (DurfeeCCS.Step08.nearOriginMainLog r θ (DurfeeCCS.Step08.verticalPoint u v)) *
                DurfeeCCS.Step08.nearOriginCorrection r θ (DurfeeCCS.Step08.verticalPoint u v)‖)
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_error_margin theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.nearOrigin_error_margin {σ : ℝ} (hσ : 0 < σ) {n : ℕ} (hn : 6400 ≤ n) (hr : σ ^ 2 / ↑n ≤ 1 / 40)
  (hΔ : DurfeeCCS.Step08.nearOriginDelta σ n ≤ 1 / 3) :
  DurfeeCCS.Step08.nearOriginEpsilon σ n < 1 / 500 ∧ DurfeeCCS.Step08.nearOriginBudget σ n < 3 / 20
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_firstEight_thresholds theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.nearOrigin_firstEight_thresholds {n k : ℕ} (hn : 6400 ≤ n) (hk : k ≤ 8) :
  40 * DurfeeCCS.Step08.nearOriginSigma k ^ 2 ≤ ↑n ∧ 3 * DurfeeCCS.Step08.nearOriginSigma k ^ 3 ≤ ↑n
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_inner_average_integral_le theorem DurfeeCCS.Step08.NearOriginGaussian
DurfeeCCS.Step08.nearOrigin_inner_average_integral_le {σ : ℝ} (hσ : 0 < σ) :
  ∫ (η : ℝ) in -4..4, DurfeeCCS.Step08.nearOriginInnerAverage σ η ≤ 15 * Real.exp σ / σ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_model_signed_margin theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.nearOrigin_model_signed_margin (k : ℕ) (hk : 1 ≤ k) (n : ℕ) (hn : 0 < n) :
  63 / 400 * Real.exp (2 * DurfeeCCS.Step08.nearOriginSigma k) / ↑n <
    DurfeeCCS.Step08.originParity k * (DurfeeCCS.Step08.nearOriginModel (DurfeeCCS.Step08.nearOriginSigma k) n).re
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_r_div_u theorem DurfeeCCS.Step08.NearOriginBudget
DurfeeCCS.Step08.nearOrigin_r_div_u {σ : ℝ} {n : ℕ} (hσ : σ ≠ 0) (hn : 0 < n) : σ ^ 2 / ↑n / (σ / ↑n) = σ
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_r_sq_div_u theorem DurfeeCCS.Step08.NearOriginBudget
DurfeeCCS.Step08.nearOrigin_r_sq_div_u {σ : ℝ} {n : ℕ} (hσ : σ ≠ 0) (hn : 0 < n) :
  (σ ^ 2 / ↑n) ^ 2 / (σ / ↑n) = DurfeeCCS.Step08.nearOriginDelta σ n
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_sample_margin theorem DurfeeCCS.Step08.NearOriginApproximation
DurfeeCCS.Step08.nearOrigin_sample_margin {k n : ℕ} (hk : 1 ≤ k) (hn : 6400 ≤ n)
  (hn₂ : 40 * DurfeeCCS.Step08.nearOriginSigma k ^ 2 ≤ ↑n) (hn₃ : 3 * DurfeeCCS.Step08.nearOriginSigma k ^ 3 ≤ ↑n) :
  3 * Real.exp (2 * DurfeeCCS.Step08.nearOriginSigma k) / (400 * ↑n) <
