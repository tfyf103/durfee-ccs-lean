STEP13_DECL_KIND DurfeeCCS.Step10.farCentralLow_constant theorem DurfeeCCS.Step10.OuterFarNumerics
DurfeeCCS.Step10.farCentralLow_constant {f : ℝ} (hf : 12.52 ≤ f) :
