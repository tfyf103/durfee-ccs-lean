STEP13_DECL_KIND DurfeeCCS.Step10.outerDelta_increment theorem DurfeeCCS.Step10.OuterGeometryBounds
DurfeeCCS.Step10.outerDelta_increment {n : ℕ} (hn : 6401 ≤ n) :
  1.05 +
      (2 * Real.pi ^ 4 * DurfeeCCS.Step10.outerY n /
          (3 * DurfeeCCS.Step10.outerStart n * √(DurfeeCCS.Step10.outerStart n ^ 2 + DurfeeCCS.Step10.outerA) ^ 3) +
