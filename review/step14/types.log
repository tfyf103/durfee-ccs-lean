STEP13_DECL_KIND DurfeeCCS.Step10.outerDelta_end_lt_degree theorem DurfeeCCS.Step10.OuterGeometryBounds
DurfeeCCS.Step10.outerDelta_end_lt_degree {n : ℕ} (hn : 6401 ≤ n) :
