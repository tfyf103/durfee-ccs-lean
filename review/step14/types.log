STEP13_DECL_KIND DurfeeCCS.Step10.farGap_upperIndex_ge theorem DurfeeCCS.Step10.OuterFarGaps
DurfeeCCS.Step10.farGap_upperIndex_ge {n d l : ℕ} (hn : 6401 ≤ n) (hd : 1 ≤ d) (hdm : d < n.sqrt)
