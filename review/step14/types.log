STEP13_DECL_KIND DurfeeCCS.Step10.outerBesselCore_eq_weighted theorem DurfeeCCS.Step10.OuterBesselWeight
DurfeeCCS.Step10.outerBesselCore_eq_weighted {u : ℝ} (hu : 0 ≤ u) :
  ↑(DurfeeCCS.Step10.outerBesselCore u) =
    ↑Real.pi ^ 3 / 9 *
      ∫ (t : ℝ) in 0..1, ↑(t * (1 - t ^ 2)) * (DurfeeCCS.Step06.besselI 0 ↑(2 * Real.pi / √3 * √u * t) - 1)
