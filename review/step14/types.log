STEP13_DECL_KIND DurfeeCCS.Step10.farRatio_bound theorem DurfeeCCS.Step10.OuterFarDominance
DurfeeCCS.Step10.farRatio_bound (hc : DurfeeCCS.Step10.FarCoefficientBounds) {n d l : ℕ} (hn : 6401 ≤ n) (hd : 1 ≤ d)
