STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_sign_at_kpi theorem DurfeeCCS.Step08.NearOriginApproximation
DurfeeCCS.Step08.nearOrigin_sign_at_kpi {k n : ℕ} (hk : 1 ≤ k) (hn : 6400 ≤ n)
  (hn₂ : 40 * DurfeeCCS.Step08.nearOriginSigma k ^ 2 ≤ ↑n) (hn₃ : 3 * DurfeeCCS.Step08.nearOriginSigma k ^ 3 ≤ ↑n) :
  (Polynomial.eval (DurfeeCCS.Step08.nearOriginSample n k) (DurfeeCCS.durfeePolynomialReal n)).sign = (-1) ^ k
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_sign_firstEight theorem DurfeeCCS.Step08.NearOriginApproximation
DurfeeCCS.Step08.nearOrigin_sign_firstEight {k n : ℕ} (hk₁ : 1 ≤ k) (hk₈ : k ≤ 8) (hn : 6400 ≤ n) :
  (Polynomial.eval (DurfeeCCS.Step08.nearOriginSample n k) (DurfeeCCS.durfeePolynomialReal n)).sign = (-1) ^ k
STEP13_DECL_KIND DurfeeCCS.Step08.nearOrigin_thresholds theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.nearOrigin_thresholds {n : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hσ : √(↑n * r) ≤ 4 * Real.pi) :
  r ≤ 1 / 40 ∧ DurfeeCCS.Step08.nearOriginDelta (√(↑n * r)) n ≤ 1 / 3
STEP13_DECL_KIND DurfeeCCS.Step08.norm_exp_sub_one_le theorem DurfeeCCS.Step08.ExpRemainder
DurfeeCCS.Step08.norm_exp_sub_one_le (z : ℂ) : ‖Complex.exp z - 1‖ ≤ ‖z‖ * Real.exp (Max.max 0 z.re)
STEP13_DECL_KIND DurfeeCCS.Step08.norm_exp_sub_one_sub_le theorem DurfeeCCS.Step08.ExpRemainder
DurfeeCCS.Step08.norm_exp_sub_one_sub_le (z : ℂ) : ‖Complex.exp z - 1 - z‖ ≤ ‖z‖ ^ 2 / 2 * Real.exp (Max.max 0 z.re)
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLogMode_le theorem DurfeeCCS.Step08.MidpointLogSeries
DurfeeCCS.Step08.norm_pairedLogMode_le (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) (n : ℕ) :
  ‖DurfeeCCS.Step08.pairedLogMode r θ ζ n‖ ≤ 2 / (ζ.re * ↑(n + 1) ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLogMode_zero_sub_main_le theorem DurfeeCCS.Step08.NearOriginErrors
DurfeeCCS.Step08.norm_pairedLogMode_zero_sub_main_le {r : ℝ} (θ : ℝ) {ζ : ℂ} (hr : 0 ≤ r) (hζ : 0 < ζ.re)
  (him : |ζ.im| ≤ Real.pi) (hsq : ‖ζ‖ ^ 2 < 10) :
  ‖DurfeeCCS.Step08.pairedLogMode r θ ζ 0 - DurfeeCCS.Step08.nearOriginMainLog r θ ζ‖ ≤ 0.16 * r * ‖ζ‖ * |Real.cos θ|
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_le_minorEnvelope theorem DurfeeCCS.Step08.MinorArcEnvelope
DurfeeCCS.Step08.norm_pairedLog_le_minorEnvelope {n : ℕ} (hn : 6400 ≤ n) {r r₀ β off high πBound μ v θ : ℝ} (hr : 0 < r)
  (hrr : r ≤ r₀) (hr₀ : r₀ ≤ 1) (hβ : 0 < β) (ha : β * r ≤ (DurfeeCCS.Step06.saddleS r).re ^ 2)
  (hrow : DurfeeCCS.Step07.FirstSaddleArcRow r₀ β off high πBound μ)
  (hArc : DurfeeCCS.Step08.FirstSaddleArcEstimates r r₀ (DurfeeCCS.Step08.saddleU n r) v θ) :
  ‖DurfeeCCS.Step08.pairedLog r θ (DurfeeCCS.Step08.verticalPoint (DurfeeCCS.Step08.saddleU n r) v)‖ ≤
    μ * DurfeeCCS.Step08.saddleOmega n r
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_sub_main_lt theorem DurfeeCCS.Step08.NearOriginErrors
DurfeeCCS.Step08.norm_pairedLog_sub_main_lt {r : ℝ} (θ : ℝ) {ζ : ℂ} (hζ : 0 < ζ.re) (hu : ζ.re ≤ r) (hr : r ≤ 1 / 40)
  (hv : |ζ.im| ≤ Real.pi) :
  ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step08.nearOriginMainLog r θ ζ‖ < 1.02 * (r ^ 2 / ζ.re)
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le theorem DurfeeCCS.Step08.MidpointRay
DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le (r θ u η : ℝ) (hr₀ : 0 ≤ r) (hr₁ : r < 1) (hu : 0 < u) :
  have ζ := ↑u * (1 + ↑η * Complex.I);
  ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step06.saddleG r θ / ζ‖ ≤ u * (1 + η ^ 2) * r / (4 * (1 - r))
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le_45 theorem DurfeeCCS.Step08.MidpointUniform
DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le_45 (r θ u η : ℝ) (hr : |r| ≤ 1) (hu : 0 < u)
  (hsize : ‖↑u * (1 + ↑η * Complex.I)‖ ≤ 0.228) :
  have ζ := ↑u * (1 + ↑η * Complex.I);
  ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step06.saddleG r θ / ζ‖ ≤ 0.51 + 0.69 * (1 + √(1 + η ^ 2))
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le_45_saddle theorem DurfeeCCS.Step08.MidpointUniform
DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le_45_saddle {n : ℕ} (hn : 6400 ≤ n) {r θ η : ℝ} (hr : 0 < r)
  (hr₁ : r ≤ 1) (hη : |η| ≤ 16) :
  have ζ := ↑(DurfeeCCS.Step08.saddleU n r) * (1 + ↑η * Complex.I);
  ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step06.saddleG r θ / ζ‖ ≤ 0.51 + 0.69 * (1 + √(1 + η ^ 2))
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le_rectangle theorem DurfeeCCS.Step08.MidpointRectangle
DurfeeCCS.Step08.norm_pairedLog_sub_saddleG_div_le_rectangle (r θ u η : ℝ) (hr₀ : 0 ≤ r) (hr₁ : r ≤ 1) (hu : 0 < u)
  (hθ : |θ| ≤ Real.pi / 3) (hη₀ : 0 ≤ η) (hη₁ : η ≤ 2) :
  have ζ := ↑u * (1 + ↑η * Complex.I);
  ‖DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step06.saddleG r θ / ζ‖ ≤ 5 * u * r
STEP13_DECL_KIND DurfeeCCS.Step08.norm_pairedLog_zero_arc_lt theorem DurfeeCCS.Step08.SaddleStrictBounds
DurfeeCCS.Step08.norm_pairedLog_zero_arc_lt {r u : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hu : 0 < u) (θ v : ℝ)
  (hs : ∀ k ∈ Finset.range 7, 0.99 * 8 * u * ↑(k + 1) ≤ |Real.sin (↑(k + 1) * v / 2)|) :
  ‖DurfeeCCS.Step08.pairedLog r θ (DurfeeCCS.Step08.verticalPoint u v)‖ / (r / u) < 0.478
STEP13_DECL_KIND DurfeeCCS.Step08.norm_rayLogSecond theorem DurfeeCCS.Step08.MidpointRay
DurfeeCCS.Step08.norm_rayLogSecond {w α : ℂ} (hα : α.re = 1) (x : ℝ) :
  ‖DurfeeCCS.Step08.rayLogSecond w α x‖ = ‖α‖ ^ 2 * ‖w‖ * Real.exp (-x) / ‖1 - DurfeeCCS.Step08.rayArgument w α x‖ ^ 2
STEP13_DECL_KIND DurfeeCCS.Step08.norm_rayLog_midpoint_sub_dilog_le_integral theorem DurfeeCCS.Step08.MidpointRay
DurfeeCCS.Step08.norm_rayLog_midpoint_sub_dilog_le_integral {w α : ℂ} (hw : ‖w‖ < 1) (hα : α.re = 1) {u : ℝ}
  (hu : 0 < u) :
  ‖∑' (j : ℕ), DurfeeCCS.Step08.rayLog w α ((↑j + 1 / 2) * u) - -DurfeeCCS.Step06.principalDilog w / (↑u * α)‖ ≤
    u / 8 * ∫ (x : ℝ) in Set.Ioi 0, ‖DurfeeCCS.Step08.rayLogSecond w α x‖
STEP13_DECL_KIND DurfeeCCS.Step08.norm_saddleBesselModel_tail theorem DurfeeCCS.Step08.SaddleBesselEstimate
DurfeeCCS.Step08.norm_saddleBesselModel_tail {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  ‖∫ (ψ : ℝ) in Set.Ioi 0.3, DurfeeCCS.Step08.saddleBesselModel n r ψ‖ ≤
    DurfeeCCS.Step06.saddleAmplitude n r *
      (2.4 / √(DurfeeCCS.Step08.saddleOmega n r) *
        Real.exp (-0.3 * DurfeeCCS.Step08.saddleGamma r * DurfeeCCS.Step08.saddleOmega n r))
STEP13_DECL_KIND DurfeeCCS.Step08.norm_saddleBesselPrefactor_le theorem DurfeeCCS.Step08.SaddleBesselModel
DurfeeCCS.Step08.norm_saddleBesselPrefactor_le {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  ‖DurfeeCCS.Step08.saddleBesselPrefactor n r‖ ≤
    DurfeeCCS.Step06.saddleAmplitude n r * √(1.5 * DurfeeCCS.Step08.saddleOmega n r / Real.pi)
STEP13_DECL_KIND DurfeeCCS.Step08.originI_one_lower theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.originI_one_lower {t : ℝ} (ht : 1 ≤ t) :
  (1 - 1 / t) * DurfeeCCS.Step08.originI 0 t < DurfeeCCS.Step08.originI 1 t
STEP13_DECL_KIND DurfeeCCS.Step08.originI_zero_lower theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.originI_zero_lower {x : ℝ} (hx : Real.pi ≤ x) :
  99 / 100 * Real.exp x / √(2 * Real.pi * x) < DurfeeCCS.Step08.originI 0 x
STEP13_DECL_KIND DurfeeCCS.Step08.originJ_signed_lower theorem DurfeeCCS.Step08.NearOriginSigns
DurfeeCCS.Step08.originJ_signed_lower (k : ℕ) (hk : 1 ≤ k) :
  have x := ↑k * Real.pi;
  have A := √(Real.pi * x / 2);
  79 / 120 < A * (DurfeeCCS.Step08.originParity k * DurfeeCCS.Step08.originJ 0 x) ∧
    23 / 40 < A * -(DurfeeCCS.Step08.originParity k * DurfeeCCS.Step08.originJ 1 x)
STEP13_DECL_KIND DurfeeCCS.Step08.pairedLog other DurfeeCCS.Step08.MidpointLogSeries
DurfeeCCS.Step08.pairedLog (r θ : ℝ) (ζ : ℂ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step08.pairedLogMode_zero theorem DurfeeCCS.Step08.NearOriginErrors
DurfeeCCS.Step08.pairedLogMode_zero (r θ : ℝ) (ζ : ℂ) :
  DurfeeCCS.Step08.pairedLogMode r θ ζ 0 = 2 * Complex.I * ↑r * ↑(Real.cos θ) / (2 * Complex.sinh (ζ / 2))
STEP13_DECL_KIND DurfeeCCS.Step08.pairedLogTail_one_geometric_lt theorem DurfeeCCS.Step08.NearOriginErrors
DurfeeCCS.Step08.pairedLogTail_one_geometric_lt {r u : ℝ} (hr₀ : 0 < r) (hr₁ : r ≤ 1 / 40) (hu : 0 < u) :
  r ^ 2 / (2 * u * (1 - r)) < 0.513 * (r ^ 2 / u)
STEP13_DECL_KIND DurfeeCCS.Step08.pairedLog_eq_tsum_mode theorem DurfeeCCS.Step08.MidpointLogSeries
DurfeeCCS.Step08.pairedLog_eq_tsum_mode (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) :
  DurfeeCCS.Step08.pairedLog r θ ζ = ∑' (n : ℕ), DurfeeCCS.Step08.pairedLogMode r θ ζ n
STEP13_DECL_KIND DurfeeCCS.Step08.pairedLog_sub_main_eq_remainders theorem DurfeeCCS.Step08.NearOriginMiddleBounds
DurfeeCCS.Step08.pairedLog_sub_main_eq_remainders (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) :
  DurfeeCCS.Step08.pairedLog r θ ζ - DurfeeCCS.Step08.nearOriginMainLog r θ ζ =
    DurfeeCCS.Step08.nearOriginFirstRemainder r θ ζ + DurfeeCCS.Step08.nearOriginTailRemainder r θ ζ
STEP13_DECL_KIND DurfeeCCS.Step08.proposition35 theorem DurfeeCCS.Step08.FirstSaddleProof
DurfeeCCS.Step08.proposition35 {n : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1)
  (hscale : 4 * Real.pi ≤ √(↑n * r)) :
  |DurfeeCCS.Step08.durfeeNegativeValue n r -
        DurfeeCCS.Step06.saddleAmplitude n r * Real.cos (DurfeeCCS.Step06.saddlePhase n r)| <
    9 / 10 * DurfeeCCS.Step06.saddleAmplitude n r
STEP13_DECL_KIND DurfeeCCS.Step08.re_pairedLog_div_omega_lt_minorEnvelope theorem DurfeeCCS.Step08.MinorArcEnvelope
DurfeeCCS.Step08.re_pairedLog_div_omega_lt_minorEnvelope {n : ℕ} (hn : 6400 ≤ n) {r r₀ β off high πBound μ v θ : ℝ}
  (hr : 0 < r) (hrr : r ≤ r₀) (hr₀ : r₀ ≤ 1) (hβ : 0 < β) (ha : β * r ≤ (DurfeeCCS.Step06.saddleS r).re ^ 2)
  (hrow : DurfeeCCS.Step07.FirstSaddleArcRow r₀ β off high πBound μ)
  (hArc : DurfeeCCS.Step08.FirstSaddleArcEstimates r r₀ (DurfeeCCS.Step08.saddleU n r) v θ) :
  (DurfeeCCS.Step08.pairedLog r θ (DurfeeCCS.Step08.verticalPoint (DurfeeCCS.Step08.saddleU n r) v)).re /
      DurfeeCCS.Step08.saddleOmega n r <
    μ
STEP13_DECL_KIND DurfeeCCS.Step08.re_saddleG_div_outer_lt theorem DurfeeCCS.Step08.SaddleStrictBounds
DurfeeCCS.Step08.re_saddleG_div_outer_lt {r u v : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hu : 0 < u) (hv : 16 * u ≤ |v|)
  (θ : ℝ) :
  (DurfeeCCS.Step06.saddleG r θ / DurfeeCCS.Step08.verticalPoint u v).re <
    0.127 * ((DurfeeCCS.Step06.saddleS r).re ^ 2 / u)
STEP13_DECL_KIND DurfeeCCS.Step08.re_saddleG_div_vertical_mul theorem DurfeeCCS.Step08.MidpointMainArcRescale
DurfeeCCS.Step08.re_saddleG_div_vertical_mul {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (θ η : ℝ) :
  (DurfeeCCS.Step06.saddleG r θ /
        DurfeeCCS.Step08.verticalPoint (DurfeeCCS.Step08.saddleU n r) (DurfeeCCS.Step08.saddleU n r * η)).re =
    DurfeeCCS.Step08.saddleOmega n r * (1 - DurfeeCCS.Step08.saddleGap r θ η)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleAmplitude_lower theorem DurfeeCCS.Step08.SaddleNormalization
DurfeeCCS.Step08.saddleAmplitude_lower {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  2 * Real.exp (2 * DurfeeCCS.Step08.saddleOmega n r) / (3 * Real.pi * ↑n) ≤ DurfeeCCS.Step06.saddleAmplitude n r
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBesselAverage_cutoff_error theorem DurfeeCCS.Step08.SaddleBesselAverage
DurfeeCCS.Step08.saddleBesselAverage_cutoff_error (n : ℕ) {r c d : ℝ} (hr : |r| ≤ 1) (hc : c ≤ Real.pi / 2) (hd : 0 ≤ d)
  (model : ℝ → ℂ) (hm : MeasureTheory.IntegrableOn model (Set.Ioi 0) MeasureTheory.MeasureSpace.volume) :
  have K := fun θ => (↑Real.pi)⁻¹ * DurfeeCCS.Step08.saddleBesselKernel n (DurfeeCCS.Step06.saddleG r θ);
  |DurfeeCCS.Step08.saddleBesselAverage n r - (∫ (ψ : ℝ) in Set.Ioi 0, model ψ).re| ≤
    ‖(∫ (θ : ℝ) in -c..c, K θ) - ∫ (ψ : ℝ) in 0..d, model ψ‖ +
        ((∫ (θ : ℝ) in -Real.pi / 2..-c, ‖K θ‖) + ∫ (θ : ℝ) in c..Real.pi / 2, ‖K θ‖) +
      ‖∫ (ψ : ℝ) in Set.Ioi d, model ψ‖
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBesselAverage_eq_integral theorem DurfeeCCS.Step08.SaddleBesselApproximation
DurfeeCCS.Step08.saddleBesselAverage_eq_integral {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : |r| ≤ 1) :
  ↑(DurfeeCCS.Step08.saddleBesselAverage n r) =
    (2 * ↑Real.pi)⁻¹ *
      ∫ (θ : ℝ) in -Real.pi..Real.pi,
        (DurfeeCCS.Step06.saddleG r θ).sqrt / ↑√↑n *
          DurfeeCCS.Step06.besselI 1 (2 * (↑n * DurfeeCCS.Step06.saddleG r θ).sqrt)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBesselAverage_half_arc theorem DurfeeCCS.Step08.SaddleBesselAverage
DurfeeCCS.Step08.saddleBesselAverage_half_arc (n : ℕ) {r : ℝ} (hr : |r| ≤ 1) :
  DurfeeCCS.Step08.saddleBesselAverage n r =
    ((↑Real.pi)⁻¹ *
        ∫ (θ : ℝ) in -Real.pi / 2..Real.pi / 2, DurfeeCCS.Step08.saddleBesselKernel n (DurfeeCCS.Step06.saddleG r θ)).re
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBesselKernel_eq_besselI theorem DurfeeCCS.Step08.SaddleBesselAverage
DurfeeCCS.Step08.saddleBesselKernel_eq_besselI {n : ℕ} (hn : 0 < n) (g : ℂ) :
  DurfeeCCS.Step08.saddleBesselKernel n g = g.sqrt / ↑√↑n * DurfeeCCS.Step06.besselI 1 (2 * ↑√↑n * g.sqrt)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBesselPaperError other DurfeeCCS.Step08.SaddleBesselApproximation
DurfeeCCS.Step08.saddleBesselPaperError (t r : ℝ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBesselRate_bounds theorem DurfeeCCS.Step08.SaddleBesselModel
DurfeeCCS.Step08.saddleBesselRate_bounds {n : ℕ} {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  DurfeeCCS.Step08.saddleGamma r * DurfeeCCS.Step08.saddleOmega n r ≤ (DurfeeCCS.Step08.saddleBesselRate n r).re ∧
    ‖DurfeeCCS.Step08.saddleBesselRate n r‖ ≤ 1.5 * DurfeeCCS.Step08.saddleOmega n r
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBessel_central_cutoff_error theorem DurfeeCCS.Step08.SaddleBesselEstimate
DurfeeCCS.Step08.saddleBessel_central_cutoff_error {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  ‖(∫ (θ : ℝ) in -DurfeeCCS.Step08.saddleBesselCutoff..DurfeeCCS.Step08.saddleBesselCutoff,
          (↑Real.pi)⁻¹ * DurfeeCCS.Step08.saddleBesselKernel n (DurfeeCCS.Step06.saddleG r θ)) -
        ∫ (ψ : ℝ) in 0..0.3, DurfeeCCS.Step08.saddleBesselModel n r ψ‖ ≤
    DurfeeCCS.Step06.saddleAmplitude n r *
      (DurfeeCCS.Step07.firstSaddleC (DurfeeCCS.Step08.saddleGamma r) / DurfeeCCS.Step08.saddleOmega n r)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBessel_error_of_outer_cutoff theorem DurfeeCCS.Step08.SaddleBesselEstimate
DurfeeCCS.Step08.saddleBessel_error_of_outer_cutoff {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1)
  (hOuter :
    have K := fun θ => (↑Real.pi)⁻¹ * DurfeeCCS.Step08.saddleBesselKernel n (DurfeeCCS.Step06.saddleG r θ);
    have ω := DurfeeCCS.Step08.saddleOmega n r;
    have γ := DurfeeCCS.Step08.saddleGamma r;
    (∫ (θ : ℝ) in -Real.pi / 2..-DurfeeCCS.Step08.saddleBesselCutoff, ‖K θ‖) +
        ∫ (θ : ℝ) in DurfeeCCS.Step08.saddleBesselCutoff..Real.pi / 2, ‖K θ‖ ≤
      DurfeeCCS.Step06.saddleAmplitude n r * (11.1 / γ / √ω * Real.exp (-0.3 * γ * ω) + 19 * ω ^ 2 * Real.exp (-ω))) :
  |DurfeeCCS.Step08.saddleBesselAverage n r -
        DurfeeCCS.Step06.saddleAmplitude n r * Real.cos (DurfeeCCS.Step06.saddlePhase n r)| ≤
    DurfeeCCS.Step06.saddleAmplitude n r *
      DurfeeCCS.Step07.firstSaddleE (DurfeeCCS.Step08.saddleOmega n r) (DurfeeCCS.Step08.saddleGamma r)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleBessel_outer_cutoff_error theorem DurfeeCCS.Step08.SaddleBesselCutoff
DurfeeCCS.Step08.saddleBessel_outer_cutoff_error {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  have ω := DurfeeCCS.Step08.saddleOmega n r;
  have γ := DurfeeCCS.Step08.saddleGamma r;
  have c := DurfeeCCS.Step08.saddleBesselCutoff;
  have K := fun θ => (↑Real.pi)⁻¹ * DurfeeCCS.Step08.saddleBesselKernel n (DurfeeCCS.Step06.saddleG r θ);
  (∫ (θ : ℝ) in -Real.pi / 2..-c, ‖K θ‖) + ∫ (θ : ℝ) in c..Real.pi / 2, ‖K θ‖ ≤
    DurfeeCCS.Step06.saddleAmplitude n r * (11.1 / γ / √ω * Real.exp (-0.3 * γ * ω) + 19 * ω ^ 2 * Real.exp (-ω))
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_central_bessel_arguments theorem DurfeeCCS.Step08.PhaseGapCentral
DurfeeCCS.Step08.saddleG_central_bessel_arguments {r θ v : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hψ : 1 - Real.cos θ ≤ 0.3)
  (hv : 0 < v) :
  have s := DurfeeCCS.Step06.saddleS r;
  have z := 2 * ↑v * (DurfeeCCS.Step06.saddleG r θ).sqrt;
  ‖z‖ ≤ 3.35 * (s.re * v) ∧ 1.35 * (s.re * v) ≤ z.re
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_central_errors theorem DurfeeCCS.Step08.PhaseGapCentral
DurfeeCCS.Step08.saddleG_central_errors {r θ : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hψ : 1 - Real.cos θ ≤ 0.3) :
  have s := DurfeeCCS.Step06.saddleS r;
  have g := DurfeeCCS.Step06.saddleG r θ;
  have ψ := 1 - Real.cos θ;
  ‖2 * (g.sqrt - s) / ↑s.re + 2 * (↑r * Complex.I / (1 + ↑r * Complex.I)) * ↑ψ / (↑s.re * s)‖ ≤ 2.46 * ψ ^ 2 ∧
    ‖(g.sqrt / s).sqrt / ↑√(1 - ψ / 2) - 1‖ ≤ 0.87 * ψ
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_component_gaps theorem DurfeeCCS.Step08.PhaseGapComponents
DurfeeCCS.Step08.saddleG_component_gaps {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (θ : ℝ) :
  r ^ 2 / (1 + r ^ 2) * Real.sin θ ^ 2 ≤ (DurfeeCCS.Step06.saddleS r ^ 2).re - (DurfeeCCS.Step06.saddleG r θ).re ∧
    2 * r / (1 + r ^ 2) * (1 - Real.cos θ) ≤ (DurfeeCCS.Step06.saddleS r ^ 2).im - (DurfeeCCS.Step06.saddleG r θ).im
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_eq_log_integral theorem DurfeeCCS.Step08.PhaseGapIntegral
DurfeeCCS.Step08.saddleG_eq_log_integral {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (θ : ℝ) :
  DurfeeCCS.Step06.saddleG r θ = ∫ (y : ℝ) in 0..r, Complex.log (DurfeeCCS.Step08.saddleLogArgument θ y) / ↑y
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_gap_all theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.saddleG_gap_all {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη : 0 ≤ η) :
  (η - DurfeeCCS.Step08.saddleSlope r) ^ 2 / (1 + η ^ 2) ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_gap_main theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.saddleG_gap_main {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hθ : |θ| ≤ Real.pi / 2) (hη : 0 ≤ η) :
  have ψ := 1 - Real.cos θ;
  have ρ := DurfeeCCS.Step08.saddleSlope r;
  have κ := DurfeeCCS.Step08.saddleCurvature r;
  DurfeeCCS.Step08.saddleGamma r * ψ ≤ ((η - ρ) ^ 2 + r * κ * ψ * (2 - ψ) + 2 * κ * η * ψ) / (1 + η ^ 2) ∧
    ((η - ρ) ^ 2 + r * κ * ψ * (2 - ψ) + 2 * κ * η * ψ) / (1 + η ^ 2) ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_gap_opposite theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.saddleG_gap_opposite {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hθ₁ : Real.pi / 2 < |θ|)
  (hθ₂ : |θ| ≤ Real.pi) (hη : 0 ≤ η) : 1 - r / 2 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_log_linear_remainder theorem DurfeeCCS.Step08.PhaseGapExpansion
DurfeeCCS.Step08.saddleG_log_linear_remainder {r θ : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hψ : 1 - Real.cos θ < 1) :
  have ψ := 1 - Real.cos θ;
  ‖DurfeeCCS.Step06.saddleS r ^ 2 - DurfeeCCS.Step06.saddleG r θ - 2 * ↑r * Complex.I * ↑ψ / (1 + ↑r * Complex.I)‖ ≤
    r * ψ ^ 2 / (1 - ψ)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_normalized_displacement theorem DurfeeCCS.Step08.PhaseGapExpansion
DurfeeCCS.Step08.saddleG_normalized_displacement {r θ : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hψ : 1 - Real.cos θ ≤ 0.3) :
  have ψ := 1 - Real.cos θ;
  have w := DurfeeCCS.Step06.saddleG r θ / DurfeeCCS.Step06.saddleS r ^ 2 - 1;
  ‖w‖ ≤ 1.34 * ψ ∧ ‖w‖ ≤ 0.402
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_sqrt_central_endpoint_limits theorem DurfeeCCS.Step08.PhaseGapEndpoint
DurfeeCCS.Step08.saddleG_sqrt_central_endpoint_limits {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  Filter.Tendsto (fun θ => (DurfeeCCS.Step06.saddleG r θ).sqrt)
      (nhdsWithin (-(Real.pi / 2)) (Set.Ioo (-(Real.pi / 2)) (Real.pi / 2)))
      (nhds (DurfeeCCS.Step06.saddleG r (-(Real.pi / 2))).sqrt) ∧
    Filter.Tendsto (fun θ => (DurfeeCCS.Step06.saddleG r θ).sqrt)
      (nhdsWithin (Real.pi / 2) (Set.Ioo (-(Real.pi / 2)) (Real.pi / 2)))
      (nhds (DurfeeCCS.Step06.saddleG r (Real.pi / 2)).sqrt)
STEP13_DECL_KIND DurfeeCCS.Step08.saddleG_sqrt_re_le theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.saddleG_sqrt_re_le {r θ : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hθ : |θ| ≤ Real.pi / 2) :
  (DurfeeCCS.Step06.saddleG r θ).sqrt.re ≤
    (DurfeeCCS.Step06.saddleS r).re * √(1 - DurfeeCCS.Step08.saddleGamma r * (1 - Real.cos θ))
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGamma other DurfeeCCS.Step08.PhaseGapParameters
DurfeeCCS.Step08.saddleGamma (r : ℝ) : ℝ
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGap_eta_ge_eight theorem DurfeeCCS.Step08.FirstSaddleSubregions
DurfeeCCS.Step08.saddleGap_eta_ge_eight {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη : 8 ≤ η) :
  49 / 65 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGap_eta_ge_four theorem DurfeeCCS.Step08.FirstSaddleSubregions
DurfeeCCS.Step08.saddleGap_eta_ge_four {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη : 4 ≤ η) :
  9 / 17 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGap_eta_two_to_four theorem DurfeeCCS.Step08.FirstSaddleSubregions
DurfeeCCS.Step08.saddleGap_eta_two_to_four {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη₁ : 2 ≤ η) (hη₂ : η ≤ 4) :
  η / 10 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGap_outer_angles theorem DurfeeCCS.Step08.FirstSaddleSubregions
DurfeeCCS.Step08.saddleGap_outer_angles {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη : 0 ≤ η) (hθ₁ : Real.pi / 3 ≤ |θ|)
  (hθ₂ : |θ| ≤ Real.pi) : 0.275 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGap_rectangle theorem DurfeeCCS.Step08.FirstSaddleSubregions
DurfeeCCS.Step08.saddleGap_rectangle {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη₁ : 1 / 4 ≤ η) (hη₂ : η ≤ 2)
  (hθ : |θ| ≤ Real.pi / 3) :
  0.2 * (η - DurfeeCCS.Step08.saddleSlope r) ^ 2 + 82e-3 * θ ^ 2 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleGap_small_eta theorem DurfeeCCS.Step08.FirstSaddleSubregions
DurfeeCCS.Step08.saddleGap_small_eta {r θ η : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) (hη : 0 ≤ η) (hη₁ : η ≤ 1 / 4) :
  0.206 ≤ DurfeeCCS.Step08.saddleGap r θ η
STEP13_DECL_KIND DurfeeCCS.Step08.saddleKappa_enclosure theorem DurfeeCCS.Step08.SaddleNormalization
DurfeeCCS.Step08.saddleKappa_enclosure {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  1 / ((1 + r ^ 2) * (1 + 0.282 * r)) ≤ DurfeeCCS.Step08.saddleKappa r ∧
    DurfeeCCS.Step08.saddleKappa r ≤ 1 ∧ 0.39 < DurfeeCCS.Step08.saddleKappa r
STEP13_DECL_KIND DurfeeCCS.Step08.saddleMajorDensity_integral_le_case_two theorem DurfeeCCS.Step08.FirstSaddleMajorBound
DurfeeCCS.Step08.saddleMajorDensity_integral_le_case_two {r r₀ ω : ℝ} {δ : ℝ → ℝ → ℂ} (hr : 0 < r) (hr₁ : r ≤ 1)
  (hω : 40 ≤ ω) (hr₀ : 0 ≤ r₀) (hf : Continuous (Function.uncurry (DurfeeCCS.Step08.saddleMajorDensity r ω δ)))
  (h45 : ∀ η ∈ Set.Icc 0 16, ∀ θ ∈ Set.Icc (-Real.pi) Real.pi, ‖δ η θ‖ ≤ 0.51 + 0.69 * (1 + √(1 + η ^ 2)))
  (hrect :
    ∀ η ∈ Set.Icc (1 / 4) 2,
      ∀ θ ∈ Set.Icc (-Real.pi / 3) (Real.pi / 3), ‖δ η θ‖ ≤ 5.33 * r₀ * DurfeeCCS.Step07.firstSaddleU0 r₀) :
  3 * ω / (4 * Real.pi) *
      ∫ (η : ℝ) in 0..16, ∫ (θ : ℝ) in -Real.pi..Real.pi, DurfeeCCS.Step08.saddleMajorDensity r ω δ η θ ≤
    DurfeeCCS.Step07.firstSaddleRectError r₀ + DurfeeCCS.Step07.firstSaddleRectComplement ω
STEP13_DECL_KIND DurfeeCCS.Step08.saddleOmega_ge_sqrt_mul theorem DurfeeCCS.Step08.SaddleNormalization
DurfeeCCS.Step08.saddleOmega_ge_sqrt_mul {n : ℕ} {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  √(↑n * r) ≤ DurfeeCCS.Step08.saddleOmega n r
STEP13_DECL_KIND DurfeeCCS.Step08.saddleSlope_curvature_bounds theorem DurfeeCCS.Step08.PhaseGapParameters
DurfeeCCS.Step08.saddleSlope_curvature_bounds {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  1 ≤ DurfeeCCS.Step08.saddleSlope r ^ 2 + r * DurfeeCCS.Step08.saddleCurvature r ∧
    0 ≤ DurfeeCCS.Step08.saddleSlope r - DurfeeCCS.Step08.saddleCurvature r ∧
      DurfeeCCS.Step08.saddleGamma r ≤ 1 - DurfeeCCS.Step08.saddleSlope r + DurfeeCCS.Step08.saddleCurvature r
STEP13_DECL_KIND DurfeeCCS.Step08.saddleU_lt_bound theorem DurfeeCCS.Step08.SaddleNormalization
DurfeeCCS.Step08.saddleU_lt_bound {n : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  DurfeeCCS.Step08.saddleU n r < 1416e-5
STEP13_DECL_KIND DurfeeCCS.Step08.saddleU_mul_omega theorem DurfeeCCS.Step08.SaddleNormalization
DurfeeCCS.Step08.saddleU_mul_omega {n : ℕ} (hn : 0 < n) (r : ℝ) :
  DurfeeCCS.Step08.saddleU n r * DurfeeCCS.Step08.saddleOmega n r = (DurfeeCCS.Step06.saddleS r).re ^ 2
STEP13_DECL_KIND DurfeeCCS.Step08.saddle_axis_eta_gap theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.saddle_axis_eta_gap {r : ℝ} (hr : 0 < r) (η : ℝ) :
  1 -
      ((DurfeeCCS.Step06.saddleS r ^ 2).re + η * (DurfeeCCS.Step06.saddleS r ^ 2).im) /
        ((DurfeeCCS.Step06.saddleS r).re ^ 2 * (1 + η ^ 2)) =
    (η - DurfeeCCS.Step08.saddleSlope r) ^ 2 / (1 + η ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step08.saddle_contour_difference_le theorem DurfeeCCS.Step08.DurfeeContour
DurfeeCCS.Step08.saddle_contour_difference_le {n : ℕ} (hn : 6400 ≤ n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  have u := DurfeeCCS.Step08.saddleU n r;
  have ω := DurfeeCCS.Step08.saddleOmega n r;
  have s := Set.Icc (-(16 * u)) (16 * u);
  have t := Set.Icc (-Real.pi) Real.pi;
  |DurfeeCCS.Step08.durfeeNegativeValue n r - DurfeeCCS.Step08.saddleBesselAverage n r| ≤
    Real.exp ω / (2 * Real.pi) *
      (((∫ (v : ℝ) in s,
            ‖DurfeeCCS.Step08.durfeeExponentialMean r u v - DurfeeCCS.Step08.saddleExponentialMean r u v‖) +
          ∫ (v : ℝ) in t \ s, ‖DurfeeCCS.Step08.durfeeExponentialMean r u v‖) +
        ∫ (v : ℝ) in sᶜ, ‖DurfeeCCS.Step08.saddleExponentialMean r u v‖)
STEP13_DECL_KIND DurfeeCCS.Step08.saddle_tail_error_le theorem DurfeeCCS.Step08.SaddleOuterArc
DurfeeCCS.Step08.saddle_tail_error_le {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 0 < r) (hr₁ : r ≤ 1) :
  have ω := DurfeeCCS.Step08.saddleOmega n r;
  have u := DurfeeCCS.Step08.saddleU n r;
  Real.exp ω / (2 * Real.pi) *
      ∫ (v : ℝ) in (Set.Icc (-(16 * u)) (16 * u))ᶜ, ‖DurfeeCCS.Step08.saddleExponentialMean r u v‖ ≤
    DurfeeCCS.Step06.saddleAmplitude n r * DurfeeCCS.Step07.firstSaddleL16 ω
STEP13_DECL_KIND DurfeeCCS.Step08.square_eta_gap theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.square_eta_gap (z : ℂ) (η : ℝ) :
  z.re ^ 2 - ((z ^ 2).re + η * (z ^ 2).im) / (1 + η ^ 2) = (z.re * η - z.im) ^ 2 / (1 + η ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step08.square_eta_isGreatest theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.square_eta_isGreatest {z : ℂ} (hre : 0 < z.re) (him : 0 ≤ z.im) :
  IsGreatest ((fun η => ((z ^ 2).re + η * (z ^ 2).im) / (1 + η ^ 2)) '' Set.Ici 0) (z.re ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step08.square_eta_sSup theorem DurfeeCCS.Step08.PhaseGap
DurfeeCCS.Step08.square_eta_sSup {z : ℂ} (hre : 0 < z.re) (him : 0 ≤ z.im) :
  SupSet.sSup ((fun η => ((z ^ 2).re + η * (z ^ 2).im) / (1 + η ^ 2)) '' Set.Ici 0) = z.re ^ 2
STEP13_DECL_KIND DurfeeCCS.Step08.summable_norm_pairedLogMode theorem DurfeeCCS.Step08.MidpointLogSeries
DurfeeCCS.Step08.summable_norm_pairedLogMode (r θ : ℝ) {ζ : ℂ} (hr : |r| ≤ 1) (hζ : 0 < ζ.re) :
  Summable fun n => ‖DurfeeCCS.Step08.pairedLogMode r θ ζ n‖
STEP13_DECL_KIND DurfeeCCS.Step08.summable_pairedLog_majorant theorem DurfeeCCS.Step08.MidpointLogSeries
DurfeeCCS.Step08.summable_pairedLog_majorant (ζ : ℂ) : Summable fun n => 2 / (ζ.re * ↑(n + 1) ^ 2)
STEP13_DECL_KIND DurfeeCCS.Step08.verticalPoint other DurfeeCCS.Step08.NearOriginLaplace
DurfeeCCS.Step08.verticalPoint (u v : ℝ) : ℂ
STEP13_DECL_KIND DurfeeCCS.Step09.deriv_deriv_midPhase_zero theorem DurfeeCCS.Step09.MidPhaseCurvature
DurfeeCCS.Step09.deriv_deriv_midPhase_zero {r : ℝ} (hr : 1 ≤ r) :
  deriv (deriv (DurfeeCCS.Step09.midPhase r 0)) 0 = -2 * ↑r * Complex.I / (1 + ↑r * Complex.I)
STEP13_DECL_KIND DurfeeCCS.Step09.durfeeAnalyticF_eq_poisson_integrals theorem DurfeeCCS.Step09.MidPoisson
DurfeeCCS.Step09.durfeeAnalyticF_eq_poisson_integrals {r : ℝ} (hr : 1 ≤ r) {ζ : ℂ} (hζ : 0 < ζ.re) :
  DurfeeCCS.durfeeAnalyticF (-↑r ^ 2) (Complex.exp (-ζ)) =
    (ζ * DurfeeCCS.Step06.eulerProduct ζ ^ 2)⁻¹ *
      ∑' (p : ℤ),
        Complex.exp ((↑(Real.log r) + ↑(DurfeeCCS.Step09.midFrequency p) * Complex.I) ^ 2 / ζ) *
          ∫ (χ : ℝ), Complex.exp (-↑χ ^ 2 / ζ) / DurfeeCCS.Step06.pairedProduct (DurfeeCCS.Step09.midModeRadius r p) χ ζ
STEP13_DECL_KIND DurfeeCCS.Step09.durfeeAnalyticF_midPoisson theorem DurfeeCCS.Step09.MidPoisson
DurfeeCCS.Step09.durfeeAnalyticF_midPoisson {r : ℝ} (hr : 1 ≤ r) {ζ : ℂ} (hζ : 0 < ζ.re) :
  DurfeeCCS.durfeeAnalyticF (-↑r ^ 2) (Complex.exp (-ζ)) =
    (ζ * DurfeeCCS.Step06.eulerProduct ζ ^ 2)⁻¹ * ∑' (p : ℤ), ∫ (χ : ℝ), DurfeeCCS.Step09.midPoissonMode r ζ p χ
STEP13_DECL_KIND DurfeeCCS.Step09.eight_mul_midU_lt_pi theorem DurfeeCCS.Step09.MidMultiplierRadius
DurfeeCCS.Step09.eight_mul_midU_lt_pi {n : ℕ} {r : ℝ} (hn : 6400 ≤ n) (hr : 1 ≤ r) (hmax : r ≤ Real.exp 1 * √↑n) :
  8 * DurfeeCCS.Step09.midU n r < Real.pi
STEP13_DECL_KIND DurfeeCCS.Step09.hasDerivAt_saddleS_middle theorem DurfeeCCS.Step09.MidSaddleMonotone
DurfeeCCS.Step09.hasDerivAt_saddleS_middle {r : ℝ} (hr : 0 < r) :
  HasDerivAt DurfeeCCS.Step06.saddleS (Complex.log (1 + ↑r * Complex.I) / (↑r * DurfeeCCS.Step06.saddleS r)) r
STEP13_DECL_KIND DurfeeCCS.Step09.hasSum_integral_midModelHsecond theorem DurfeeCCS.Step09.MidModelSeries
DurfeeCCS.Step09.hasSum_integral_midModelHsecond (t ρ : ℝ) :
  HasSum (fun k => ∫ (η : ℝ), DurfeeCCS.Step09.midModelOsc t η * DurfeeCCS.Step09.midModelHsecondTerm t ρ k η)
    (∫ (η : ℝ), DurfeeCCS.Step09.midModelOsc t η * DurfeeCCS.Step09.midModelHsecond t ρ η)
STEP13_DECL_KIND DurfeeCCS.Step09.hasSum_intervalIntegral_midPoissonMode theorem DurfeeCCS.Step09.MidPoissonVertical
DurfeeCCS.Step09.hasSum_intervalIntegral_midPoissonMode {r u : ℝ} (hr : 1 ≤ r) (hu : 0 < u) {w : ℝ → ℂ}
  (hw : Continuous w) (a b : ℝ) :
  HasSum
    (fun p =>
      ∫ (v : ℝ) in a..b, w v * ∫ (χ : ℝ), DurfeeCCS.Step09.midPoissonMode r (DurfeeCCS.Step08.verticalPoint u v) p χ)
    (∫ (v : ℝ) in a..b,
      w v * ∑' (p : ℤ), ∫ (χ : ℝ), DurfeeCCS.Step09.midPoissonMode r (DurfeeCCS.Step08.verticalPoint u v) p χ)
STEP13_DECL_KIND DurfeeCCS.Step09.hasSum_midContribution theorem DurfeeCCS.Step09.MidContour
DurfeeCCS.Step09.hasSum_midContribution {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 1 ≤ r) (l h : ℝ) :
  have u := DurfeeCCS.Step09.midU n r;
  HasSum (fun p => DurfeeCCS.Step09.midContribution n r p l h)
    ((2 * ↑Real.pi)⁻¹ * ∫ (v : ℝ) in l * u..h * u, DurfeeCCS.Step09.midDurfeeLine n r v)
STEP13_DECL_KIND DurfeeCCS.Step09.hasSum_midContribution_central theorem DurfeeCCS.Step09.MidContour
DurfeeCCS.Step09.hasSum_midContribution_central {n : ℕ} (hn : 0 < n) {r : ℝ} (hr : 1 ≤ r) :
  HasSum (fun p => DurfeeCCS.Step09.midContribution n r p (-8) 8) (DurfeeCCS.Step09.midCentralContribution n r)
STEP13_DECL_KIND DurfeeCCS.Step09.hasSum_midPoisson_angular_tiles theorem DurfeeCCS.Step09.MidPoissonLattice
DurfeeCCS.Step09.hasSum_midPoisson_angular_tiles {f : ℝ → ℂ}
  (hf : MeasureTheory.Integrable f MeasureTheory.MeasureSpace.volume) (p : ℤ) :
  HasSum (fun m => ∫ (θ : ℝ) in -Real.pi..Real.pi, f (θ + ↑(p + 2 * m) * Real.pi)) (∫ (x : ℝ), f x)
STEP13_DECL_KIND DurfeeCCS.Step09.integral_midGaussian_inner theorem DurfeeCCS.Step09.MidGaussianModel
DurfeeCCS.Step09.integral_midGaussian_inner {n : ℕ} (hn : 0 < n) {r η : ℝ} (hr : 0 < r) (hη : 0 ≤ η) :
  ∫ (χ : ℝ), Complex.exp (DurfeeCCS.Step09.midGaussianExponent n r η χ) =
    Complex.exp
          (↑n * DurfeeCCS.Step09.midEtaPoint n r η +
            DurfeeCCS.Step06.saddleS r ^ 2 / DurfeeCCS.Step09.midEtaPoint n r η) *
        (↑√(Real.pi * DurfeeCCS.Step09.midU n r) / (DurfeeCCS.Step09.midCurvature r).sqrt) *
      (DurfeeCCS.Step09.midModelZ η).sqrt
STEP13_DECL_KIND DurfeeCCS.Step09.integral_midModelCpow_fourier theorem DurfeeCCS.Step09.MidModelFourierPaper
DurfeeCCS.Step09.integral_midModelCpow_fourier (k : ℕ) {t : ℝ} (ht : 0 < t) :
  ∫ (η : ℝ), DurfeeCCS.Step09.midModelOsc t η * DurfeeCCS.Step09.midModelZ η ^ (-↑k - 3 / 2) =
    2 * ↑√Real.pi * 4 ^ (k + 1) * ↑(k + 1).factorial / ↑(2 * k + 2).factorial * Complex.exp (-↑t) * ↑(t ^ (↑k + 1 / 2))
STEP13_DECL_KIND DurfeeCCS.Step09.integral_shifted_gaussian_tail theorem DurfeeCCS.Step09.MidOtherGaussian
DurfeeCCS.Step09.integral_shifted_gaussian_tail {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c) :
  MeasureTheory.IntegrableOn (fun y => Real.exp (-b * (|y| - c) ^ 2)) {y | c < |y|} MeasureTheory.MeasureSpace.volume ∧
    ∫ (y : ℝ) in {y | c < |y|}, Real.exp (-b * (|y| - c) ^ 2) = √(Real.pi / b)
STEP13_DECL_KIND DurfeeCCS.Step09.lemma310 theorem DurfeeCCS.Step09.MidOtherProof
DurfeeCCS.Step09.lemma310 {n : ℕ} {r : ℝ} (hn : 6400 ≤ n) (hr : 1 ≤ r) (hmax : r ≤ Real.exp 1 * √↑n) :
  DurfeeCCS.Step09.midU n r / (4 * Real.pi ^ 2) *
      ((∑' (p : ℤ), if p = 0 ∨ p = -1 then 0 else DurfeeCCS.Step09.midOtherMass n r p (-8) 8) +
          DurfeeCCS.Step09.midOtherMass n r 0 (-8) 0 +
        DurfeeCCS.Step09.midOtherMass n r (-1) 0 8) <
    2e-3 * DurfeeCCS.Step06.saddleAmplitude n r
STEP13_DECL_KIND DurfeeCCS.Step09.lemma36 theorem DurfeeCCS.Step09.MidRepresentation
DurfeeCCS.Step09.lemma36 {r : ℝ} (hr : 1 ≤ r) :
  (∀ (ζ : ℂ),
      0 < ζ.re →
        DurfeeCCS.durfeeAnalyticF (-↑r ^ 2) (Complex.exp (-ζ)) =
          (ζ * DurfeeCCS.Step06.eulerProduct ζ ^ 2)⁻¹ *
            ∑' (p : ℤ), ∫ (χ : ℝ), DurfeeCCS.Step09.midPoissonMode r ζ p χ) ∧
